# SAP OData backend (service ZG1_PROC_SRV_SRV - SEGW auto-appends "_SRV" to project name
# ZG1_PROC_SRV, so the registered technical service name has "_SRV" twice).
# Leave SAP_HOST empty to use mock data from webapp/model/MockData.js
# Example: SAP_HOST=https://s40lp1.ucc.cit.tum.de:8100
SAP_HOST=
SAP_USER=
SAP_PASS=

# Groq API key for AI vendor recommendation (POST /api/ai/recommend-vendor)
GROQ_API_KEY=
