# Copy file nay thanh ".env" (cung thu muc) roi dien gia tri that vao.
# ".env" da nam trong .gitignore — khong bao gio commit gia tri that len git.
#
# Xin gia tri that tu truong nhom. Chay local chi CAN 3 nhom dau (SAP, Gmail,
# Google) la du dung; cac bien con lai co gia tri mac dinh hop ly.

# ── SAP Gateway (OData ZG1_PROC_SRV_SRV) — BAT BUOC ───────────────────
# Thieu SAP_HOST thi hau het man hinh khong co du lieu.
# Vi du: https://<may-chu-sap>:<cong>
SAP_HOST=
SAP_USER=
SAP_PASS=

# ── Gmail SMTP (nodemailer) — dung de gui email PO / moi bao gia ─────
# Tinh nang phu, khong bat buoc: neu bo trong thi server van chay binh
# thuong, chi tinh nang gui mail bi tat (xem getMailTransporter trong
# src/lib/mailer.js).
# EMAIL_PASS phai la "App Password" cua Google, khong phai mat khau Gmail.
EMAIL_USER=
EMAIL_PASS=

# ── Google Sign-In (Google Identity Services) ─────────────────────────
# Lay tu Google Cloud Console > APIs & Services > Google Auth Platform
# > Clients > (Web application). Khong bi mat, an toan de lo ra frontend
# qua GET /api/config.
# Nho them origin dang dung vao "Authorized JavaScript origins", vi du
# http://localhost:3001 — thieu thi nut dang nhap Google bao loi 403.
GOOGLE_CLIENT_ID=

# ── AI (Anthropic Claude) ─────────────────────────────────────────────
# Dung cho 3 tinh nang: goi y nha cung cap (RFQ-01), so sanh bao gia
# (RFQ-02) va khung chat hoi-dap. Xem src/lib/claude.js.
# De trong thi 3 route /api/ai/* tra loi bao "chua cau hinh", phan con lai
# cua he thong van chay binh thuong.
ANTHROPIC_API_KEY=

# ── Portal bao gia cho NCC (webapp/quote.html) ──────────────────────
# RFQ_PORTAL_SECRET: chuoi ngau nhien >= 16 ky tu, dung de ky link bao gia
#   gui cho tung NCC. BAT BUOC dat truoc khi deploy — de trong thi server
#   dung secret mac dinh nam trong source, ai doc source cung tao duoc link
#   bao gia cua bat ky NCC nao. Sinh nhanh:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Doi gia tri nay = vo hieu hoa toan bo link da gui truoc do.
RFQ_PORTAL_SECRET=
#
# APP_BASE_URL: dia chi that cua ung dung (khong co dau / o cuoi), dung de
#   ghep link trong email gui NCC. Tren Vercel PHAI dat, vi du:
#     APP_BASE_URL=https://ten-app.vercel.app
#   De trong thi server tu suy tu header cua request — chay local se ra
#   http://localhost:3001, NCC mo link do se khong vao duoc.
APP_BASE_URL=
#
# CRON_SECRET: bao ve GET /api/cron/rfq-reminders (route tu dong gui mail nhac
#   NCC chua bao gia). De trong thi route bi TAT hoan toan — day la chu y,
#   khong the de endpoint gui mail ra ngoai cho ca internet goi tuy y.
#   Vercel Cron tu gui header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Tinh chinh (deu co mac dinh, de trong cung duoc) ─────────────────
# RFQ_DUE_SOON_DAYS: con bao nhieu ngay toi han nop bao gia thi bat dau canh
#   bao tren chuong thong bao cua Purchasing. Mac dinh 2.
RFQ_DUE_SOON_DAYS=2
#
# AGING_ALERT_DAYS: PR nam cho duyet qua bao nhieu ngay thi canh bao
#   "de lau". Mac dinh 2. Xem src/config/alerts.js.
AGING_ALERT_DAYS=2
#
# SAP_TZ_OFFSET_MIN: chenh lech mui gio cua may chu SAP so voi UTC, tinh bang
#   phut. Mac dinh 120 (CEST, gio mua he chau Au). Sai gia tri nay thi moc
#   thoi gian duyet PR hien sai gio. Xem src/config/org.js.
SAP_TZ_OFFSET_MIN=120
#
# SAP_MATERIAL_CREATE_ENTITY_SET: ten entity set dung khi tao material o man
#   MM01. Mac dinh "MaterialSet" — chi doi khi ben ABAP doi ten entity.
SAP_MATERIAL_CREATE_ENTITY_SET=MaterialSet

# ── Khac ───────────────────────────────────────────────────────────
# Cong chay local. Tren Vercel khong can dat (nen tang tu gan).
PORT=3001
