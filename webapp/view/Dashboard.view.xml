<mvc:View
	controllerName="com.qdavy.procurement.controller.Dashboard"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page title="{i18n>appTitle}" class="qdDashboardPage">
		<headerContent>
			<Button icon="sap-icon://log" text="{i18n>logoutButton}" press=".onLogoutPress"/>
		</headerContent>
		<content>
			<VBox class="qdDashHero">
				<Title text="{= ${i18n>dashGreeting} + ' ' + ${user>/fullName} }" level="H2" class="sapUiTinyMarginBottom"/>
				<Text text="{user>/position}"/>
				<Text class="qdRoleBadge" text="{user>/role}"/>
			</VBox>

			<Title text="{i18n>dashSectionTitle}" level="H4" class="qdSectionTitle"/>

<!-- Bổ sung cấu hình layout chia Grid tự động giãn cách cho Container -->
<f:GridContainer class="qdTileGrid">
    <f:layout>
        <f:GridContainerSettings rowSize="8rem" columnSize="12rem" gap="1rem" />
    </f:layout>
    
    <f:items>
        <GenericTile
            class="qdTile qdTileBlue"
            header="{i18n>tilePr01Title}"
            subheader="{i18n>tilePr01Subtitle}"
            press=".onNavToPR01"
            visible="{= ${user>/role} === 'REQUESTER' }"
        >
            <TileContent footer="PR-01">
                <content>
                    <core:Icon src="sap-icon://add-document" size="2.5rem"/>
                </content>
            </TileContent>
        </GenericTile>

        <GenericTile
            class="qdTile qdTileAmber"
            header="{i18n>tilePr02Title}"
            subheader="{i18n>tilePr02Subtitle}"
            press=".onNavToPR02"
            visible="{= ['CEO','PURCHASING','CFO'].indexOf(${user>/role}) !== -1 }"
        >
            <TileContent footer="PR-02">
                <content>
                    <core:Icon src="sap-icon://approvals" size="2.5rem"/>
                </content>
            </TileContent>
        </GenericTile>

        <GenericTile
            class="qdTile qdTilePurple"
            header="{i18n>tilePo01Title}"
            subheader="{i18n>tilePo01Subtitle}"
            press=".onNavToPO01"
            visible="{= ${user>/role} === 'PURCHASING' }"
        >
            <TileContent footer="PO-01">
                <content>
                    <core:Icon src="sap-icon://supplier" size="2.5rem"/>
                </content>
            </TileContent>
        </GenericTile>

        <!-- Bổ sung đầy đủ class qdTile qdTileAmber để nhận CSS kích thước chuẩn của nhóm -->
        <GenericTile
            class="qdTile qdTileAmber"
            header="Cấu hình hệ thống"
            subheader="Thiết lập ngưỡng duyệt PR"
            press=".onNavToThresholdConfig"
            visible="{= ${user>/role} === 'CEO' }"
        >
            <TileContent footer="SYS-CONFIG">
                <content>
                    <core:Icon src="sap-icon://action-settings" size="2.5rem"/>
                </content>
            </TileContent>
        </GenericTile>

        <!-- Bổ sung đầy đủ class qdTile qdTileBlue để nhận CSS kích thước chuẩn của nhóm -->
        <GenericTile
            class="qdTile qdTileBlue"
            header="Báo cáo tiến độ"
            subheader="Theo dõi tỷ lệ giao hàng SAP"
            press=".onNavToPOReport"
            visible="{= ['REQUESTER', 'PURCHASING', 'CEO'].indexOf(${user>/role}) !== -1 }"
        >
            <TileContent footer="REPORTS">
                <content>
                    <core:Icon src="sap-icon://business-by-design" size="2.5rem"/>
                </content>
            </TileContent>
        </GenericTile>
    </f:items>
</f:GridContainer>
		</content>
	</Page>
</mvc:View>
