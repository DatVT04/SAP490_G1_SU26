<mvc:View
	controllerName="com.qdavy.procurement.controller.RFQ01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- HERO HEADER -->
			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Quy trình Mua sắm · Bước 2a" class="qdPageEyebrow"/>
						<Title text="RFQ-01 · Lập &amp; Gửi Yêu cầu báo giá (RFQ)" level="H1" class="qdPageTitle"/>
						<Text text="Chọn PR đang chờ xử lý, mời nhà cung cấp báo giá qua email — AI gợi ý NCC phù hợp" class="qdPageSub"/>
					</VBox>
				</HBox>
			</VBox>

			<l:Splitter height="100%" width="100%" class="qdSplitter">
				<l:contentAreas>

					<!-- CARD 1: DANH SACH PR CHO PURCHASING XU LY -->
					<VBox width="100%">
						<layoutData>
							<l:SplitterLayoutData size="35%" minSize="320"/>
						</layoutData>

						<VBox class="qdContentCard qdCardTight qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMargin">
								<Text text="1" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="PR chờ Purchasing xử lý" level="H3" class="qdCardTitle"/>
									<Text text="Chọn một Yêu cầu mua hàng để mở RFQ" class="qdCellHint"/>
								</VBox>
							</HBox>

							<Table
								id="pendingPRTable"
								items="{/PendingPRs}"
								mode="SingleSelectMaster"
								selectionChange=".onPRSelect"
								sticky="ColumnHeaders"
								noDataText="Không có PR nào đang chờ Purchasing xử lý."
							>
								<columns>
									<Column width="8rem"><Text text="Mã PR"/></Column>
									<Column><Text text="Vật tư &amp; Yêu cầu"/></Column>
									<Column hAlign="End" width="8rem"><Text text="Giá trị ước tính"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier title="{PRId}"/>
											<VBox>
												<Text text="{Description}"/>
												<Text text="Người yêu cầu: {RequesterEmail}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber
												number="{path: 'TotalValue', formatter: '.formatCurrency'}"
												unit="{Currency}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</VBox>

					<!-- KHU VUC LAP RFQ -->
					<VBox id="rfqCreationArea" width="100%" visible="false">
						<layoutData>
							<l:SplitterLayoutData size="65%" minSize="450"/>
						</layoutData>

						<!-- CARD 2: CHON NHA CUNG CAP MOI BAO GIA -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center">
									<Text text="2" class="qdStepBadge qdStepBadgePurple"/>
									<VBox>
										<Title text="Chọn Nhà cung cấp mời báo giá" level="H3" class="qdCardTitle"/>
										<Text text="Nên mời tối thiểu 2 NCC để có cơ sở so sánh — nếu chỉ mời 1, khi chốt sẽ phải nhập lý do chỉ định (sole source)" class="qdCellHint"/>
									</VBox>
								</HBox>
								<Button
									text="AI gợi ý NCC"
									icon="sap-icon://ai"
									press=".onAiSuggestPress"
									busy="{/busyAi}"
									class="qdActionBtn"
								/>
							</HBox>

							<MessageStrip
								text="{/aiText}"
								type="Information"
								showIcon="true"
								visible="{= !!${/aiText} }"
								class="sapUiSmallMarginBottom"
							/>

							<!-- Hoi dap AI tuong tac: sau khi co goi y ban dau, nguoi dung hoi them
							     ("NCC nao giao nhanh nhat?", "vi sao khong chon V2?"...) thay vi chi
							     doc 1 chieu (feedback QDAVY 13/08: "AI van chua chat/tuong tac duoc"). -->
							<HBox
								alignItems="Center"
								visible="{= !!${/aiText} }"
								class="sapUiSmallMarginBottom"
							>
								<Input
									id="inAiQuestion"
									placeholder="Hỏi thêm AI về các nhà cung cấp này..."
									width="100%"
									maxLength="500"
									submit=".onAiAskPress"
									class="sapUiTinyMarginEnd"
								/>
								<Button
									text="Hỏi AI"
									icon="sap-icon://discussion"
									press=".onAiAskPress"
									busy="{/busyAi}"
								/>
							</HBox>

							<!-- Nguon du lieu NCC + huong xu ly khi thieu NCC (feedback QDAVY 13/08:
							     "Thong tin NCC lay o dau? Sao co moi 3? NCC can moi khong co thi sao?") -->
							<MessageStrip
								text="Danh sách lấy trực tiếp từ Vendor Master trên SAP (bảng LFA1) — hiển thị đủ toàn bộ NCC đã khai báo trên hệ thống. Nếu NCC cần mời chưa có: tạo Vendor Master mới trên SAP (BP/XK01) hoặc bổ sung email cho NCC, rồi bấm nút tải lại bên cạnh ô tìm kiếm."
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginBottom"
							/>

							<OverflowToolbar class="sapUiTinyMarginBottom">
								<SearchField
									id="sfVendorSearch"
									placeholder="Tìm theo mã, tên hoặc email NCC..."
									liveChange=".onVendorSearch"
									search=".onVendorSearch"
									width="100%"
								/>
								<Button
									icon="sap-icon://refresh"
									tooltip="Tải lại danh sách NCC từ SAP"
									press=".onReloadVendorsPress"
								/>
							</OverflowToolbar>

							<!-- Danh sách NCC nằm trong vùng cuộn CAO CỐ ĐỊNH: 35 NCC không còn kéo
							     card dài ra vô hạn, đẩy khối Hạn nộp & Gửi xuống đáy trang nữa.
							     growingScrollToLoad: cuộn chạm đáy tự nạp tiếp — bỏ hẳn nút "Thêm". -->
							<ScrollContainer
								height="24rem"
								width="100%"
								vertical="true"
								horizontal="false"
								focusable="false"
							>
							<Table
								id="vendorTable"
								items="{/Vendors}"
								mode="MultiSelect"
								selectionChange=".onVendorSelectionChange"
								sticky="ColumnHeaders"
								growing="true"
								growingThreshold="15"
								growingScrollToLoad="true"
								noDataText="Không tải được danh sách Nhà cung cấp từ SAP."
							>
								<columns>
									<Column width="9rem"><Text text="Mã NCC"/></Column>
									<Column><Text text="Tên Nhà cung cấp"/></Column>
									<Column><Text text="Email nhận RFQ"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<ObjectIdentifier title="{VendorNo}"/>
											<Text text="{VendorName}"/>
											<Text text="{= ${Email} || ${VendorEmail} || '(chưa có email — sẽ bỏ qua khi gửi)' }"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</VBox>

						<!-- CARD 3: HAN NOP & GUI -->
						<VBox class="qdContentCard qdCardAccentPurple qdRfqSendCard">
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center">
									<Text text="3" class="qdStepBadge qdStepBadgePurple"/>
									<VBox>
										<Title text="Hạn nộp báo giá &amp; Gửi RFQ" level="H3" class="qdCardTitle"/>
										<Text text="Hệ thống sinh mã RFQ, lưu vào SAP và gửi email mời báo giá tới các NCC đã chọn" class="qdCellHint"/>
									</VBox>
								</HBox>
								<ObjectStatus
									icon="sap-icon://supplier"
									text="{= ${/selectedVendorCount} + ' NCC đã chọn' }"
									state="{= ${/selectedVendorCount} === 0 ? 'Error' : (${/selectedVendorCount} === 1 ? 'Warning' : 'Success') }"
									class="qdRfqVendorCount"
								/>
							</HBox>

							<HBox alignItems="End" wrap="Wrap" class="qdRfqSendRow">
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Hạn nộp báo giá (Deadline)" required="true"/>
									<DatePicker
										id="dpDeadline"
										valueFormat="yyyy-MM-dd"
										displayFormat="dd/MM/yyyy"
										width="14rem"
									/>
								</VBox>
								<!-- BO class qdActionBtn: class do sinh ra cho the action tren Dashboard,
								     keo theo align-self:flex-start + margin-top 0.9rem lam nut bi day
								     lech khoi vien gradient (vien ve theo .sapMBtnInner cao 2.75rem
								     nhung vung bam la the goc .sapMBtn cao mac dinh ~2.3rem) -> chi
								     phan giao nhau o goc la bam duoc. -->
								<Button
									text="Tạo &amp; Gửi RFQ"
									type="Emphasized"
									icon="sap-icon://email"
									press=".onCreateAndSendRFQ"
									enabled="{= ${/selectedVendorCount} > 0 }"
									class="qdPrimarySubmitBtn"
								/>
							</HBox>

							<Text
								text="Chọn ít nhất 1 Nhà cung cấp ở bước 2 để bật nút gửi."
								visible="{= ${/selectedVendorCount} === 0 }"
								class="qdCellHint sapUiTinyMarginTop"
							/>
						</VBox>

					</VBox>
				</l:contentAreas>
			</l:Splitter>

		</content>
	</Page>
</mvc:View>
