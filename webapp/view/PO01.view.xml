<mvc:View
	controllerName="com.qdavy.procurement.controller.PO01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 3 · Phương án mua sắm" class="qdPageEyebrow"/>
						<Title text="Chọn nhà cung cấp &amp; Tạo Purchase Order" level="H1" class="qdPageTitle"/>
						<Text text="Chọn PR đã duyệt, tham khảo gợi ý AI rồi tạo PO ghi thẳng sang SAP" class="qdPageSub"/>
					</VBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep qdFlowStepActive"/>
				</HBox>
			</VBox>

			<!-- ============ SPLITTER: PR ĐÃ DUYỆT | TẠO PO ============ -->
			<l:Splitter height="100%" width="100%" class="qdSplitter">
				<l:contentAreas>

					<!-- ==== TRAI: DANH SACH PR DA DUYET ==== -->
					<VBox width="100%">
						<layoutData>
							<l:SplitterLayoutData size="38%" minSize="300"/>
						</layoutData>

						<VBox class="qdContentCard qdCardTight">
							<HBox alignItems="Center" class="sapUiSmallMargin">
								<Text text="1" class="qdStepBadge"/>
								<VBox>
									<Title text="Chọn đề nghị đã duyệt" level="H3" class="qdCardTitle"/>
									<Text text="Bấm vào một dòng để lập phương án" class="qdCellHint"/>
								</VBox>
							</HBox>

							<Table
								id="approvedPRTable"
								items="{mockData>/pendingPRs}"
								mode="SingleSelectMaster"
								selectionChange=".onPRSelect"
								noDataText="Chưa có đề nghị nào được duyệt. Hãy chờ CFO/CEO phê duyệt ở màn PR-02."
							>
								<columns>
									<Column width="8rem"><Text text="Mã PR"/></Column>
									<Column><Text text="Vật tư"/></Column>
									<Column hAlign="End" width="9rem"><Text text="Giá trị"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier title="{mockData>PrNumber}"/>
											<VBox>
												<Text text="{mockData>Description}"/>
												<Text text="{mockData>MaterialNo}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber
												number="{mockData>EstimatedValue}"
												unit="{mockData>Currency}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</VBox>

					<!-- ==== PHAI: TAO PO ==== -->
					<VBox id="poCreationArea" width="100%" visible="false">
						<layoutData>
							<l:SplitterLayoutData size="62%" minSize="420"/>
						</layoutData>

						<!-- 2. Thong tin PR goc -->
						<VBox class="qdContentCard">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="2" class="qdStepBadge"/>
								<Title text="Thông tin yêu cầu gốc" level="H3" class="qdCardTitle"/>
							</HBox>

							<HBox wrap="Wrap" class="qdInfoRow">
								<VBox class="qdInfoCell">
									<Label text="Mã số PR" class="qdInfoLabel"/>
									<Text id="txtSelectedPR" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Vật tư cần mua" class="qdInfoLabel"/>
									<Text id="txtMaterialInfo" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Số lượng yêu cầu" class="qdInfoLabel"/>
									<Text id="txtQuantity" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Ngân sách ước tính" class="qdInfoLabel"/>
									<ObjectNumber id="numEstimatedValue" number="" unit="" class="qdInfoValue"/>
								</VBox>
							</HBox>
						</VBox>

						<!-- 3. AI goi y NCC -->
						<!-- 3. AI gợi ý NCC & Chọn phương án -->
						<VBox class="qdContentCard qdCardTight">
							<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
								<HBox alignItems="Center">
									<Text text="3" class="qdStepBadge"/>
									<VBox>
										<Title text="Phương án &amp; Gợi ý Nhà cung cấp" level="H3" class="qdCardTitle"/>
										<Text text="AI phân tích đánh giá, năng lực và giá đề xuất từ hệ thống SAP" class="qdCellHint"/>
									</VBox>
								</HBox>
								<Button
									text="Gọi AI tư vấn lại"
									icon="sap-icon://ai"
									press=".onCallAIVendors"
									class="qdAiBtn"
								/>
							</HBox>

							<Table
								id="aiVendorTable"
								items="{mockData>/aiSuggestedVendors}"
								mode="SingleSelectMaster"
								selectionChange=".onVendorSelect"
								noDataText="Vui lòng chọn một PR ở bảng bên trái để hiển thị nhà cung cấp gợi ý."
								class="sapUiTinyMarginBottom"
							>
								<columns>
									<Column width="35%"><Text text="Nhà cung cấp (SAP LIFNR)"/></Column>
									<Column hAlign="Center" width="10rem"><Text text="Đánh giá chất lượng"/></Column>
									<Column hAlign="End" width="10rem"><Text text="Giá đề xuất (VND)"/></Column>
									<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Phân tích &amp; Lý do chọn từ AI"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier 
												title="{mockData>VendorName}" 
												text="Mã NCC: {mockData>VendorNo}"
											/>
											<VBox alignItems="Center">
												<RatingIndicator
													value="{mockData>Rating}"
													maxValue="5"
													visualMode="Half"
													iconSize="0.85rem"
													enabled="false"
												/>
												<Text text="{path: 'mockData>Rating', formatter: '.formatRating'}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber 
												number="{path: 'mockData>PriceProposal', formatter: '.formatCurrency'}" 
												unit="VND"
												state="Success"
											/>
											<VBox>
												<Text text="{mockData>AiReason}" class="qdAiReason"/>
											</VBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- 4. Xác nhận đơn mua hàng (PO Form) -->
						<VBox class="qdContentCard">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="4" class="qdStepBadge"/>
								<VBox>
									<Title text="Xác nhận chi tiết Purchase Order" level="H3" class="qdCardTitle"/>
									<Text text="Kiểm tra thông tin nhà cung cấp và giá thương lượng trước khi ghi sang SAP" class="qdCellHint"/>
								</VBox>
							</HBox>

							<f:SimpleForm 
								editable="true" 
								layout="ColumnLayout" 
								columnsM="2" 
								columnsL="2"
								labelSpanM="12"
								labelSpanL="12"
								class="sapUiNoContentPadding"
							>
								<f:content>
									<core:Title text="Thông tin Thương lượng" />
									
									<Label text="Nhà cung cấp lựa chọn" required="true"/>
									<Input 
										id="inSelectedVendor" 
										editable="false" 
										placeholder="← Click chọn 1 Nhà cung cấp ở bảng trên"
										valueHelpOnly="true"
										showValueHelp="false"
									/>

									<Label text="Giá thương lượng cuối cùng (VND)" required="true"/>
									<StepInput 
										id="inFinalPrice" 
										width="100%" 
										step="1000000" 
										min="0" 
										value="0"
										displayValuePrecision="0"
										change=".onFinalPriceChange"
									/>

									<core:Title text="Điều khoản &amp; Giao nhận" />

									<Label text="Điều khoản giao hàng"/>
									<Input 
										id="inDeliveryTerms" 
										placeholder="VD: Giao tại kho QDPL trong 7 ngày làm việc"
									/>

									<Label text="Ghi chú đơn hàng (Header Text)"/>
									<Input 
										id="inPoRemark" 
										placeholder="VD: Đơn hàng ưu tiên cấp phép theo PR phê duyệt"
									/>
								</f:content>
							</f:SimpleForm>

							<MessageStrip
								text="Sau khi bấm xác nhận, PO sẽ được ghi trực tiếp vào SAP Gateway (Table EKKO/EKPO) kèm liên kết BANFN về PR gốc."
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginTop qdAiMessageStrip"
							/>

							<HBox justifyContent="End" alignItems="Center" class="sapUiMediumMarginTop">
								<Button
									text="Tạo Purchase Order sang SAP"
									type="Emphasized"
									icon="sap-icon://accept"
									press=".onConfirmCreatePO"
									class="qdPrimarySubmitBtn"
								/>
							</HBox>
						</VBox>
					</VBox>

				</l:contentAreas>
			</l:Splitter>

		</content>
	</Page>
</mvc:View>
