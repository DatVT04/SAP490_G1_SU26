<mvc:View
	controllerName="com.qdavy.procurement.controller.PO01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 3 · Phương án mua sắm" class="qdPageEyebrow"/>
						<Title text="Chọn nhà cung cấp &amp; Tạo Purchase Order" level="H1" class="qdPageTitle"/>
						<Text text="Chọn PR đã duyệt, tham khảo gợi ý AI rồi tạo PO ghi thẳng sang SAP" class="qdPageSub"/>
					</VBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep qdFlowStepActive"/>
				</HBox>
			</VBox>

			<!-- ============ SPLITTER: PR ĐÃ DUYỆT | TẠO PO ============ -->
			<l:Splitter height="100%" width="100%" class="qdSplitter">
				<l:contentAreas>

					<!-- ==== TRAI: DANH SACH PR DA DUYET ==== -->
					<VBox width="100%">
						<layoutData>
							<l:SplitterLayoutData size="38%" minSize="300"/>
						</layoutData>

						<VBox class="qdContentCard qdCardTight">
							<HBox alignItems="Center" class="sapUiSmallMargin">
								<Text text="1" class="qdStepBadge"/>
								<VBox>
									<Title text="Chọn đề nghị đã duyệt" level="H3" class="qdCardTitle"/>
									<Text text="Bấm vào một dòng để lập phương án" class="qdCellHint"/>
								</VBox>
							</HBox>

							<Table
								id="approvedPRTable"
								items="{mockData>/pendingPRs}"
								mode="SingleSelectMaster"
								selectionChange=".onPRSelect"
								noDataText="Chưa có đề nghị nào được duyệt. Hãy chờ CFO/CEO phê duyệt ở màn PR-02."
							>
								<columns>
									<Column width="8rem"><Text text="Mã PR"/></Column>
									<Column><Text text="Vật tư"/></Column>
									<Column hAlign="End" width="9rem"><Text text="Giá trị"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier title="{mockData>PrNumber}"/>
											<VBox>
												<Text text="{mockData>Description}"/>
												<Text text="{mockData>MaterialNo}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber
												number="{mockData>EstimatedValue}"
												unit="{mockData>Currency}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>
					</VBox>

					<!-- ==== PHAI: TAO PO ==== -->
					<VBox id="poCreationArea" width="100%" visible="false">
						<layoutData>
							<l:SplitterLayoutData size="62%" minSize="420"/>
						</layoutData>

						<!-- 2. Thong tin PR goc -->
						<VBox class="qdContentCard">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="2" class="qdStepBadge"/>
								<Title text="Thông tin yêu cầu gốc" level="H3" class="qdCardTitle"/>
							</HBox>

							<HBox wrap="Wrap" class="qdInfoRow">
								<VBox class="qdInfoCell">
									<Label text="Mã số PR" class="qdInfoLabel"/>
									<Text id="txtSelectedPR" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Vật tư cần mua" class="qdInfoLabel"/>
									<Text id="txtMaterialInfo" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Số lượng yêu cầu" class="qdInfoLabel"/>
									<Text id="txtQuantity" text="" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Ngân sách ước tính" class="qdInfoLabel"/>
									<ObjectNumber id="numEstimatedValue" number="" unit="" class="qdInfoValue"/>
								</VBox>
							</HBox>
						</VBox>

						<!-- 3. AI goi y NCC -->
						<VBox class="qdContentCard qdCardTight">
							<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
								<HBox alignItems="Center">
									<Text text="3" class="qdStepBadge"/>
									<VBox>
										<Title text="Phương án mua sắm" level="H3" class="qdCardTitle"/>
										<Text text="AI phân tích giá, thời gian giao hàng và đánh giá NCC" class="qdCellHint"/>
									</VBox>
								</HBox>
								<Button
									text="Gọi AI tư vấn lại"
									icon="sap-icon://ai"
									press=".onCallAIVendors"
									class="qdAiBtn"
								/>
							</HBox>

							<Table
								id="aiVendorTable"
								items="{mockData>/aiSuggestedVendors}"
								mode="SingleSelectLeft"
								selectionChange=".onVendorSelect"
								noDataText="Chọn một PR ở bảng bên trái để AI đề xuất nhà cung cấp."
							>
								<columns>
									<Column width="30%"><Text text="Nhà cung cấp"/></Column>
									<Column hAlign="Center" width="7rem"><Text text="Đánh giá"/></Column>
									<Column hAlign="End" width="9rem"><Text text="Giá đề xuất"/></Column>
									<Column minScreenWidth="Desktop" demandPopin="true"><Text text="Phân tích từ AI"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<ObjectIdentifier title="{mockData>VendorName}" text="Mã: {mockData>VendorNo}"/>
											<RatingIndicator
												value="{mockData>Rating}"
												maxValue="5"
												visualMode="Half"
												iconSize="0.8rem"
												enabled="false"
											/>
											<ObjectNumber number="{mockData>PriceProposal}" unit="VND"/>
											<Text text="{mockData>AiReason}" class="qdAiReason"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- 4. Xac nhan tao PO -->
						<VBox class="qdContentCard">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="4" class="qdStepBadge"/>
								<Title text="Xác nhận đơn mua hàng" level="H3" class="qdCardTitle"/>
							</HBox>

							<f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" columnsL="1">
								<f:content>
									<Label text="Nhà cung cấp lựa chọn" required="true"/>
									<Input id="inSelectedVendor" editable="false" placeholder="Chọn 1 nhà cung cấp ở bảng trên"/>

									<Label text="Giá thương lượng cuối cùng" required="true"/>
									<StepInput id="inFinalPrice" width="100%" step="500000" min="0" value="0"/>

									<Label text="Điều khoản giao hàng"/>
									<Input id="inDeliveryTerms" placeholder="VD: Giao tại kho QDPL trong 7 ngày"/>
								</f:content>
							</f:SimpleForm>

							<MessageStrip
								text="PO sẽ được ghi vào SAP kèm liên kết BANFN về PR gốc — có thể tra cứu bằng ME23N."
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginTop qdAiMessageStrip"
							/>

							<HBox justifyContent="End" class="sapUiMediumMarginTop">
								<Button
									text="Tạo Purchase Order sang SAP"
									type="Emphasized"
									icon="sap-icon://accept"
									press=".onConfirmCreatePO"
								/>
							</HBox>
						</VBox>
					</VBox>

				</l:contentAreas>
			</l:Splitter>

		</content>
	</Page>
</mvc:View>
