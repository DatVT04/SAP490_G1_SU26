<mvc:View
	controllerName="com.qdavy.procurement.controller.asset.AssetAssign"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="Mua sắm · Sau khi nhận hàng" class="qdPageEyebrow"/>
							<Title text="Gán mã tài sản" level="H1" class="qdPageTitle"/>
							<Text text="Vật tư đã đặt mua nhưng chưa có mã tài sản. Gán mã ở đây, hệ thống ghi thẳng lên SAP — mỗi đơn vị số lượng một mã riêng." class="qdPageSub"/>
						</VBox>
					</HBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="MIGO Nhận hàng" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="Gán mã tài sản" class="qdFlowStep qdFlowStepActive"/>
				</HBox>
			</VBox>

			<VBox class="qdContentCard qdCardTight">
				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://add-product" class="qdCardIcon sapUiTinyMarginEnd"/>
					<Title text="Vật tư chờ gán mã ({/openCount})" level="H3" class="qdCardTitle"/>
				</HBox>

				<MessageStrip
					text="Chỉ vật tư loại Tài sản (ZAST) của những đề nghị đã tạo đơn hàng mới hiện ở đây. Dịch vụ (ZSRV) không có mã tài sản."
					type="Information"
					showIcon="true"
					class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
				/>

				<VBox class="qdEmptyState" alignItems="Center" visible="{= ${/rows}.length === 0 }">
					<core:Icon src="sap-icon://complete" class="qdEmptyIcon"/>
					<Title text="Không có vật tư nào chờ gán mã" level="H3" class="qdEmptyTitle"/>
					<Text text="Mọi vật tư tài sản đã có mã." class="qdEmptyText" textAlign="Center"/>
				</VBox>

				<Table
					items="{/rows}"
					class="qdDataTable"
					visible="{= ${/rows}.length > 0 }"
					growing="true"
					growingThreshold="30"
				>
					<columns>
						<Column width="11rem"><Text text="Đề nghị / Đơn hàng"/></Column>
						<Column><Text text="Vật tư"/></Column>
						<Column width="6rem" hAlign="Center"><Text text="Số lượng"/></Column>
						<Column width="8rem"><Text text="Bộ phận"/></Column>
						<Column width="16rem"><Text text="Mã tài sản đã gán"/></Column>
						<Column width="9rem" hAlign="End"><Text text=""/></Column>
					</columns>
					<items>
						<ColumnListItem vAlign="Top">
							<cells>
								<VBox>
									<Text text="{DisplayId}" class="qdCellStrong"/>
									<Text text="{= ${PoNumber} ? ('PO ' + ${PoNumber}) : '(chưa đọc được số PO)' }" class="qdCellHint"/>
								</VBox>
								<VBox>
									<Text text="{Description}" class="qdCellStrong"/>
									<Text text="{MaterialNo}" class="qdCellHint"/>
								</VBox>
								<Text text="{Quantity} {UoM}"/>
								<Text text="{CostCenter}"/>
								<VBox>
									<Text
										text="{= ${AssignedAssets}.length > 0 ? ${AssignedAssets}.join(', ') : '— chưa có —' }"
										class="qdCellStrong"
									/>
									<ObjectStatus
										text="{= ${Remaining} > 0 ? ('còn thiếu ' + ${Remaining} + ' mã') : 'đã đủ' }"
										state="{= ${Remaining} > 0 ? 'Warning' : 'Success' }"
									/>
								</VBox>
								<Button
									text="Gán mã tài sản"
									type="Emphasized"
									icon="sap-icon://add"
									press=".onCreatePress"
									enabled="{= ${Remaining} > 0 }"
								/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>

		</content>
	</Page>
</mvc:View>
