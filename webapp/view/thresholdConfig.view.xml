<mvc:View
    controllerName="com.qdavy.procurement.controller.ThresholdConfig"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page showHeader="false" class="qdInnerPage">
        <content>

            <!-- ============ HERO ============ -->
            <VBox class="qdPageHero">
                <HBox alignItems="Center">
                    <Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
                    <VBox>
                        <Text text="Quản trị hệ thống · CEO" class="qdPageEyebrow"/>
                        <Title text="Cấu hình ngưỡng phê duyệt" level="H1" class="qdPageTitle"/>
                        <Text text="Thiết lập mốc giá trị khiến đề nghị mua sắm phải leo thang lên cấp cao hơn" class="qdPageSub"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox>

                <!-- THẺ CẤU HÌNH NGƯỠNG PHÊ DUYỆT PR -->
                <VBox class="qdContentCard">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://settings" class="qdCardIcon"/>
                        <Title text="Ngưỡng leo thang phê duyệt PR" level="H3" class="qdCardTitle" />
                    </HBox>
                    <Text text="Khi giá trị đề nghị mua sắm vượt ngưỡng dưới đây, quy trình duyệt sẽ tự động leo thang lên CEO phê duyệt."
                          class="qdCellHint sapUiSmallMarginBottom" />
                    
                    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="4" columnsL="1">
                        <f:content>
                            <Label text="Ngưỡng phê duyệt hiện tại (VND)" required="true" />
                            <!-- Sử dụng StepInput cho phép tăng giảm giá trị tiện lợi -->
                            <StepInput id="inPrThreshold" 
                                       width="100%" 
                                       step="10000000" 
                                       min="10000000" 
                                       value="{thresholdModel>/prThreshold}" />
                            
                            <Label text="Trạng thái áp dụng" />
                            <Switch id="swThresholdStatus" state="{thresholdModel>/isActive}" customTextOn="Bật" customTextOff="Tắt" />
                            
                            <Label text="Mô tả quy tắc" />
                            <!-- SỬA Ở ĐÂY: Dùng formatter của SAPUI5 để tự động format số và cập nhật realtime khi kéo StepInput -->
                            <TextArea id="txtThresholdDesc" 
                                      rows="3" 
                                      value="{
                                          parts: [{path: 'thresholdModel>/prThreshold'}],
                                          formatter: '.formatter.formatThresholdDesc'
                                      }" 
                                      editable="false" 
                                      class="qdMutedText" />
                        </f:content>
                    </f:SimpleForm>
                </VBox>

                <!-- THẺ TIỆN ÍCH PHỤ TRỢ (Xem lịch sử thay đổi) -->
                <VBox class="qdContentCard qdCardTight">
                    <Table id="thresholdHistoryTable" items="{thresholdModel>/history}">
                        <headerToolbar>
                            <OverflowToolbar style="Clear">
                                <core:Icon src="sap-icon://history" class="qdCardIcon"/>
                                <Title text="Lịch sử thay đổi cấu hình" level="H3" class="qdCardTitle"/>
                            </OverflowToolbar>
                        </headerToolbar>
                        
                        <columns>
                            <Column><Text text="Ngày cập nhật" /></Column>
                            <Column><Text text="Người thực hiện" /></Column>
                            <Column hAlign="End"><Text text="Ngưỡng cũ (VND)" /></Column>
                            <Column hAlign="End"><Text text="Ngưỡng mới (VND)" /></Column>
                            <Column><Text text="Ghi chú" /></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{thresholdModel>date}" />
                                    <Text text="{thresholdModel>updatedBy}" />
                                    <!-- SỬA Ở ĐÂY: Sử dụng type chuẩn Integer kết hợp groupingSeparator để có dấu chấm phân cách -->
                                    <ObjectNumber 
                                        number="{
                                            path: 'thresholdModel>oldValue',
                                            type: 'sap.ui.model.type.Integer',
                                            formatOptions: {
                                                groupingEnabled: true,
                                                groupingSeparator: '.'
                                            }
                                        }" />
                                    <ObjectNumber 
                                        number="{
                                            path: 'thresholdModel>newValue',
                                            type: 'sap.ui.model.type.Integer',
                                            formatOptions: {
                                                groupingEnabled: true,
                                                groupingSeparator: '.'
                                            }
                                        }" 
                                        state="Success" />
                                    <Text text="{thresholdModel>note}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- KHU VỰC NÚT LƯU CẤU HÌNH -->
                <HBox justifyContent="End" class="sapUiMediumMarginBottom sapUiMediumMarginEnd">
                    <Button text="Lưu cấu hình"
                            type="Emphasized"
                            icon="sap-icon://save"
                            press=".onSaveThreshold" />
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>