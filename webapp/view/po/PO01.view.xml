<mvc:View
	controllerName="com.qdavy.procurement.controller.po.PO01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- HERO HEADER -->
			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Quy trình Mua sắm · Bước 3" class="qdPageEyebrow"/>
						<Title text="Lập &amp; Phát hành Purchase Order (PO)" level="H1" class="qdPageTitle"/>
						<Text text="Chuyển đề nghị đã duyệt thành đơn hàng (PO) và gửi nhà cung cấp" class="qdPageSub"/>
					</VBox>
				</HBox>
			</VBox>

			<l:Splitter height="100%" width="100%" class="qdSplitter">
				<l:contentAreas>

					<!-- BẢNG PR ĐÃ DUYỆT (SAP ODATA DATA SOURCE) -->
					<VBox width="100%" class="qdStickyLeftPane">
						<layoutData>
							<l:SplitterLayoutData size="35%" minSize="320"/>
						</layoutData>

						<VBox class="qdContentCard qdCardTight qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMargin">
								<Text text="1" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="Danh sách PR đã duyệt" level="H3" class="qdCardTitle"/>
									<Text text="Chọn một đề nghị đã duyệt để lập PO" class="qdCellHint"/>
								</VBox>
							</HBox>

							<!-- Le trai/phai dat o VBox boc ngoai, KHONG dat thang len SearchField:
							     width="100%" cong margin thi tong be ngang vuot khung cha nen o tim
							     bi tran sang phai, lech so voi bang ben duoi. -->
							<VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginBottom">
								<SearchField
									id="sfApprovedPRSearch"
									placeholder="Tìm mã PR, mô tả hoặc mã vật tư / dịch vụ..."
									liveChange=".onApprovedPRSearch"
									search=".onApprovedPRSearch"
									width="100%"
								/>
							</VBox>

							<!-- Lấy dữ liệu thật trực tiếp từ EntitySet PurchaseRequisitions -->
							<ScrollContainer height="calc(100vh - 24rem)" width="100%" vertical="true" horizontal="false" focusable="false">
							<Table
								id="approvedPRTable"
								items="{/PurchaseRequisitions}"
								mode="SingleSelectMaster"
								selectionChange=".onPRSelect"
								sticky="ColumnHeaders"
								growing="true"
								growingThreshold="15"
								growingScrollToLoad="true"
								noDataText="Chưa có đề nghị (PR) nào được duyệt trên SAP."
							>
								<columns>
									<Column width="7rem"><Text text="Mã PR"/></Column>
									<Column><Text text="Vật tư / Dịch vụ &amp; Yêu cầu"/></Column>
									<Column hAlign="End" width="8rem"><Text text="Giá trị ước tính"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier title="{PrNumber}"/>
											<VBox>
												<Text text="{Description}" renderWhitespace="true"/>
												<Text text="{parts: ['MaterialNo','Quantity','UoM'], formatter: '.formatMatQtyHint'}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber
												number="{path: 'EstimatedValue', formatter: '.formatCurrency'}"
												unit="{Currency}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</VBox>
					</VBox>

					<!-- KHU VỰC THIẾT LẬP VÀ XÁC NHẬN TẠO PO -->
					<VBox id="poCreationArea" width="100%" visible="false">
						<layoutData>
							<l:SplitterLayoutData size="65%" minSize="450"/>
						</layoutData>

						<!-- CARD 2: THÔNG TIN PR NGUỒN (ORIGIN PR REFERENCE) -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="2" class="qdStepBadge qdStepBadgePurple"/>
								<Title text="Thông tin đề nghị gốc (PR Reference)" level="H3" class="qdCardTitle"/>
							</HBox>

							<HBox wrap="Wrap" class="qdInfoRow qdInfoRowEven">
								<VBox class="qdInfoCell">
									<Label text="Mã PR / Dòng" class="qdInfoLabel"/>
									<Text id="txtSelectedPR" text="--" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Người đề nghị (Requester)" class="qdInfoLabel"/>
									<Text id="txtRequester" text="--" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Tên vật tư / dịch vụ" class="qdInfoLabel"/>
									<Text id="txtMaterialInfo" text="--" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Số lượng &amp; ĐVT" class="qdInfoLabel"/>
									<Text id="txtQuantity" text="--" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Giá trị dự kiến" class="qdInfoLabel"/>
									<ObjectNumber id="numEstimatedValue" number="0" unit="" class="qdInfoValue"/>
								</VBox>
							</HBox>
						</VBox>

						<!-- CARD 3: TỔ CHỨC & BÊN MUA (HEADER ORG DATA + BUYER) -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="3" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="Dữ liệu Tổ chức &amp; Bên mua" level="H3" class="qdCardTitle"/>
									<Text text="Dữ liệu tổ chức lấy theo cấu hình hệ thống từ lúc lập đề nghị — chỉ xem, không sửa" class="qdCellHint"/>
								</VBox>
							</HBox>

							<f:SimpleForm
								editable="true"
								layout="ColumnLayout"
								columnsM="1"
								columnsL="2"
								columnsXL="2"
								labelSpanM="4"
								labelSpanL="4"
								labelSpanXL="4"
								emptySpanM="0"
								emptySpanL="0"
								emptySpanXL="0"
								class="sapUiNoContentPadding qdSimpleForm"
							>
								<f:content>
									<core:Title text="Dữ liệu tổ chức (Org Data)" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<!-- CHI DOC (21/08/2026): 3 field nay do he thong xac dinh, khong
									     phai thu tu nguoi mua nhap. Truoc day de sua tay VOI gia tri mac
									     dinh 1000/1000/001 (so kieu IDES, khong ton tai trong he thong
									     cua nhom) — go nham la PO ghi sang cong ty/to chuc mua khong co
									     that. Gia tri that do controller do vao tu /api/config; de san
									     org that o day lam duong lui neu /api/config loi. -->
									<Label text="Mã công ty (Company Code)"/>
									<Input
										id="inCompanyCode"
										value="QD01"
										editable="false"
									/>

									<Label text="Tổ chức mua hàng (Purchasing Org)"/>
									<Input
										id="inPurchOrg"
										value="QDPO"
										editable="false"
									/>

									<Label text="Nhóm mua hàng (Purchasing Group)"/>
									<Input
										id="inPurchGroup"
										value="QD1"
										editable="false"
									/>

									<Label text="Loại chứng từ (Doc Type)"/>
									<Input
										id="inDocType"
										value="ZPO"
										editable="false"
										placeholder="ZPO - Standard PO"
									/>

									<Label text="Ngày lập chứng từ (Doc Date)" required="true"/>
									<DatePicker
										id="inDocDate"
										displayFormat="yyyy-MM-dd"
										valueFormat="yyyy-MM-dd"
										required="true"
									/>

									<core:Title text="Người đại diện" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<Label text="Tên người đại diện" required="true"/>
									<Input
										id="inBuyerName"
										placeholder=""
									/>

									<Label text="Số điện thoại"/>
									<Input
										id="inBuyerAddress"
										placeholder="VD: 0912 345 678"
										type="Tel"
										change=".onPhoneChange"
									/>
								</f:content>
							</f:SimpleForm>
						</VBox>

						<!-- CARD 4: NHÀ CUNG CẤP & GIÁ MUA (VENDOR & PRICING) -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="4" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="Nhà cung cấp &amp; Giá mua" level="H3" class="qdCardTitle"/>
									<Text text="Nhà cung cấp lấy từ SAP, kèm mã số thuế và giá đã chốt ở bước báo giá" class="qdCellHint"/>
								</VBox>
							</HBox>

							<!-- Bao cho nguoi mua biet vendor + gia ben duoi lay tu dong tu bao gia da chot
							     o RFQ-02. Dat NGOAI SimpleForm vi SimpleForm chi nhan Label + field. -->
							<!-- CHON NHOM (1 nhom = 1 RFQ da chot = 1 don hang). Chi hien khi PR that su
							     tach nhieu nhom; PR mua tu 1 NCC thi man hinh y nhu truoc. -->
							<VBox visible="{/hasMultiGroup}" class="sapUiSmallMarginBottom">
								<Label text="Nhóm nhà cung cấp (mỗi nhóm tạo 1 đơn hàng riêng)"/>
								<Select
									id="inRfqGroup"
									width="100%"
									selectedKey="{/selectedGroupKey}"
									items="{/RfqGroups}"
									change=".onGroupChange"
								>
									<core:ListItem key="{key}" text="{Text}"/>
								</Select>
							</VBox>
							<MessageStrip
								text="{/groupHint}"
								type="Warning"
								showIcon="true"
								visible="{/hasMultiGroup}"
								class="sapUiSmallMarginBottom"
							/>
							<MessageStrip
								id="msRfqInherited"
								text=""
								type="Success"
								showIcon="true"
								visible="false"
								class="sapUiSmallMarginBottom"
							/>

							<f:SimpleForm
								editable="true"
								layout="ColumnLayout"
								columnsM="1"
								columnsL="2"
								columnsXL="2"
								labelSpanM="4"
								labelSpanL="4"
								labelSpanXL="4"
								emptySpanM="0"
								emptySpanL="0"
								emptySpanXL="0"
								class="sapUiNoContentPadding qdSimpleForm"
							>
								<f:content>
									<core:Title text="Nhà cung cấp (Vendor)" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<Label text="Nhà cung cấp (Vendor / LIFNR)" required="true"/>
									<ComboBox
										id="inSelectedVendor"
										width="100%"
										placeholder="Chọn nhà cung cấp từ SAP..."
										items="{/Vendors}"
										selectionChange=".onVendorChange"
										showSecondaryValues="true"
									>
										<core:ListItem
											key="{VendorNo}"
											text="{VendorName} ({VendorNo})"
											additionalText="{Email}"
										/>
									</ComboBox>

									<Label text="Mã số thuế nhà cung cấp" required="true"/>
									<Input
										id="inVendorTaxCode"
										placeholder="Tự động lấy từ dữ liệu Business Partner trên SAP"
										editable="true"
									/>

									<Label text="Email nhận đơn hàng (tự động lấy từ SAP)" required="true"/>
									<Input
										id="inVendorEmail"
										placeholder="Email nhà cung cấp sẽ tự động hiển thị tại đây"
										editable="true"
									/>						

									<core:Title text="Giá mua (Pricing)" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<Label text="Đơn giá dòng đầu (tham khảo, tính trên 1 đơn vị)"/>
									<Input
										id="inNetPrice"
										editable="false"
										placeholder="Đơn giá lấy từ báo giá được chọn ở RFQ-02"
									/>

									<Label text="Loại tiền"/>
									<Input
										id="inCurrency"
										value="VND"
										editable="false"
									/>

									<Label text="Tổng giá trị PO (Total Value)"/>
									<ObjectNumber
										id="numTotalValue"
										number="0"
										unit="VND"
										state="Success"
										class="qdTotalAmount"
									/>
								</f:content>
							</f:SimpleForm>
						</VBox>

						<!-- CARD 5: GIAO HÀNG & THANH TOÁN -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="5" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="Giao hàng &amp; Thanh toán" level="H3" class="qdCardTitle"/>
									<Text text="Địa chỉ nhận hàng, người nhận, ngày nhận dự kiến và điều khoản thanh toán" class="qdCellHint"/>
								</VBox>
							</HBox>

							<f:SimpleForm
								editable="true"
								layout="ColumnLayout"
								columnsM="1"
								columnsL="2"
								columnsXL="2"
								labelSpanM="4"
								labelSpanL="4"
								labelSpanXL="4"
								emptySpanM="0"
								emptySpanL="0"
								emptySpanXL="0"
								class="sapUiNoContentPadding qdSimpleForm"
							>
								<f:content>
									<core:Title text="Địa điểm &amp; Người nhận hàng" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<Label text="Địa chỉ giao hàng" required="true"/>
									<TextArea
										id="inDeliveryAddress"
										rows="2"
										placeholder="Địa chỉ nhận hàng (kho / công trình / văn phòng...)"
									/>

									<Label text="Người nhận hàng" required="true"/>
									<Input
										id="inReceiverName"
										placeholder="Họ tên người nhận hàng"
									/>

									<Label text="Số điện thoại người nhận" required="true"/>
									<Input
										id="inReceiverPhone"
										placeholder="VD: 0912 345 678"
										type="Tel"
										change=".onPhoneChange"
									/>

									<Label text="Ngày nhận hàng dự kiến" required="true"/>
									<DatePicker
										id="inDeliveryDate"
										displayFormat="yyyy-MM-dd"
										valueFormat="yyyy-MM-dd"
										placeholder="Ngày dự kiến nhận hàng (khác ngày lập PO)"
										required="true"
									/>

									<core:Title text="Thanh toán" class="qdFormSectionTitle qdFormSectionTitlePurple"/>

									<Label text="Hình thức thanh toán" required="true"/>
									<Select id="inPaymentMethod">
										<core:Item key="TRANSFER" text="Chuyển khoản"/>
										<core:Item key="CASH" text="Tiền mặt"/>
									</Select>

									<Label text="Điều khoản thanh toán" required="true"/>
									<!-- Danh muc lay tu /api/config (PAYMENT_TERMS server) — cung 1 bo ma voi bao gia
									     RFQ-02, nen dieu khoan cua bao gia thang tu dien sang duoc (feedback QDAVY 13/08). -->
									<Select id="inPaymentTerms" items="{/paymentTerms}">
										<core:Item key="{code}" text="{label}"/>
									</Select>
								
								</f:content>
							</f:SimpleForm>
						</VBox>

						<!-- CARD 6: BẢNG PO ITEMS (DANH SÁCH DÒNG HÀNG SẼ TẠO) -->
						<VBox class="qdContentCard qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMarginBottom">
								<Text text="6" class="qdStepBadge qdStepBadgePurple"/>
								<Title text="Chi tiết dòng hàng (PO Items Table)" level="H3" class="qdCardTitle"/>
							</HBox>

							<Table id="poItemsTable" items="{/poItems}" noDataText="Chưa có dữ liệu dòng hàng">
								<columns>
									<Column width="4rem"><Text text="Item"/></Column>
									<Column width="8rem"><Text text="Mã PR Nguồn"/></Column>
									<Column><Text text="Mã &amp; Tên vật tư / dịch vụ"/></Column>
									<Column hAlign="End" width="7rem"><Text text="Số lượng"/></Column>
									<Column hAlign="End" width="9rem"><Text text="Đơn giá mua (1 đơn vị)"/></Column>
									<Column hAlign="End" width="10rem"><Text text="Thành tiền"/></Column>
									<Column width="6rem"><Text text="Nhà máy (Plant)"/></Column>
									<Column width="11rem"><Text text="Hạch toán"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{LineNo}"/>
											<Text text="{PreqNo}"/>
											<VBox>
												<Text text="{path: 'MaterialNo', formatter: '.formatMatNo'}" class="sapMTextBold"/>
												<Text text="{Description}"/>
												<ObjectStatus
													text="{= ${MaterialType} === 'ZAST' ? 'Vật tư/Tài sản' : (${MaterialType} === 'ZSRV' ? 'Dịch vụ' : ${MaterialType}) }"
													state="{= ${MaterialType} === 'ZSRV' ? 'Success' : 'Information' }"
													icon="{= ${MaterialType} === 'ZSRV' ? 'sap-icon://employee-lookup' : 'sap-icon://product' }"
													visible="{= !!${MaterialType} }"
												/>
											</VBox>
											<Text text="{Quantity} {UoM}"/>
											<!-- 21/08/2026: CHI XEM. Don gia dong nay duoc phan bo tu gia
											     TRUNG THAU cua nhom NCC (xem _allocateGroupPrice) — tuc la
											     con so da chot o RFQ-02 va da qua CFO/CEO duyet. Cho sua tay
											     o day nghia la PO gui NCC lech voi bao gia va lech voi so tien
											     da duyet. Muon doi gia thi phai quay lai RFQ-02. -->
											<Text text="{path: 'NetPrice', formatter: '.formatCurrency'}" textAlign="End"/>
											<VBox>
												<ObjectNumber
													number="{parts: ['NetPrice','Quantity'], formatter: '.formatLineTotal'}"
													unit="{Currency}"
													emphasized="true"
												/>
												<Text
													text="{parts: ['NetPrice','Quantity','UoM'], formatter: '.formatLineTotalHint'}"
													class="qdCellHint"
												/>
											</VBox>
											<!-- CHI XEM: Plant lay tu ORG_DEFAULTS (QDPL), khong phai thu
											     nguoi mua tu quyet tung dong. -->
											<Text text="{Plant}"/>
											<!-- Cot hach toan: dong Cost Center (Cat K) cho nhap tay, dong
											     Tai san (Cat A) / Internal Order (Cat F) chi hien ma lay tu
											     PR. Truoc day cot nay luon la o Cost Center nen dong tai san
											     hien o TRONG, nhin nhu he thong thieu du lieu hach toan. -->
											<VBox>
												<Text
													text="{parts: ['AcctAssignCat','AssetNo','InternalOrder'], formatter: '.formatAcctCatLabel'}"
													class="qdCellHint"
												/>
												<!-- CHI XEM: Cost Center lay nguyen tu dong PR (nguoi de nghi
												     bat buoc chon Bo phan o PR-01). -->
												<Text
													text="{CostCenter}"
													visible="{parts: ['AcctAssignCat','AssetNo','InternalOrder'], formatter: '.isAcctCostCenter'}"
												/>
												<ObjectStatus
													text="{parts: ['AcctAssignCat','AssetNo','InternalOrder'], formatter: '.formatAcctObject'}"
													state="{parts: ['AcctAssignCat','AssetNo','InternalOrder'], formatter: '.formatAcctObjectState'}"
													visible="{parts: ['AcctAssignCat','AssetNo','InternalOrder'], formatter: '.isAcctNotCostCenter'}"
												/>
											</VBox>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							
							<HBox justifyContent="End" alignItems="Center" class="sapUiMediumMarginTop">
								<Text
									text="Đề nghị đã được CFO/CEO phê duyệt. Ngay khi tạo đơn hàng, hệ thống sẽ gửi email cho nhà cung cấp."
									class="qdInfoHint sapUiSmallMarginEnd"
								/>
								<Button
									text="Tạo PO &amp; gửi nhà cung cấp"
									type="Emphasized"
									icon="sap-icon://sales-order"
									press=".onConfirmCreatePO"
									class="qdPrimarySubmitBtn"
								/>
							</HBox>
						</VBox>
					</VBox>

				</l:contentAreas>
			</l:Splitter>

		</content>
	</Page>
</mvc:View>
