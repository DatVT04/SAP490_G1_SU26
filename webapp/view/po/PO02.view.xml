<mvc:View
	controllerName="com.qdavy.procurement.controller.po.PO02"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="{/pageEyebrow}" class="qdPageEyebrow"/>
							<Title text="Duyệt đề nghị mua sắm" level="H1" class="qdPageTitle"/>
							<Text text="Nhà cung cấp đã được chốt với giá báo thực tế. Sau khi duyệt, Phòng Mua sắm mới tạo đơn hàng và gửi nhà cung cấp." class="qdPageSub"/>
						</VBox>
					</HBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="RFQ Chốt NCC" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="Duyệt đề nghị" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn &amp; gửi NCC" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<VBox class="qdContentCard qdCardTight">
				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://order-status" class="qdCardIcon sapUiTinyMarginEnd"/>
					<Title text="Đề nghị đang chờ duyệt ({= ${/pending}.length })" level="H3" class="qdCardTitle"/>
				</HBox>

				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${/pending}.length === 0 }"
				>
					<core:Icon src="sap-icon://complete" class="qdEmptyIcon"/>
					<Title text="Không có đề nghị nào đang chờ" level="H3" class="qdEmptyTitle"/>
					<Text text="Tất cả đề nghị đã được xử lý." class="qdEmptyText" textAlign="Center"/>
				</VBox>

				<ScrollContainer
					height="calc(100vh - 18rem)"
					width="100%"
					vertical="true"
					horizontal="false"
					focusable="false"
					visible="{= ${/pending}.length > 0 }"
				>
				<List
					id="poPendingList"
					items="{/pending}"
					mode="None"
					showSeparators="None"
					growing="true"
					growingThreshold="5"
					growingScrollToLoad="true"
					class="qdApprovalList"
				>
					<CustomListItem>
						<VBox class="qdApprovalCard">

							<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="qdApprovalCardHeader">
								<HBox alignItems="Center">
									<core:Icon src="sap-icon://sales-order" class="qdPRIcon sapUiTinyMarginEnd"/>
									<VBox>
										<ObjectIdentifier title="PR {DisplayId}" text="Người đề nghị: {RequesterEmail}"/>
										<Text text="Chốt nhà cung cấp lúc: {path: 'UpdatedAt', formatter: '.formatDateTime'}" class="qdCellHint sapUiTinyMarginTop"/>
									</VBox>
								</HBox>

								<HBox wrap="Wrap" alignItems="Center">
									<ObjectStatus
										text="Vượt hạn mức ngân sách — cần CEO duyệt"
										state="Error"
										visible="{needsProcurementHeadReview}"
										icon="sap-icon://alert"
										class="qdBadgeDanger sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Giá trị lớn — cần xem xét kỹ"
										state="Warning"
										visible="{= ${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://warning"
										class="qdBadgeWarning sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Trong hạn mức bình thường"
										state="Success"
										visible="{= !${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://accept"
										class="qdBadgeOk"
									/>
								</HBox>
							</HBox>

							<!-- ══ VI SAO CAN MUA ══
							     21/08/2026: truoc day man nay chi hien GIA (uoc tinh vs chot) va bang
							     chung canh tranh gia. CFO/CEO duyet TIEN ma khong he thay CAN CU NHU CAU
							     nguoi de nghi khai o PR-01 — muc do truoc gio chi Purchasing thay o PR-02.
							     Nguon: ZPR_DRAFT-PURCHASE_REASON (CHAR 255), map o pr.service.js. -->
							<VBox class="qdDecisionBox sapUiTinyMarginTopBottom">
								<Text text="LÝ DO ĐỀ NGHỊ MUA" class="qdDecisionTitle"/>
								<!-- 2 Text thay vi 1 Text co class="{= ... }": XMLView cua UI5 KHONG
								     binding duoc thuoc tinh class, viet vay thi control ra DOM khong
								     co class nao ca (bo qua im lang, khong bao loi). -->
								<Text text="{PurchaseReason}" class="qdDecisionValue" visible="{= !!${PurchaseReason} }"/>
								<Text text="(đề nghị cũ — chưa có lý do)" class="qdCellHint" visible="{= !${PurchaseReason} }"/>
							</VBox>

							<!-- GIA UOC TINH vs GIA CHOT — day chinh la thu CFO can de biet NCC
							     co "het gia" hay khong. EstimatedTotalValue = snapshot luc lap
							     de nghi; TotalValue = tong gia trung thau sau RFQ. -->
							<HBox wrap="Wrap" class="qdInfoRow sapUiTinyMarginTopBottom">
								<VBox class="qdInfoCell">
									<Text text="Giá ước tính ban đầu" class="qdInfoLabel"/>
									<Text text="{parts: ['EstimatedTotalValue','Currency'], formatter: '.formatValue'}" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Text text="Giá chốt sau báo giá" class="qdInfoLabel"/>
									<Title text="{parts: ['TotalValue','Currency'], formatter: '.formatValue'}" level="H3" class="qdRowAmount"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Text text="Chênh lệch" class="qdInfoLabel"/>
									<ObjectStatus
										text="{parts: ['EstimatedTotalValue','TotalValue'], formatter: '.formatDiff'}"
										state="{parts: ['EstimatedTotalValue','TotalValue'], formatter: '.formatDiffState'}"
									/>
								</VBox>
							</HBox>

							<!-- Tung PO trong PR (moi nhom NCC 1 PO) -->
							<VBox class="qdAwardBox sapUiTinyMarginTopBottom">
								<HBox alignItems="Center" class="sapUiTinyMarginBottom">
									<core:Icon src="sap-icon://supplier" class="qdAwardIcon sapUiTinyMarginEnd"/>
									<Text text="Nhà cung cấp đã chốt trong đề nghị này" class="qdInfoLabel"/>
								</HBox>
								<List items="{AwardGroups}" showSeparators="Inner">
									<CustomListItem>
										<VBox class="qdPoGroupRow">
											<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
												<VBox>
													<Text
														text="{= (${AwardedVendorName} || ${AwardedVendor} || '—') }"
														class="qdDecisionValue"
													/>
													<Text
														text="{= (${RfqId} ? ${RfqId} + ' · ' : '') + (${ItemLines} ? ('dòng ' + ${ItemLines}) : 'toàn bộ dòng') }"
														class="qdCellHint"
													/>
												</VBox>
												<ObjectStatus
													text="{parts: ['FinalValue','Currency'], formatter: '.formatValue'}"
													state="Information"
												/>
											</HBox>

											<!-- ══ BANG CHUNG CANH TRANH GIA ══
											     Day la thu CFO thuc su can de duyet CHI TIEN: co that su hoi gia
											     nhieu NCC khong, gia da chon co phai re nhat khong, khong re nhat
											     thi vi sao. Tinh tu ZG1_QUOTATION — xem decision-context.service.js. -->
											<VBox class="qdDecisionBox sapUiTinyMarginTop" visible="{= !!${Evidence} }">
												<Text text="CĂN CỨ CHỐT GIÁ" class="qdDecisionTitle"/>
												<Text
													text="{parts: ['Evidence/Invited','Evidence/Received'], formatter: '.formatCompetition'}"
													class="qdDecisionValue sapUiTinyMarginTop"
												/>
												<Text
													text="{parts: ['Evidence/LowestPrice','Evidence/HighestPrice','Evidence/ChosenPrice'], formatter: '.formatPriceRange'}"
													class="qdCellHint"
												/>
												<ObjectStatus
													text="{parts: ['Evidence/ChosenIsLowest','Evidence/ExtraVsLowest','Evidence/SingleQuote'], formatter: '.formatPriceVerdict'}"
													state="{parts: ['Evidence/ChosenIsLowest','Evidence/ExtraVsLowest','Evidence/SingleQuote'], formatter: '.formatPriceVerdictState'}"
													class="sapUiTinyMarginTop"
												/>
												<!-- 2 dong tach rieng thay vi in nguyen chuoi thô
												     "[SOLE SOURCE] ... | ..." — xem _splitAwardReason. -->
												<Text
													text="{path: 'AwardReason', formatter: '.formatSoleSourceReason'}"
													visible="{path: 'AwardReason', formatter: '.hasSoleSourceReason'}"
													class="qdCellHint sapUiTinyMarginTop"
												/>
												<Text
													text="{path: 'AwardReason', formatter: '.formatAwardReason'}"
													class="qdCellHint sapUiTinyMarginTop"
												/>
												<Text
													text="{parts: ['Evidence/LegalDocsOk','Evidence/PaymentTerms','Evidence/LeadTimeDays','Evidence/WarrantyMonths'], formatter: '.formatVendorTerms'}"
													class="qdCellHint"
												/>
											</VBox>

											<!-- Nhom khong di qua RFQ: noi thang la khong co bang chung so sanh -->
											<MessageStrip
												text="Nhóm này không đi qua vòng hỏi giá nên không có báo giá để so sánh — cần hỏi rõ Phòng Mua sắm trước khi duyệt."
												type="Warning"
												showIcon="true"
												visible="{= !${Evidence} }"
												class="sapUiTinyMarginTop"
											/>
										</VBox>
									</CustomListItem>
								</List>
							</VBox>

							<HBox justifyContent="End" alignItems="Center" class="qdRowActions sapUiSmallMarginTop">
								<Button
									text="Chi tiết đề nghị"
									type="Transparent"
									icon="sap-icon://detail-view"
									press=".onDetailPress"
									class="sapUiSmallMarginEnd"
								/>
								<Button
									text="Từ chối"
									type="Reject"
									icon="sap-icon://decline"
									press=".onRejectPress"
									class="sapUiSmallMarginEnd"
								/>
								<Button
									text="Duyệt đề nghị"
									type="Accept"
									icon="sap-icon://accept"
									press=".onApprovePress"
								/>
							</HBox>

						</VBox>
					</CustomListItem>
				</List>
				</ScrollContainer>
			</VBox>

		</content>
	</Page>
</mvc:View>
