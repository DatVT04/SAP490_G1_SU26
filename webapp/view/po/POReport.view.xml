<mvc:View
    controllerName="com.qdavy.procurement.controller.po.POReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="pagePOReport" showHeader="false" class="sapUiContentPadding dashboardPage">
        
        <!-- Header Toolbar -->
        <OverflowToolbar id="headerToolbar" class="sapUiMediumMarginBottom customHeader">
            <Button id="btnBack" icon="sap-icon://nav-back" type="Transparent" press="onNavBack" />
            <VBox id="headerTitleVBox">
                <Title id="txtHeaderTitle" text="Theo dõi tiến độ đơn mua hàng (PO)" level="H2" class="dashboardTitle" />
                <Text id="txtHeaderSub" text="Tổng quan tình hình xử lý PO trong hệ thống SAP S/4HANA" class="dashboardSubTitle" />
            </VBox>
            <ToolbarSpacer id="headerSpacer" />
            <DateRangeSelection id="headerDateRange" value="01/07/2026 - 31/07/2026" displayFormat="dd/MM/yyyy" width="220px" />
            <Button id="btnExport" text="Xuất Excel" icon="sap-icon://excel-attachment" type="Default" press="onExportExcel" />
            <Button id="btnRefresh" text="Làm mới" icon="sap-icon://refresh" type="Default" press="onRefresh" />
            <Button id="btnNotification" icon="sap-icon://bell" type="Transparent" />
            <Avatar id="userAvatar" initials="N" displaySize="S" class="sapUiTinyMarginBegin" />
            <Text id="txtUserLabel" text="Người đề nghị" class="sapUiTinyMarginBegin" />
        </OverflowToolbar>

        <VBox id="mainContainer" class="sapUiSmallMarginBottom">
            
            <!-- SECTION 1: Status Tiles (6 ô chỉ số) -->
            <l:Grid id="kpiGrid" defaultSpan="XL2 L2 M4 S6" class="sapUiSmallMarginBottom">
                <GenericTile id="tileTotal" class="kpiTile tileBlue" header="Tổng số PO" subheader="Tất cả PO">
                    <TileContent id="tcTotal">
                        <NumericContent id="ncTotal" value="125" icon="sap-icon://document" />
                    </TileContent>
                </GenericTile>

                <GenericTile id="tilePending" class="kpiTile tileOrange" header="Chờ duyệt" subheader="14.4%">
                    <TileContent id="tcPending">
                        <NumericContent id="ncPending" value="18" icon="sap-icon://history" valueColor="Critical" />
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileProcessing" class="kpiTile tileProcessing" header="Đang xử lý" subheader="28.8%">
                    <TileContent id="tcProcessing">
                        <NumericContent id="ncProcessing" value="36" icon="sap-icon://sync" />
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileWaiting" class="kpiTile tilePurple" header="Chờ nhập kho" subheader="11.2%">
                    <TileContent id="tcWaiting">
                        <NumericContent id="ncWaiting" value="14" icon="sap-icon://shipping-status" />
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileCompleted" class="kpiTile tileGreen" header="Đã hoàn tất" subheader="71.2%">
                    <TileContent id="tcCompleted">
                        <NumericContent id="ncCompleted" value="89" icon="sap-icon://accept" valueColor="Good" />
                    </TileContent>
                </GenericTile>

                <GenericTile id="tileOverdue" class="kpiTile tileRed" header="Quá hạn" subheader="4.0%">
                    <TileContent id="tcOverdue">
                        <NumericContent id="ncOverdue" value="5" icon="sap-icon://alert" valueColor="Error" />
                    </TileContent>
                </GenericTile>
            </l:Grid>

            <!-- SECTION 2: Urgent Alert Cards (3 ô cảnh báo màu) -->
            <l:Grid id="alertGrid" defaultSpan="XL4 L4 M4 S12" class="sapUiSmallMarginBottom">
                <HBox id="boxAlertRed" class="alertBox alertBoxRed" alignItems="Center">
                    <Avatar id="avRed" src="sap-icon://clock" class="alertAvatarRed" />
                    <VBox id="vboxAlert1" class="sapUiSmallMarginBegin">
                        <HBox id="hboxA1" alignItems="Baseline">
                            <Text id="txtTitleRed" text="Quá hạn" class="alertTitleRed" />
                            <Title id="txtNumRed" text="5 PO" level="H4" class="sapUiTinyMarginBegin alertNumRed" />
                        </HBox>
                        <Text id="txtSubRed" text="Cần xử lý ngay" class="alertSub" />
                    </VBox>
                </HBox>

                <HBox id="boxAlertOrange" class="alertBox alertBoxOrange" alignItems="Center">
                    <Avatar id="avOrange" src="sap-icon://incoming-call" class="alertAvatarOrange" />
                    <VBox id="vboxAlert2" class="sapUiSmallMarginBegin">
                        <HBox id="hboxA2" alignItems="Baseline">
                            <Text id="txtTitleOrange" text="Sắp quá hạn (1-3 ngày)" class="alertTitleOrange" />
                            <Title id="txtNumOrange" text="8 PO" level="H4" class="sapUiTinyMarginBegin alertNumOrange" />
                        </HBox>
                        <Text id="txtSubOrange" text="Cần theo dõi" class="alertSub" />
                    </VBox>
                </HBox>

                <HBox id="boxAlertGreen" class="alertBox alertBoxGreen" alignItems="Center">
                    <Avatar id="avGreen" src="sap-icon://accept" class="alertAvatarGreen" />
                    <VBox id="vboxAlert3" class="sapUiSmallMarginBegin">
                        <HBox id="hboxA3" alignItems="Baseline">
                            <Text id="txtTitleGreen" text="Cần duyệt hôm nay" class="alertTitleGreen" />
                            <Title id="txtNumGreen" text="7 PO" level="H4" class="sapUiTinyMarginBegin alertNumGreen" />
                        </HBox>
                        <Text id="txtSubGreen" text="Ưu tiên xử lý" class="alertSub" />
                    </VBox>
                </HBox>
            </l:Grid>

            <!-- SECTION 3: Charts Section -->
            <l:Grid id="chartsGrid" defaultSpan="XL4 L4 M12 S12" class="sapUiSmallMarginBottom">
                
                <!-- Chart 1: Donut Chart -->
                <Panel id="panelChart1" headerText="PO theo trạng thái" class="chartPanel">
                    <VBox id="vboxChart1" height="260px">
                        <viz:VizFrame id="vizDonut" vizType="donut" width="100%" height="100%">
                            <viz:dataset>
                                <viz.data:FlattenedDataset id="dsDonut" data="{/StatusChartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition id="dimStatus" name="Trạng thái" value="{status}" />
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition id="measStatus" name="Số lượng" value="{count}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem id="feedDonutSize" uid="size" type="Measure" values="Số lượng" />
                                <viz.feeds:FeedItem id="feedDonutColor" uid="color" type="Dimension" values="Trạng thái" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                </Panel>

                <!-- Chart 2: Stacked Column Chart -->
                <Panel id="panelChart2" headerText="Số lượng PO theo tháng" class="chartPanel">
                    <VBox id="vboxChart2" height="260px">
                        <viz:VizFrame id="vizStacked" vizType="stacked_column" width="100%" height="100%">
                            <viz:dataset>
                                <viz.data:FlattenedDataset id="dsStacked" data="{/MonthlyChartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition id="dimMonth" name="Tháng" value="{month}" />
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition id="measCreated" name="PO tạo" value="{created}" />
                                        <viz.data:MeasureDefinition id="measCompleted" name="PO hoàn tất" value="{completed}" />
                                        <viz.data:MeasureDefinition id="measOverdue" name="PO quá hạn" value="{overdue}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem id="feedStackedValue" uid="valueAxis" type="Measure" values="PO tạo,PO hoàn tất,PO quá hạn" />
                                <viz.feeds:FeedItem id="feedStackedCategory" uid="categoryAxis" type="Dimension" values="Tháng" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                </Panel>

                <!-- Chart 3: Bar Chart -->
                <Panel id="panelChart3" headerText="Top nhà cung cấp theo tỷ lệ giao đúng hạn" class="chartPanel">
                    <VBox id="vboxChart3" height="260px">
                        <viz:VizFrame id="vizBar" vizType="bar" width="100%" height="100%">
                            <viz:dataset>
                                <viz.data:FlattenedDataset id="dsBar" data="{/VendorChartData}">
                                    <viz.data:dimensions>
                                        <viz.data:DimensionDefinition id="dimVendor" name="Nhà cung cấp" value="{vendor}" />
                                    </viz.data:dimensions>
                                    <viz.data:measures>
                                        <viz.data:MeasureDefinition id="measOnTime" name="Tỷ lệ đúng hạn (%)" value="{rate}" />
                                    </viz.data:measures>
                                </viz.data:FlattenedDataset>
                            </viz:dataset>
                            <viz:feeds>
                                <viz.feeds:FeedItem id="feedBarValue" uid="valueAxis" type="Measure" values="Tỷ lệ đúng hạn (%)" />
                                <viz.feeds:FeedItem id="feedBarCategory" uid="categoryAxis" type="Dimension" values="Nhà cung cấp" />
                            </viz:feeds>
                        </viz:VizFrame>
                    </VBox>
                </Panel>
            </l:Grid>

            <!-- SECTION 4: Filter Bar -->
            <Panel id="panelFilter" class="sapUiTinyMarginBottom customFilterPanel">
                <l:Grid id="filterGrid" defaultSpan="XL2 L2 M4 S12">
                    <VBox id="vf1">
                        <Label id="lblStatus" text="Trạng thái" />
                        <Select id="selStatus" selectedKey="ALL" width="100%">
                            <core:Item id="iStatusAll" key="ALL" text="Tất cả trạng thái" />
                            <core:Item id="iStatus1" key="PENDING" text="Chờ duyệt" />
                            <core:Item id="iStatus2" key="PROCESSING" text="Đang xử lý" />
                            <core:Item id="iStatus3" key="WAITING" text="Chờ nhập kho" />
                            <core:Item id="iStatus4" key="COMPLETED" text="Đã hoàn tất" />
                            <core:Item id="iStatus5" key="OVERDUE" text="Quá hạn" />
                        </Select>
                    </VBox>

                    <VBox id="vf2">
                        <Label id="lblTime" text="Khoảng thời gian" />
                        <DateRangeSelection id="filterDateRange" value="01/07/2026 - 31/07/2026" displayFormat="dd/MM/yyyy" width="100%" />
                    </VBox>

                    <VBox id="vf3">
                        <Label id="lblCompany" text="Công ty" />
                        <Select id="selCompany" selectedKey="ALL" width="100%">
                            <core:Item id="iCompAll" key="ALL" text="Tất cả công ty" />
                            <core:Item id="iComp1" key="DV01" text="DV01" />
                        </Select>
                    </VBox>

                    <VBox id="vf4">
                        <Label id="lblVendor" text="Nhà cung cấp" />
                        <Select id="selVendor" selectedKey="ALL" width="100%">
                            <core:Item id="iVendAll" key="ALL" text="Tất cả nhà cung cấp" />
                        </Select>
                    </VBox>

                    <VBox id="vf5">
                        <Label id="lblRequester" text="Người đề nghị" />
                        <Select id="selRequester" selectedKey="ALL" width="100%">
                            <core:Item id="iReqAll" key="ALL" text="Chọn người đề nghị" />
                        </Select>
                    </VBox>

                    <VBox id="vf6">
                        <Label id="lblSearch" text=" " />
                        <HBox id="hbSearch">
                            <SearchField id="searchPO" placeholder="Tìm kiếm PO, người đề nghị..." search="onSearch" width="100%" />
                            <Button id="btnFilter" icon="sap-icon://filter" text="Bộ lọc" type="Emphasized" press="onApplyFilter" class="sapUiTinyMarginBegin" />
                        </HBox>
                    </VBox>
                </l:Grid>
            </Panel>

            <!-- SECTION 5: PO Table -->
            <Panel id="panelTable" headerText="Danh sách đơn mua hàng" class="tablePanel">
                <!-- 36 PO va con tang — cuon trong khung co dinh, header dinh khi cuon. -->
                <ScrollContainer height="28rem" width="100%" vertical="true" horizontal="false" focusable="false">
                <Table id="poTable" items="{/PurchaseOrders}" growing="true" growingThreshold="15" growingScrollToLoad="true" sticky="ColumnHeaders">
                    <columns>
                        <Column id="colCode"><Text text="Mã PO (SAP)" /></Column>
                        <Column id="colVendor"><Text text="Nhà cung cấp" /></Column>
                        <Column id="colRequester"><Text text="Người đề nghị" /></Column>
                        <Column id="colCompany"><Text text="Công ty" /></Column>
                        <Column id="colCreatedDate"><Text text="Ngày tạo" /></Column>
                        <Column id="colExpectedDate"><Text text="Ngày giao dự kiến" /></Column>
                        <Column id="colDaysLeft"><Text text="Số ngày còn lại" /></Column>
                        <Column id="colProgress" width="150px"><Text text="Tiến độ" /></Column>
                        <Column id="colStatus"><Text text="Trạng thái" /></Column>
                        <Column id="colAction" hAlign="End"><Text text="Thao tác" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="cliPO">
                            <cells>
                                <ObjectIdentifier id="txtPOCode" title="{poCode}" />
                                <Text id="txtVendorName" text="{vendorName}" />
                                <Text id="txtRequesterMail" text="{requester}" />
                                <Text id="txtCompanyCode" text="{company}" />
                                <Text id="txtCreated" text="{createdDate}" />
                                <Text id="txtExpected" text="{expectedDate}" />
                                <ObjectStatus id="statusDays" text="{daysLeftText}" state="{path: 'daysLeft', formatter: '.formatDaysState'}" />
                                <ProgressIndicator id="piProgress" percentValue="{progress}" displayValue="{progress}%" state="None" height="12px" />
                                <ObjectStatus id="statusTag" text="{statusText}" state="{path: 'statusCode', formatter: '.formatStatusState'}" />
                                <HBox id="hboxActions" justifyContent="End">
                                    <Button id="btnView" icon="sap-icon://show" type="Transparent" press="onViewDetail" />
                                    <Button id="btnEdit" icon="sap-icon://edit" type="Transparent" press="onEditPO" />
                                    <Button id="btnMore" icon="sap-icon://overflow" type="Transparent" press="onMoreAction" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                </ScrollContainer>
            </Panel>

        </VBox>
    </Page>
</mvc:View>