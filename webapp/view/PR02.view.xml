<mvc:View
	controllerName="com.qdavy.procurement.controller.PR02"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroAmber">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="Bước 2 · Phê duyệt" class="qdPageEyebrow"/>
							<Title text="{i18n>tilePr02Title}" level="H1" class="qdPageTitle"/>
							<Text text="Xem xét và quyết định các đề nghị mua sắm đang chờ" class="qdPageSub"/>
						</VBox>
					</HBox>
					<Button
						icon="sap-icon://refresh"
						text="{i18n>pr02RefreshButton}"
						press=".onRefreshPress"
						class="qdHeroBtn"
					/>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ DANH SACH PR CHO DUYET ============ -->
			<VBox class="qdContentCard qdCardTight">

				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://pending" class="qdCardIcon"/>
					<Title text="Đề nghị đang chờ quyết định" level="H3" class="qdCardTitle"/>
				</HBox>

				<Table
					id="pendingTable"
					items="{/pending}"
					noDataText="{i18n>pr02EmptyText}"
					class="qdApprovalTable"
				>
					<columns>
						<Column width="11rem"><Text text="{i18n>pr02ColPRId}"/></Column>
						<Column width="12rem"><Text text="{i18n>pr02ColRequester}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Danh sách vật tư"/></Column>
						<Column hAlign="End" width="11rem"><Text text="{i18n>pr02ColValue}"/></Column>
						<Column width="10rem" minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>pr02ColEscalation}"/></Column>
						<Column width="13rem"/>
					</columns>
					<items>
						<ColumnListItem vAlign="Top">
							<cells>

								<!-- Ma PR + ngay tao -->
								<VBox>
									<ObjectIdentifier title="{PRId}"/>
									<Text text="{CreatedAt}" class="qdCellHint sapUiTinyMarginTop"/>
								</VBox>

								<!-- Nguoi de nghi -->
								<VBox>
									<Text text="{RequesterEmail}"/>
								</VBox>

								<!-- Danh sach vat tu (items[]) -->
								<List
									items="{items}"
									showNoData="false"
									showSeparators="Inner"
									class="qdNestedItemList"
								>
									<items>
										<CustomListItem>
											<HBox alignItems="Center" class="qdNestedItemRow">
												<Text text="{LineNo}" class="qdLineNo"/>
												<VBox class="qdNestedItemMain">
													<Text text="{Description}" wrapping="false"/>
													<Text text="{MaterialNo}" class="qdCellHint"/>
												</VBox>
												<VBox class="qdNestedItemSide">
													<Text text="{Quantity} {UoM}" class="qdNestedQty"/>
													<Text
														text="{= ${MaterialType} === 'ZAST' ? ('Asset: ' + ${AssetNo}) : ('CC: ' + ${CostCenter}) }"
														class="qdCellHint"
													/>
												</VBox>
											</HBox>
										</CustomListItem>
									</items>
								</List>

								<!-- Tong gia tri -->
								<VBox alignItems="End">
									<Text text="{parts: ['TotalValue','Currency'], formatter: '.formatValue'}" class="qdRowAmount"/>
								</VBox>

								<!-- Leo thang phe duyet -->
								<VBox>
									<ObjectStatus
										text="{i18n>pr02FlagLegal}"
										state="Warning"
										visible="{needsLegalReview}"
										icon="sap-icon://alert"
										class="qdBadgeWarning"
									/>
									<ObjectStatus
										text="{i18n>pr02FlagPams}"
										state="Error"
										visible="{needsProcurementHeadReview}"
										icon="sap-icon://alert"
										class="qdBadgeDanger"
									/>
									<Text
										text="Trong ngưỡng thường"
										class="qdCellHint"
										visible="{= !${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
									/>
								</VBox>

								<!-- Nut quyet dinh -->
								<HBox class="qdRowActions">
									<Button
										text="{i18n>pr02Approve}"
										type="Accept"
										icon="sap-icon://accept"
										press=".onApprovePress"
										class="sapUiTinyMarginEnd"
									/>
									<Button
										text="{i18n>pr02Reject}"
										type="Reject"
										icon="sap-icon://decline"
										press=".onRejectPress"
									/>
								</HBox>

							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>

		</content>
	</Page>
</mvc:View>
