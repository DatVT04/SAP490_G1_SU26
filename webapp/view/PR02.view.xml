<mvc:View
	controllerName="com.qdavy.procurement.controller.PR02"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroAmber">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="Bước 2 · Phê duyệt" class="qdPageEyebrow"/>
							<Title text="Phê duyệt đề nghị mua sắm" level="H1" class="qdPageTitle"/>
							<Text text="Xem xét và quyết định các đề nghị đang chờ — Approve hoặc Reject kèm ghi chú" class="qdPageSub"/>
						</VBox>
					</HBox>
					<Button
						icon="sap-icon://refresh"
						text="Tải lại"
						press=".onRefreshPress"
						class="qdHeroBtn"
					/>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ THONG KE NHANH ============ -->
			<HBox class="qdStatRow" wrap="Wrap">
				<VBox class="qdStatCard">
					<Text text="{path: '/pending', formatter: '.getPendingCount'}" class="qdStatNumber"/>
					<Text text="Đang chờ duyệt" class="qdStatLabel"/>
				</VBox>
				<VBox class="qdStatCard qdStatCardWarn">
					<Text text="{path: '/pending', formatter: '.getProcurementHeadReviewCount'}" class="qdStatNumber"/>
					<Text text="Leo thang CEO" class="qdStatLabel"/>
				</VBox>
				<VBox class="qdStatCard qdStatCardInfo">
					<Text text="{path: '/pending', formatter: '.getLegalReviewCount'}" class="qdStatNumber"/>
					<Text text="Cần xem xét kỹ" class="qdStatLabel"/>
				</VBox>
			</HBox>

			<!-- ============ DANH SACH PR CHO DUYET ============ -->
			<VBox class="qdContentCard qdCardTight">
				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://pending" class="qdCardIcon sapUiTinyMarginEnd"/>
					<Title text="Đề nghị đang chờ quyết định ({path: '/pending', formatter: '.getPendingCount'})" level="H3" class="qdCardTitle"/>
				</HBox>

				<!-- Empty state -->
				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${/pending}.length === 0 }"
				>
					<core:Icon src="sap-icon://complete" class="qdEmptyIcon"/>
					<Title text="Không có đề nghị nào đang chờ" level="H3" class="qdEmptyTitle"/>
					<Text text="Tất cả đề nghị mua sắm đã được xử lý. Bấm Tải lại để cập nhật danh sách." class="qdEmptyText" textAlign="Center"/>
				</VBox>

				<!-- Danh sach PR - moi PR la 1 card rieng biet -->
				<List
					id="pendingList"
					items="{/pending}"
					mode="None"
					showSeparators="None"
					visible="{= ${/pending}.length > 0 }"
					class="qdApprovalList"
				>
					<CustomListItem>
						<VBox class="qdApprovalCard">

							<!-- ── HEADER ROW: ma PR + trang thai leo thang ── -->
							<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="qdApprovalCardHeader">
								<HBox alignItems="Center">
									<core:Icon src="sap-icon://request" class="qdPRIcon sapUiTinyMarginEnd"/>
									<VBox>
										<ObjectIdentifier title="{PRId}" text="Người đề nghị: {RequesterEmail}"/>
										<Text text="Gửi lúc: {CreatedAt}" class="qdCellHint sapUiTinyMarginTop"/>
									</VBox>
								</HBox>

								<!-- Leo thang badges -->
								<HBox wrap="Wrap" alignItems="Center">
									<ObjectStatus
										text="Cần CEO phê duyệt"
										state="Error"
										visible="{needsProcurementHeadReview}"
										icon="sap-icon://alert"
										class="qdBadgeDanger sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Giá trị lớn — xem kỹ"
										state="Warning"
										visible="{= ${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://warning"
										class="qdBadgeWarning sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Trong ngưỡng thường"
										state="Success"
										visible="{= !${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://accept"
										class="qdBadgeOk"
									/>
								</HBox>
							</HBox>

							<!-- ── TONG GIA TRI ── -->
							<HBox class="qdApprovalValueRow sapUiTinyMarginTopBottom" alignItems="Baseline">
								<Text text="Tổng giá trị: " class="qdInfoLabel"/>
								<Title
									text="{parts: ['TotalValue','Currency'], formatter: '.formatValue'}"
									level="H3"
									class="qdRowAmount sapUiTinyMarginBegin"
								/>
							</HBox>

							<!-- ── DANH SACH VAT TU (items[]) ── -->
							<VBox class="qdNestedItems">
								<Text text="Danh sách vật tư:" class="qdInfoLabel sapUiTinyMarginBottom"/>
								<List
									items="{items}"
									showNoData="false"
									showSeparators="Inner"
									class="qdNestedItemList"
								>
									<items>
										<CustomListItem>
											<HBox alignItems="Center" class="qdNestedItemRow" wrap="Wrap">
												<!-- So thu tu dong -->
												<Text text="{LineNo}." class="qdLineNo"/>

												<!-- Ma + mo ta vat tu -->
												<VBox class="qdNestedItemMain">
													<Text text="{Description}" class="qdNestedItemDesc" wrapping="false"/>
													<HBox>
														<Text text="{MaterialNo}" class="qdCellHint"/>
														<Text
															text="{= ${MaterialType} === 'ZAST' ? ' · Tài sản (Cat.A)' : ' · Vật tư/DV (Cat.K)' }"
															class="qdCellHint"
														/>
													</HBox>
												</VBox>

												<!-- So luong + DVT -->
												<VBox class="qdNestedItemSide" alignItems="End">
													<Text text="{Quantity} {UoM}" class="qdNestedQty"/>
													<!-- Hach toan: ZAST -> Asset No, con lai -> Cost Center -->
													<Text
														text="{= ${MaterialType} === 'ZAST' ? ('Asset: ' + (${AssetNo} || 'chưa điền')) : ('CC: ' + (${CostCenter} || ${InternalOrder} || 'chưa điền')) }"
														class="qdCellHint"
													/>
													<!-- Gia tri uoc tinh -->
													<Text
														text="{parts: ['EstimatedValue','Currency'], formatter: '.formatValue'}"
														class="qdNestedValue"
													/>
												</VBox>
											</HBox>
										</CustomListItem>
									</items>
								</List>
							</VBox>

							<!-- ── GHI CHU TU LAN DUYET TRUOC (neu co) ── -->
							<VBox
								class="qdPrevComment sapUiTinyMarginTop"
								visible="{= !!${Comments} }"
							>
								<Text text="Ghi chú trước đó:" class="qdInfoLabel"/>
								<Text text="{Comments}" class="qdCommentText"/>
							</VBox>

							<!-- ── NUT QUYET DINH ── -->
							<HBox justifyContent="End" alignItems="Center" class="qdRowActions sapUiSmallMarginTop">
								<Button
									text="Từ chối"
									type="Reject"
									icon="sap-icon://decline"
									press=".onRejectPress"
									class="sapUiSmallMarginEnd"
								/>
								<Button
									text="Phê duyệt"
									type="Accept"
									icon="sap-icon://accept"
									press=".onApprovePress"
								/>
							</HBox>

						</VBox>
					</CustomListItem>
				</List>
			</VBox>

		</content>
	</Page>
</mvc:View>