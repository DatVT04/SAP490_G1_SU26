<mvc:View
	controllerName="com.qdavy.procurement.controller.PR01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroBlue">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 1 · Đề nghị mua sắm" class="qdPageEyebrow"/>
						<Title text="{i18n>tilePr01Title}" level="H1" class="qdPageTitle"/>
						<Text text="Khai báo vật tư cần mua, hệ thống sẽ tạo Purchase Requisition trong SAP" class="qdPageSub"/>
					</VBox>
				</HBox>
				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ THÔNG TIN CHUNG ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<Text text="1" class="qdStepBadge"/>
					<Title text="Thông tin chung" level="H3" class="qdCardTitle"/>
				</HBox>
				<HBox wrap="Wrap" class="qdInfoRow">
					<VBox class="qdInfoCell">
						<Label text="{i18n>prRequesterLabel}" class="qdInfoLabel"/>
						<Text text="{user>/fullName}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Email" class="qdInfoLabel"/>
						<Text text="{user>/email}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Vai trò" class="qdInfoLabel"/>
						<Text text="{user>/role}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Tiền tệ" class="qdInfoLabel"/>
						<Text text="{/header/currency}" class="qdInfoValue"/>
					</VBox>
				</HBox>
			</VBox>

			<!-- ============ DANH SÁCH VẬT TƯ ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom" wrap="Wrap">
					<HBox alignItems="Center">
						<Text text="2" class="qdStepBadge"/>
						<Title text="Danh sách vật tư" level="H3" class="qdCardTitle"/>
					</HBox>
					<Button text="Thêm dòng" icon="sap-icon://add" type="Emphasized" press=".onAddItem"/>
				</HBox>

				<!-- Header cố định + cuộn khi nhiều dòng -->
				<ScrollContainer
					height="22rem"
					width="100%"
					horizontal="true"
					vertical="true"
					focusable="true"
				>
					<Table
						id="prItemsTable"
						items="{/items}"
						mode="None"
						sticky="ColumnHeaders"
						class="qdItemsTable"
						noDataText="Chưa có dòng vật tư"
					>
						<columns>
							<Column minWidth="140" width="14%">
								<Text text="Vật tư"/>
							</Column>
							<Column minWidth="120" width="14%">
								<Text text="Mô tả"/>
							</Column>
							<Column width="4rem" hAlign="Center">
								<Text text="ĐVT"/>
							</Column>
							<Column width="5.5rem" hAlign="End">
								<Text text="Số lượng"/>
							</Column>
							<Column width="7rem" hAlign="End">
								<Text text="Đơn giá"/>
							</Column>
							<Column minWidth="130" width="14%">
								<Text text="Phòng ban"/>
							</Column>
							<Column minWidth="140" width="16%">
								<Text text="Internal Order"/>
							</Column>
							<Column minWidth="90" width="10%">
								<Text text="Asset No"/>
							</Column>
							<Column width="2.75rem" hAlign="Center">
								<Text text=""/>
							</Column>
						</columns>

						<items>
							<ColumnListItem>
								<cells>
									<!-- Vật tư -->
									<ComboBox
										selectedKey="{materialNo}"
										selectionChange=".onMaterialChange"
										items="{/materials}"
										showSecondaryValues="true"
										width="100%"
										placeholder="Chọn vật tư"
										enabled="{= !${/materialsLoading} }"
									>
										<core:ListItem
											key="{MaterialNo}"
											text="{MaterialNo}"
											additionalText="{Description}"
										/>
									</ComboBox>

									<!-- Mô tả -->
									<Input value="{description}" liveChange=".onItemValueChange" width="100%"/>

									<!-- ĐVT -->
									<Text text="{uom}" textAlign="Center"/>

									<!-- Số lượng -->
<Input
	value="{quantity}"
	type="Number"
	valueLiveUpdate="true"
	liveChange=".onItemValueChange"
	change=".onItemValueChange"
	textAlign="End"
	width="100%"
/>

<!-- Đơn giá -->
<Input
	value="{estimatedValue}"
	type="Number"
	valueLiveUpdate="true"
	liveChange=".onItemValueChange"
	change=".onItemValueChange"
	textAlign="End"
	width="100%"
/>

									<!-- Phòng ban: hiện tên (VN từ controller), key = mã CC -->
									<Select
										selectedKey="{costCenter}"
										change=".onCostCenterSelect"
										items="{/costCenters}"
										forceSelection="false"
										width="100%"
										visible="{= ${materialType} !== 'ZAST' }"
										enabled="{= ${materialType} !== 'ZAST' }"
									>
										<core:Item
											key="{CostCenter}"
											text="{= ${Description} ? ${Description} : ${CostCenter} }"
										/>
									</Select>

									<!-- Internal Order: theo CC -->
									<Select
										selectedKey="{internalOrder}"
										change=".onInternalOrderSelect"
										items="{filteredInternalOrders}"
										forceSelection="false"
										width="100%"
										visible="{= ${materialType} !== 'ZAST' }"
										enabled="{= ${materialType} !== 'ZAST' }"
									>
										<core:Item
											key="{InternalOrder}"
											text="{= ${Description} ? (${Description} + ' (' + ${InternalOrder} + ')') : ${InternalOrder} }"
										/>
									</Select>

									<!-- Asset — chỉ ZAST -->
									<Input
										value="{assetNo}"
										width="100%"
										visible="{= ${materialType} === 'ZAST' }"
										enabled="{= ${materialType} === 'ZAST' }"
										placeholder="Asset No"
									/>

									<!-- Xóa -->
									<Button
										icon="sap-icon://delete"
										type="Transparent"
										press=".onDeleteItem"
										tooltip="Xóa dòng"
									/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</ScrollContainer>

				<HBox
					class="qdTotalBar"
					justifyContent="SpaceBetween"
					alignItems="Center"
					visible="{= ${/items}.length > 0 }"
				>
					<VBox>
						<Text text="Tổng giá trị đề nghị" class="qdTotalLabel"/>
						<Text text="{= ${/items}.length } dòng vật tư" class="qdInfoHint"/>
					</VBox>
					<HBox alignItems="Baseline">
						<Title text="{/totalText}" level="H2" class="qdTotalValue"/>
						<Text text="{/header/currency}" class="sapUiTinyMarginBegin qdTotalLabel"/>
					</HBox>
				</HBox>

				<MessageStrip
					text="{/escalationText}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginTop"
					visible="{= !!${/escalationText} }"
				/>
			</VBox>

		</content>

		<footer>
			<OverflowToolbar class="qdPageFooter">
				<Text
					text="{= ${/items}.length === 0 ? 'Thêm ít nhất 1 vật tư để gửi đề nghị' : 'Sẵn sàng gửi ' + ${/items}.length + ' dòng vật tư' }"
					class="qdFooterHint"
				/>
				<ToolbarSpacer/>
				<Button
					text="{i18n>prResetButton}"
					icon="sap-icon://clear-all"
					press=".onResetPress"
					enabled="{= ${/items}.length > 0 }"
				/>
				<Button
					text="{i18n>prSubmitButton}"
					type="Emphasized"
					icon="sap-icon://paper-plane"
					press=".onSubmitPress"
					enabled="{= ${/items}.length > 0 }"
				/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>