<mvc:View
	controllerName="com.qdavy.procurement.controller.PR01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroBlue">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 1 · Đề nghị mua sắm" class="qdPageEyebrow"/>
						<Title text="{i18n>tilePr01Title}" level="H1" class="qdPageTitle"/>
						<Text text="Khai báo vật tư cần mua, hệ thống sẽ tạo Purchase Requisition trong SAP" class="qdPageSub"/>
					</VBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ THONG TIN CHUNG ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<Text text="1" class="qdStepBadge"/>
					<Title text="Thông tin chung" level="H3" class="qdCardTitle"/>
				</HBox>

				<HBox wrap="Wrap" class="qdInfoRow">
					<VBox class="qdInfoCell">
						<Label text="{i18n>prRequesterLabel}" class="qdInfoLabel"/>
						<Text text="{user>/fullName}" class="qdInfoValue"/>
						<Text text="{user>/email}" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Bộ phận / Vị trí" class="qdInfoLabel"/>
						<Text text="{user>/position}" class="qdInfoValue"/>
						<Text text="{= ${user>/costCenter} ? 'Cost Center: ' + ${user>/costCenter} : 'Chưa gán Cost Center' }" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="{i18n>prCurrencyLabel}" class="qdInfoLabel"/>
						<Select selectedKey="{/header/currency}" width="9rem" class="sapUiTinyMarginTop">
							<core:Item key="VND" text="VND"/>
							<core:Item key="USD" text="USD"/>
						</Select>
					</VBox>
				</HBox>
			</VBox>

			<!-- ============ DANH SACH VAT TU ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
					<HBox alignItems="Center">
						<Text text="2" class="qdStepBadge"/>
						<Title text="Danh sách vật tư ({= ${/items}.length })" level="H3" class="qdCardTitle"/>
					</HBox>
					<Button
						text="Thêm dòng"
						icon="sap-icon://add"
						type="Emphasized"
						press=".onAddItem"
						enabled="{= !${/materialsLoading} }"
					/>
				</HBox>

				<!-- ScrollContainer: header cột dính trong vùng cuộn này -->
				<ScrollContainer
					height="22rem"
					width="100%"
					vertical="true"
					horizontal="true"
					focusable="false"
					class="qdItemsScroll"
				>
					<Table
						id="itemsTable"
						items="{/items}"
						mode="None"
						growing="false"
						fixedLayout="true"
						sticky="ColumnHeaders"
						class="qdItemsTable"
						noDataText="Chưa có dòng vật tư"
					>
						<columns>
							<Column width="13rem"><Text text="Vật tư"/></Column>
							<Column width="11rem"><Text text="Mô tả *"/></Column>
							<Column width="4.5rem"><Text text="ĐVT"/></Column>
							<Column width="5.5rem" hAlign="End"><Text text="Số lượng"/></Column>
							<!-- Đây là ĐƠN GIÁ, không phải thành tiền: lineTotal = quantity × estimatedValue.
							     Ghi "Giá trị ước tính" khiến người nhập tưởng phải gõ thành tiền → PR sai gấp n lần. -->
							<Column width="7.5rem" hAlign="End"><Text text="Đơn giá *"/></Column>
							<Column width="9rem"><Text text="Đối tượng chi phí *"/></Column>
							<Column width="9rem"><Text text="Cost Center"/></Column>
							<Column width="9rem"><Text text="Internal Order"/></Column>
							<Column width="7rem"><Text text="Asset"/></Column>
							<Column width="3rem" hAlign="Center"><Text text=""/></Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<!-- Mã và mô tả tách 2 cột (additionalText) thay vì dồn 1 chuỗi
									     "MAT001 - Mô tả": gõ tìm theo mô tả vẫn ra đúng dòng. -->
									<ComboBox
										selectedKey="{materialNo}"
										items="{path: '/materials', templateShareable: false}"
										selectionChange=".onMaterialChange"
										placeholder="— Chọn —"
										showSecondaryValues="true"
										width="100%"
									>
										<core:ListItem
											key="{MaterialNo}"
											text="{MaterialNo}"
											additionalText="{Description}"
										/>
									</ComboBox>

									<Input value="{description}" width="100%"/>

									<!-- ĐVT lấy từ material master (BaseUoM), không cho sửa tay:
									     gõ sai đơn vị là SAP từ chối cả PR. -->
									<Text text="{uom}"/>

									<!-- valueLiveUpdate: tổng tiền chạy ngay khi gõ, không phải click ra ngoài.
									     _recalcTotal() đọc từ model nên bắt buộc phải có thuộc tính này. -->
									<Input
										value="{quantity}"
										type="Number"
										textAlign="End"
										valueLiveUpdate="true"
										liveChange=".onItemValueChange"
										change=".onItemValueChange"
										width="100%"
									/>

									<Input
										value="{estimatedValue}"
										type="Number"
										textAlign="End"
										valueLiveUpdate="true"
										liveChange=".onItemValueChange"
										change=".onItemValueChange"
										width="100%"
									/>

									<VBox>
										<!-- ZAST → account assignment luôn là Asset (Cat A), khóa lựa chọn -->
										<Select
											selectedKey="{acctAssignCat}"
											change=".onAcctAssignCatChange"
											width="100%"
											visible="{= ${materialType} !== 'ZAST' }"
										>
											<core:Item key="K" text="Cost Center"/>
											<core:Item key="F" text="Internal Order"/>
										</Select>
										<Text
											text="Tài sản (Asset)"
											class="qdInfoValue"
											visible="{= ${materialType} === 'ZAST' }"
										/>
									</VBox>

									<ComboBox
										selectedKey="{costCenter}"
										items="{path: '/costCenters', templateShareable: false}"
										placeholder="CC *"
										selectionChange=".onCostCenterSelect"
										width="100%"
										visible="{= ${materialType} !== 'ZAST' &amp;&amp; ${acctAssignCat} !== 'F' }"
									>
										<core:Item
											key="{CostCenter}"
											text="{= ${Description} &amp;&amp; ${Description} !== ${CostCenter} ? ${CostCenter} + ' - ' + ${Description} : ${CostCenter} }"
										/>
									</ComboBox>

									<ComboBox
										selectedKey="{internalOrder}"
										items="{path: '/internalOrders', templateShareable: false}"
										placeholder="IO *"
										selectionChange=".onInternalOrderSelect"
										width="100%"
										visible="{= ${materialType} !== 'ZAST' &amp;&amp; ${acctAssignCat} === 'F' }"
									>
										<core:Item
											key="{InternalOrder}"
											text="{= ${Description} &amp;&amp; ${Description} !== ${InternalOrder} ? ${InternalOrder} + ' - ' + ${Description} : ${InternalOrder} }"
										/>
									</ComboBox>

									<Input
										value="{assetNo}"
										tooltip="Mã tài sản cố định do Kế toán tạo trước trên SAP (AS01). Chưa có mã thì liên hệ Kế toán."
										enabled="{= ${materialType} === 'ZAST' }"
										placeholder="{= ${materialType} === 'ZAST' ? 'Mã tài sản *' : '—' }"
										width="100%"
									/>

									<Button
										icon="sap-icon://delete"
										type="Transparent"
										press=".onDeleteItem"
										tooltip="Xóa dòng"
									/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</ScrollContainer>

				<Text
					text="Bạn không cần biết cấu hình SAP: Vật tư, Cost Center, Internal Order đều CHỌN TỪ DANH SÁCH có sẵn (hệ thống tự kéo từ SAP về, kèm mô tả tiếng Việt). Đối tượng chi phí là nơi ghi nhận khoản chi: Cost Center = mua dùng chung cho bộ phận (hệ thống tự điền bộ phận của bạn nếu đã được gán); Internal Order = mua theo ngân sách được cấp riêng — vượt ngân sách sẽ cần CEO duyệt; Asset = mua tài sản cố định, nhập mã tài sản do Kế toán tạo trước trên SAP (chưa có mã thì liên hệ Kế toán). GL Account hệ thống tự xác định, không phải điền."
					class="qdInfoHint sapUiTinyMarginTop"
				/>

				<HBox
					class="qdTotalBar"
					justifyContent="SpaceBetween"
					alignItems="Center"
					visible="{= ${/items}.length > 0 }"
				>
					<VBox>
						<Text text="Tổng giá trị đề nghị" class="qdTotalLabel"/>
						<Text text="{= ${/items}.length } dòng vật tư" class="qdInfoHint"/>
					</VBox>
					<HBox alignItems="Baseline">
						<Title text="{/totalText}" level="H2" class="qdTotalValue"/>
						<Text text="{/header/currency}" class="sapUiTinyMarginBegin qdTotalLabel"/>
					</HBox>
				</HBox>

				<MessageStrip
					text="{/escalationText}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginTop qdAiMessageStrip"
					visible="{= !!${/escalationText} }"
				/>
			</VBox>

		</content>

		<footer>
			<OverflowToolbar class="qdPageFooter">
				<Text
					text="{= ${/items}.length === 0 ? 'Thêm ít nhất 1 vật tư để gửi đề nghị' : 'Sẵn sàng gửi ' + ${/items}.length + ' dòng vật tư' }"
					class="qdFooterHint"
				/>
				<ToolbarSpacer/>
				<Button
					text="{i18n>prResetButton}"
					icon="sap-icon://clear-all"
					press=".onResetPress"
					enabled="{= ${/items}.length > 0 }"
				/>
				<Button
					text="{i18n>prSubmitButton}"
					type="Emphasized"
					icon="sap-icon://paper-plane"
					press=".onSubmitPress"
					enabled="{= ${/items}.length > 0 }"
				/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>