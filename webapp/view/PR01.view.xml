<mvc:View
	controllerName="com.qdavy.procurement.controller.PR01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroBlue">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 1 · Đề nghị mua sắm" class="qdPageEyebrow"/>
						<Title text="{i18n>tilePr01Title}" level="H1" class="qdPageTitle"/>
						<Text text="Khai báo vật tư cần mua, hệ thống sẽ tạo Purchase Requisition trong SAP" class="qdPageSub"/>
					</VBox>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ THONG TIN CHUNG ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<Text text="1" class="qdStepBadge"/>
					<Title text="Thông tin chung" level="H3" class="qdCardTitle"/>
				</HBox>

				<HBox wrap="Wrap" class="qdInfoRow">
					<VBox class="qdInfoCell">
						<Label text="{i18n>prRequesterLabel}" class="qdInfoLabel"/>
						<Text text="{user>/fullName}" class="qdInfoValue"/>
						<Text text="{user>/email}" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Bộ phận / Vị trí" class="qdInfoLabel"/>
						<Text text="{user>/position}" class="qdInfoValue"/>
						<Text text="{= ${user>/costCenter} ? 'Cost Center: ' + ${user>/costCenter} : 'Chưa gán Cost Center' }" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="{i18n>prCurrencyLabel}" class="qdInfoLabel"/>
						<Select selectedKey="{/header/currency}" width="9rem" class="sapUiTinyMarginTop">
							<core:Item key="VND" text="VND"/>
							<core:Item key="USD" text="USD"/>
						</Select>
					</VBox>
				</HBox>
			</VBox>

			<!-- ============ DANH SACH VAT TU ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
					<HBox alignItems="Center">
						<Text text="2" class="qdStepBadge"/>
						<Title text="Danh sách vật tư ({= ${/items}.length })" level="H3" class="qdCardTitle"/>
					</HBox>
					<HBox>
						<Button
							text="Vật tư trong danh mục"
							icon="sap-icon://add"
							press=".onAddItem"
							enabled="{= !${/materialsLoading} }"
							class="sapUiTinyMarginEnd"
						/>
						<Button
							text="Vật tư tự do"
							icon="sap-icon://add-document"
							press=".onAddFreeTextItem"
						/>
					</HBox>
				</HBox>

				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${/items}.length === 0 }"
				>
					<core:Icon src="sap-icon://add-product" class="qdEmptyIcon"/>
					<Title text="Chưa có vật tư nào" level="H3" class="qdEmptyTitle"/>
					<Text
						text="Bấm &quot;Vật tư trong danh mục&quot; để chọn từ danh sách SAP, hoặc &quot;Vật tư tự do&quot; nếu vật tư chưa có mã."
						class="qdEmptyText"
						textAlign="Center"
					/>
				</VBox>

				<List
					id="itemsList"
					items="{/items}"
					mode="None"
					visible="{= ${/items}.length > 0 }"
					class="qdItemsList"
					showSeparators="Inner"
				>
					<CustomListItem>
						<VBox class="qdItemCard">
							<HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
								<ObjectStatus
									text="{= ${materialType} === 'ZAST' ? 'Tài sản (Acc.Assign A)' : ${materialType} ? 'Vật tư/DV (Acc.Assign K)' : 'Chưa chọn vật tư' }"
									state="{= ${materialType} === 'ZAST' ? 'Warning' : ${materialType} ? 'Success' : 'None' }"
								/>
								<Button icon="sap-icon://delete" type="Transparent" press=".onDeleteItem" tooltip="Xóa dòng này"/>
							</HBox>

							<HBox wrap="Wrap" class="qdItemFieldsRow">
								<VBox class="qdItemField sapUiTinyMarginEnd sapUiTinyMarginBottom" width="16rem">
									<Label text="Vật tư" class="qdInfoLabel"/>
									<ComboBox
										visible="{= !${isFreeText} }"
										selectedKey="{materialNo}"
										items="{path: '/materials', templateShareable: false}"
										selectionChange=".onMaterialChange"
										placeholder="— Chọn vật tư —"
										width="100%"
									>
										<core:Item key="{MaterialNo}" text="{MaterialNo} - {Description}"/>
									</ComboBox>
									<Input value="{materialType}" visible="{isFreeText}" placeholder="Loại VT (VD: ZROH)" width="100%"/>
								</VBox>

								<VBox class="qdItemField sapUiTinyMarginEnd sapUiTinyMarginBottom" width="14rem">
									<Label text="Mô tả *" class="qdInfoLabel"/>
									<Input value="{description}" width="100%"/>
								</VBox>

								<VBox class="qdItemField sapUiTinyMarginEnd sapUiTinyMarginBottom" width="5rem">
									<Label text="ĐVT" class="qdInfoLabel"/>
									<Input value="{uom}" editable="{isFreeText}" width="100%"/>
								</VBox>

								<VBox class="qdItemField sapUiTinyMarginEnd sapUiTinyMarginBottom" width="6.5rem">
									<Label text="Số lượng" class="qdInfoLabel"/>
									<Input value="{quantity}" type="Number" textAlign="End" change=".onItemValueChange" width="100%"/>
								</VBox>

								<VBox class="qdItemField sapUiTinyMarginEnd sapUiTinyMarginBottom" width="9rem">
									<Label text="Giá trị ước tính" class="qdInfoLabel"/>
									<Input value="{estimatedValue}" type="Number" textAlign="End" change=".onItemValueChange" width="100%"/>
								</VBox>

								<VBox class="qdItemField sapUiTinyMarginBottom" width="12rem">
									<Label text="Hạch toán chi phí" class="qdInfoLabel"/>
									<ComboBox
										selectedKey="{glAccount}"
										items="{path: '/glAccounts', templateShareable: false}"
										placeholder="GL Account *"
										class="sapUiTinyMarginBottom"
										width="100%"
									>
										<core:Item
											key="{GLAccount}"
											text="{= ${Description} &amp;&amp; ${Description} !== ${GLAccount} ? ${GLAccount} + ' - ' + ${Description} : ${GLAccount} }"
										/>
									</ComboBox>
									<ComboBox
										selectedKey="{costCenter}"
										items="{path: '/costCenters', templateShareable: false}"
										placeholder="Cost Center"
										selectionChange=".onCostCenterSelect"
										class="sapUiTinyMarginBottom"
										width="100%"
									>
										<core:Item
											key="{CostCenter}"
											text="{= ${Description} &amp;&amp; ${Description} !== ${CostCenter} ? ${CostCenter} + ' - ' + ${Description} : ${CostCenter} }"
										/>
									</ComboBox>
									<ComboBox
										selectedKey="{internalOrder}"
										items="{path: '/internalOrders', templateShareable: false}"
										placeholder="Internal Order (nếu có)"
										selectionChange=".onInternalOrderSelect"
										class="sapUiTinyMarginBottom"
										width="100%"
									>
										<core:Item
											key="{InternalOrder}"
											text="{= ${Description} &amp;&amp; ${Description} !== ${InternalOrder} ? ${InternalOrder} + ' - ' + ${Description} : ${InternalOrder} }"
										/>
									</ComboBox>
									<Input
										value="{assetNo}"
										visible="{= ${materialType} === 'ZAST' }"
										placeholder="VD: 100001 (mã tài sản đã tạo qua t-code AS01)"
										width="100%"
									/>
								</VBox>
							</HBox>
						</VBox>
					</CustomListItem>
				</List>

				<HBox
					class="qdTotalBar"
					justifyContent="SpaceBetween"
					alignItems="Center"
					visible="{= ${/items}.length > 0 }"
				>
					<VBox>
						<Text text="Tổng giá trị đề nghị" class="qdTotalLabel"/>
						<Text text="{= ${/items}.length } dòng vật tư" class="qdInfoHint"/>
					</VBox>
					<HBox alignItems="Baseline">
						<Title text="{/totalText}" level="H2" class="qdTotalValue"/>
						<Text text="{/header/currency}" class="sapUiTinyMarginBegin qdTotalLabel"/>
					</HBox>
				</HBox>

				<MessageStrip
					text="{/escalationText}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginTop qdAiMessageStrip"
					visible="{= !!${/escalationText} }"
				/>
			</VBox>

		</content>

		<footer>
			<OverflowToolbar class="qdPageFooter">
				<Text text="{= ${/items}.length === 0 ? 'Thêm ít nhất 1 vật tư để gửi đề nghị' : 'Sẵn sàng gửi ' + ${/items}.length + ' dòng vật tư' }" class="qdFooterHint"/>
				<ToolbarSpacer/>
				<Button text="{i18n>prResetButton}" icon="sap-icon://clear-all" press=".onResetPress" enabled="{= ${/items}.length > 0 }"/>
				<Button
					text="{i18n>prSubmitButton}"
					type="Emphasized"
					icon="sap-icon://paper-plane"
					press=".onSubmitPress"
					enabled="{= ${/items}.length > 0 }"
				/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>