<mvc:View
	controllerName="com.qdavy.procurement.controller.common.Dashboard"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdDashboardPage">
		<content>

			<!-- ================= HERO ================= -->
			<VBox class="qdDashHero">
				<HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
					<VBox class="qdHeroIdentity">
						<Title text="{dash>/greeting}" level="H1" class="qdHeroName"/>
						<HBox alignItems="Center" wrap="Wrap" class="qdHeroMetaRow sapUiTinyMarginTop">
							<Text class="qdRoleBadge" text="{user>/role}"/>
						</HBox>
					</VBox>
					<HBox alignItems="Center" class="qdHeroActions">
						<Button
							id="notifBellBtn"
							icon="sap-icon://bell"
							tooltip="Thông báo"
							press=".onNotifPress"
							class="qdHeroBtn sapUiTinyMarginEnd"
						/>
						<ObjectStatus
							text="{dash>/unreadCount}"
							state="Error"
							visible="{= ${dash>/unreadCount} > 0 }"
							class="sapUiTinyMarginEnd"
						/>
						<Avatar
							id="userAvatarBtn"
							src="{user>/avatarUrl}"
							initials="{user>/avatarInitials}"
							displayShape="Circle"
							displaySize="S"
							press=".onAvatarPress"
							tooltip="Tài khoản"
							class="qdHeroAvatarBtn"
						/>
					</HBox>
				</HBox>
			</VBox>

			<!-- ================= KPI OVERVIEW =================
			     An voi ACC: ke toan khong theo doi de nghi tren app nen 3 con so
			     nay luon bang 0, hien ra chi gay hieu nham la he thong hong. -->
			<VBox class="qdSection" visible="{= ${user>/role} !== 'ACC' }">
				<VBox class="qdSectionHeading">
					<Text text="{i18n>dashOverviewEyebrow}" class="qdEyebrow"/>
					<Title text="{i18n>dashOverviewTitle}" level="H2" class="qdSectionH2"/>
				</VBox>

			<!-- 3 the KPI bam duoc: dan sang man lien quan theo vai tro (feedback QDAVY
				     13/08: "May con so nay co the cho an vao roi link ra cac trang lien quan
				     khong?"). VBox khong co su kien press nen controller gan click qua
				     attachBrowserEvent trong onAfterRendering — xem _wireKpiClicks(). -->
				<HBox wrap="Wrap" class="qdKpiRow">
					<VBox id="kpiPendingCard" class="qdKpiCard qdKpiAmber qdKpiClickable" tooltip="Mở danh sách đề nghị đang chờ">
						<HBox justifyContent="SpaceBetween" alignItems="Center">
							<Text text="{dash>/kpiPendingLabel}" class="qdKpiLabel"/>
							<core:Icon src="sap-icon://pending" class="qdKpiIcon"/>
						</HBox>
						<Title text="{dash>/pendingCount}" level="H1" class="qdKpiValue"/>
						<Text text="{i18n>dashKpiUnit}" class="qdKpiUnit"/>
					</VBox>

					<VBox id="kpiApprovedCard" class="qdKpiCard qdKpiGreen qdKpiClickable" tooltip="Xem các đề nghị đã duyệt">
						<HBox justifyContent="SpaceBetween" alignItems="Center">
							<Text text="{dash>/kpiApprovedLabel}" class="qdKpiLabel"/>
							<core:Icon src="sap-icon://accept" class="qdKpiIcon"/>
						</HBox>
						<Title text="{dash>/approvedCount}" level="H1" class="qdKpiValue"/>
						<Text text="{i18n>dashKpiUnit}" class="qdKpiUnit"/>
					</VBox>

					<VBox id="kpiValueCard" class="qdKpiCard qdKpiBlue qdKpiClickable" tooltip="Xem chi tiết các đề nghị đang chờ">
						<HBox justifyContent="SpaceBetween" alignItems="Center">
							<Text text="{dash>/kpiValueLabel}" class="qdKpiLabel"/>
							<core:Icon src="sap-icon://money-bills" class="qdKpiIcon"/>
						</HBox>
						<Title text="{dash>/pendingValueText}" level="H1" class="qdKpiValue qdKpiValueSm"/>
						<Text text="{dash>/pendingValueUnit}" class="qdKpiUnit"/>
					</VBox>
				</HBox>
			</VBox>

			<!-- ================= CHUC NANG ================= -->
			<VBox class="qdSection">
				<VBox class="qdSectionHeading">
					<Text text="{i18n>dashSectionEyebrow}" class="qdEyebrow"/>
					<Title text="{i18n>dashSectionTitle}" level="H2" class="qdSectionH2"/>
					<Text text="{i18n>dashSectionSubtitle}" class="qdSectionSub"/>
				</VBox>

				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${dash>/tileCount} === 0 &amp;&amp; ${user>/role} !== 'ACC' }"
				>
					<core:Icon src="sap-icon://locked" class="qdEmptyIcon"/>
					<Title text="{i18n>dashEmptyTitle}" level="H3" class="qdEmptyTitle"/>
					<Text text="{i18n>dashEmptyText}" class="qdEmptyText" textAlign="Center"/>
				</VBox>

				<!-- ACC: khong co man nghiep vu nao tren app — noi ro la CO Y, khong
				     phai thieu quyen. Cau chu chung "chua duoc cap quyen" o tren se
				     lam nguoi xem tuong he thong cau hinh sai. -->
				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${user>/role} === 'ACC' }"
				>
					<core:Icon src="sap-icon://sap-logo-shape" class="qdEmptyIcon"/>
					<Title text="Kế toán làm việc trực tiếp trong SAP" level="H3" class="qdEmptyTitle"/>
					<Text
						text="Theo quy trình của công ty, phần việc của Kế toán nằm ở nhận hàng (MIGO) và kiểm tra hóa đơn (MIRO) — thực hiện trong SAP GUI chứ không qua ứng dụng này."
						class="qdEmptyText"
						textAlign="Center"
					/>
				</VBox>

				<HBox wrap="Wrap" class="qdActionGrid">

					<!-- PR-01 -->
					<VBox
						class="qdActionCard qdAccentBlue"
						visible="{= ${user>/role} === 'REQUESTER' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://add-document" class="qdActionIcon"/>
							</VBox>
							<Text text="PR-01" class="qdActionCode"/>
						</HBox>
						<Title text="{i18n>tilePr01Title}" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToPR01"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- PR-02 (18/08/2026: chi Purchasing — CFO/CEO duyet don hang o PO-02) -->
					<VBox
						class="qdActionCard qdAccentAmber"
						visible="{= ${user>/role} === 'PURCHASING' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://approvals" class="qdActionIcon"/>
							</VBox>
							<Text text="PR-02" class="qdActionCode"/>
						</HBox>
						<Title text="{i18n>tilePr02Title}" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToPR02"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- RFQ-01 -->
					<VBox
						class="qdActionCard qdAccentAmber"
						visible="{= ${user>/role} === 'PURCHASING' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://letter" class="qdActionIcon"/>
							</VBox>
							<Text text="RFQ-01" class="qdActionCode"/>
						</HBox>
						<Title text="Lập &amp; gửi yêu cầu báo giá" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToRFQ01"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- RFQ-02 -->
					<VBox
						class="qdActionCard qdAccentAmber"
						visible="{= ${user>/role} === 'PURCHASING' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://compare-2" class="qdActionIcon"/>
							</VBox>
							<Text text="RFQ-02" class="qdActionCode"/>
						</HBox>
						<Title text="Nhập báo giá &amp; chốt NCC" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToRFQ02"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- PO-01 -->
					<VBox
						class="qdActionCard qdAccentPurple"
						visible="{= ${user>/role} === 'PURCHASING' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://supplier" class="qdActionIcon"/>
							</VBox>
							<Text text="PO-01" class="qdActionCode"/>
						</HBox>
						<Title text="{i18n>tilePo01Title}" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToPO01"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- GAN THE TAI SAN: Mua sam lap the cho vat tu da mua ve (21/08/2026) -->
					<VBox
						class="qdActionCard qdAccentPurple"
						visible="{= ${user>/role} === 'PURCHASING' }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://add-product" class="qdActionIcon"/>
							</VBox>
							<Text text="TÀI SẢN" class="qdActionCode"/>
						</HBox>
						<Title text="Gán mã tài sản" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToAssetAssign"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- PO-02: CFO/CEO duyet DE NGHI sau khi chot NCC, truoc khi tao PO (21/08/2026) -->
					<VBox
						class="qdActionCard qdAccentPurple"
						visible="{= ['CFO','CEO'].indexOf(${user>/role}) !== -1 }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://order-status" class="qdActionIcon"/>
							</VBox>
							<Text text="PO-02" class="qdActionCode"/>
						</HBox>
						<Title text="Duyệt đề nghị mua sắm" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToPO02"
							class="qdActionBtn"
						/>
					</VBox>

					<!-- 21/08/2026: BO han the MM-01 "Tao moi vat tu / dich vu".
					     Nhom trinh bay theo huong danh muc vat tu da duoc cau hinh san
					     trong SAP (MM01) truoc khi chay luong mua sam, nen man tao vat tu
					     tren web khong con nam trong pham vi demo. File view/controller van
					     con trong repo; route "materialCreate" da go khoi manifest.json nen
					     go thang #/material-create cung khong vao duoc nua. -->

					<!-- HISTORY -->
					<VBox
						class="qdActionCard qdAccentSlate"
						visible="{= ['REQUESTER','PURCHASING','CEO','CFO'].indexOf(${user>/role}) !== -1 }"
					>
						<HBox alignItems="Center" justifyContent="SpaceBetween" class="qdActionHead">
							<VBox class="qdActionIconBox">
								<core:Icon src="sap-icon://history" class="qdActionIcon"/>
							</VBox>
							<Text text="HISTORY" class="qdActionCode"/>
						</HBox>
						<Title text="Lịch sử đề nghị" level="H3" class="qdActionTitle"/>
						<Button
							text="{i18n>dashTileOpen}"
							icon="sap-icon://arrow-right"
							iconFirst="false"
							press=".onNavToHistory"
							class="qdActionBtn"
						/>
					</VBox>

				</HBox>
			</VBox>

		</content>

		<dependents>
			<!-- contentHeight: khong dat thi Popover cao theo noi dung — chuc thong bao
			     la keo dai gan het man hinh (keo ca footer "Danh dau da doc" xuong day).
			     Chot 24rem, List cuon ben trong; growing de moi lan chi hien 8 cai dau,
			     cuon cham day tu nap tiep. -->
			<Popover
				id="notifPopover"
				title="Thông báo"
				placement="Bottom"
				contentWidth="22rem"
				contentHeight="24rem"
			>
				<footer>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<Button
							text="Đánh dấu tất cả đã đọc"
							type="Transparent"
							press=".onMarkAllRead"
						/>
					</OverflowToolbar>
				</footer>
				<List
					items="{dash>/notifications}"
					noDataText="Chưa có thông báo"
					mode="None"
					growing="true"
					growingThreshold="8"
					growingScrollToLoad="true"
				>
					<StandardListItem
						title="{dash>prId}"
						description="{dash>message}"
						info="{path: 'dash>createdAt', formatter: '.formatNotifTime'}"
						type="Active"
						press=".onNotifItemPress"
						highlight="{= ${dash>read} ? 'None' : 'Information' }"
						wrapping="true"
					/>
				</List>
			</Popover>

			<Popover
				id="userMenuPopover"
				placement="Bottom"
				showHeader="false"
				contentWidth="17rem"
				class="qdUserMenuPopover"
			>
				<VBox alignItems="Center" class="qdUserMenuHeader">
					<Avatar
						src="{user>/avatarUrl}"
						initials="{user>/avatarInitials}"
						displayShape="Circle"
						displaySize="M"
						class="qdUserMenuAvatar"
					/>
					<Title text="{user>/email}" level="H4" class="qdUserMenuName sapUiTinyMarginTop"/>
					<HBox class="sapUiTinyMarginTop" alignItems="Center">
						<Text text="{user>/role}" class="qdRoleBadge qdRoleBadgeDark"/>
						<Text text="{user>/position}" class="qdUserMenuPosition sapUiTinyMarginBegin"/>
					</HBox>
				</VBox>
				<List mode="None" class="qdUserMenuList">
					<StandardListItem
						title="Đăng xuất"
						icon="sap-icon://log"
						type="Active"
						press=".onLogoutPress"
					/>
				</List>
			</Popover>
		</dependents>
	</Page>
</mvc:View>