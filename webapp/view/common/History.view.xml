<mvc:View
	controllerName="com.qdavy.procurement.controller.common.History"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
	height="100%"
>
	<Page
		title="{hist>/pageTitle}"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="qdDashboardPage"
		busy="{hist>/busy}"
		busyIndicatorDelay="0"
		enableScrolling="false"
	>
		<subHeader>
			<OverflowToolbar>
				<SearchField
					width="100%"
					placeholder="Tìm theo số PR / email / phòng ban / IO..."
					liveChange=".onSearch"
				/>
				<ToolbarSpacer/>
			</OverflowToolbar>
		</subHeader>

		<content>
			<!-- VBox full chiều cao trang -->
			<VBox fitContainer="true" class="sapUiSmallMargin" height="100%">

				<!-- ===== PENDING (approver) — cao vừa đủ, không chiếm hết ===== -->
				<VBox visible="{hist>/showPending}" class="sapUiSmallMarginBottom">
					<Title text="{hist>/pendingTitle}" level="H3" class="sapUiTinyMarginBottom"/>
					<Table
						id="pendingTable"
						items="{hist>/pending}"
						growing="true"
						growingThreshold="10"
						growingScrollToLoad="true"
						sticky="ColumnHeaders"
						mode="None"
						noDataText="Không có đề nghị đang chờ"
						class="sapUiTinyMarginBottom"
					>
						<headerToolbar>
							<OverflowToolbar>
								<ObjectStatus text="{hist>/pendingCountText}" state="Warning"/>
							</OverflowToolbar>
						</headerToolbar>
						<columns>
							<Column width="9rem"><Text text="Số PR"/></Column>
							<Column width="9rem"><Text text="Trạng thái"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Người đề nghị"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true" width="10rem"><Text text="Phòng ban"/></Column>
							<Column minScreenWidth="Tablet" demandPopin="true" width="10rem"><Text text="Internal Order"/></Column>
							<Column hAlign="End" width="9rem"><Text text="Giá trị"/></Column>
							<Column minScreenWidth="Desktop" demandPopin="true" width="10rem"><Text text="Ngày tạo"/></Column>
							<Column width="5rem"><Text text=""/></Column>
						</columns>
						<items>
							<ColumnListItem type="Active" press=".onItemPress">
								<cells>
									<ObjectIdentifier title="{hist>DisplayId}" text="{= ${hist>SapPRId} ? '' : 'Đề nghị nội bộ — chưa phải chứng từ SAP' }"/>
									<ObjectStatus
										text="{path: 'hist>Status', formatter: '.formatStatus'}"
										state="{path: 'hist>Status', formatter: '.formatStatusState'}"
									/>
									<Text text="{hist>RequesterEmail}"/>
									<Text text="{path: 'hist>', formatter: '.formatCostCenters'}"/>
									<Text text="{path: 'hist>', formatter: '.formatInternalOrders'}"/>
									<ObjectNumber
										number="{path: 'hist>TotalValue', formatter: '.formatMoney'}"
										unit="{hist>Currency}"
									/>
									<Text text="{path: 'hist>CreatedAt', formatter: '.formatDate'}"/>
									<Button icon="sap-icon://display" type="Transparent" press=".onItemPress"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</VBox>

				<!-- ===== HISTORY — chiếm phần còn lại của màn hình ===== -->
				<VBox fitContainer="true" height="100%" class="sapUiTinyMarginTop">
					<Title text="{hist>/historyTitle}" level="H3" class="sapUiTinyMarginBottom"/>
					<!-- ScrollContainer flex: ăn hết chiều cao còn lại -->
					<ScrollContainer
						width="100%"
						height="100%"
						vertical="true"
						horizontal="true"
						focusable="false"
						class="qdHistoryScroll"
					>
						<Table
							id="historyTable"
							items="{hist>/history}"
							growing="true"
							growingThreshold="20"
							growingScrollToLoad="true"
							sticky="ColumnHeaders"
							mode="None"
							noDataText="Chưa có lịch sử"
						>
							<headerToolbar>
								<OverflowToolbar>
									<ObjectStatus text="{hist>/historyCountText}" state="Information"/>
								</OverflowToolbar>
							</headerToolbar>
							<columns>
								<Column width="9rem"><Text text="Số PR"/></Column>
								<Column width="9rem"><Text text="Trạng thái"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true"><Text text="Người đề nghị"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="10rem"><Text text="Phòng ban"/></Column>
								<Column minScreenWidth="Tablet" demandPopin="true" width="10rem"><Text text="Internal Order"/></Column>
								<Column hAlign="End" width="9rem"><Text text="Giá trị"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true" width="10rem"><Text text="Ngày tạo"/></Column>
								<Column minScreenWidth="Desktop" demandPopin="true" width="10rem"><Text text="Cập nhật"/></Column>
								<Column width="5rem"><Text text=""/></Column>
							</columns>
							<items>
								<ColumnListItem type="Active" press=".onItemPress">
									<cells>
										<ObjectIdentifier title="{hist>DisplayId}" text="{= ${hist>SapPRId} ? '' : 'Đề nghị nội bộ — chưa phải chứng từ SAP' }"/>
										<ObjectStatus
											text="{path: 'hist>Status', formatter: '.formatStatus'}"
											state="{path: 'hist>Status', formatter: '.formatStatusState'}"
										/>
										<Text text="{hist>RequesterEmail}"/>
										<Text text="{path: 'hist>', formatter: '.formatCostCenters'}"/>
										<Text text="{path: 'hist>', formatter: '.formatInternalOrders'}"/>
										<ObjectNumber
											number="{path: 'hist>TotalValue', formatter: '.formatMoney'}"
											unit="{hist>Currency}"
										/>
										<Text text="{path: 'hist>CreatedAt', formatter: '.formatDate'}"/>
										<Text text="{path: 'hist>UpdatedAt', formatter: '.formatDate'}"/>
										<Button icon="sap-icon://display" type="Transparent" press=".onItemPress"/>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
					</ScrollContainer>
				</VBox>

			</VBox>
		</content>
	</Page>
</mvc:View>