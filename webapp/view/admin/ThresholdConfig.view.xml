<mvc:View
    controllerName="com.qdavy.procurement.controller.admin.ThresholdConfig"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page showHeader="false" class="qdInnerPage">
        <content>

            <!-- ============ HERO ============ -->
            <VBox class="qdPageHero">
                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <HBox alignItems="Center">
                        <Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
                        <VBox>
                            <Text text="Quản trị hệ thống · CEO" class="qdPageEyebrow"/>
                            <Title text="Cấu hình hệ thống" level="H1" class="qdPageTitle"/>
                            <Text text="Ngưỡng ngân sách theo Internal Order và danh mục tài sản của vật tư" class="qdPageSub"/>
                        </VBox>
                    </HBox>
                </HBox>
            </VBox>

            <VBox>

                <!-- NGƯỠNG THEO TỪNG INTERNAL ORDER -->
                <VBox class="qdContentCard qdCardTight">
                    <HBox alignItems="Center" class="sapUiSmallMargin">
                        <core:Icon src="sap-icon://settings" class="qdCardIcon sapUiTinyMarginEnd"/>
                        <Title text="Hạn mức ngân sách theo Internal Order ({= ${thresholdModel>/rows}.length })" level="H3" class="qdCardTitle"/>
                    </HBox>

                    <MessageStrip
                        text="Để trống một dòng nghĩa là ngân sách đó không đặt hạn mức — đề nghị dùng ngân sách đó sẽ không bao giờ phải trình CEO vì lý do vượt tiền."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                    />

                    <Table
                        id="thresholdTable"
                        items="{thresholdModel>/rows}"
                        mode="None"
                        noDataText="Không đọc được danh sách Internal Order từ SAP."
                    >
                        <columns>
                            <Column width="10rem"><Text text="Internal Order"/></Column>
                            <Column><Text text="Tên / Mô tả"/></Column>
                            <Column width="9rem"><Text text="Cost Center"/></Column>
                            <Column width="16rem" hAlign="End"><Text text="Ngưỡng ngân sách (VND)"/></Column>
                            <Column width="7rem" hAlign="Center"><Text text="Xóa hạn mức"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{thresholdModel>internalOrder}"/>
                                    <Text text="{thresholdModel>description}"/>
                                    <Text text="{= ${thresholdModel>costCenter} || '—' }"/>
                                    <Input
                                        value="{thresholdModel>threshold}"
                                        type="Number"
                                        textAlign="End"
                                        placeholder="Không đặt hạn mức"
                                        width="100%"
                                    />
                                    <Button
                                        icon="sap-icon://decline"
                                        type="Transparent"
                                        tooltip="Xóa hạn mức của ngân sách này"
                                        press=".onClearRow"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- DANH MỤC TÀI SẢN CỦA VẬT TƯ: NHÓM TÀI SẢN + KHO MÃ -->
            <!-- Khai ở đây xong thì PR-01 tự điền Mã tài sản khi người đề nghị
                 chọn vật tư tài sản. Lưu trên SAP ở bảng Z ZG1_MAT_CONFIG.
                 SAP không có liên kết sẵn Material (MM) với Asset (FI-AA) nên
                 quan hệ này bắt buộc phải khai ở đâu đó.
                 GIÁ không khai ở đây: lấy từ material master (MM02 -> view
                 Accounting 1 -> Standard price), đúng chỗ chuẩn của SAP. -->
            <VBox class="qdContentCard qdCardTight">
                <HBox alignItems="Center" class="sapUiSmallMargin">
                    <core:Icon src="sap-icon://add-product" class="qdCardIcon sapUiTinyMarginEnd"/>
                    <Title text="Tài sản của vật tư ({= ${assetModel&gt;/rows}.length })" level="H3" class="qdCardTitle"/>
                </HBox>

                <MessageStrip
                    text="Ô “Mã tài sản” là kho mã còn trống: mỗi tài sản mua về là một thẻ riêng nên mỗi mã chỉ dùng được một lần; PR-01 lấy mã chưa dùng, tạo PR chính thức xong thì mã đó chuyển sang Đã dùng. Kế toán tạo mã mới bằng AS01 theo đúng Nhóm tài sản rồi khai thêm vào đây. Giá vật tư không khai ở đây — nhập trong MM02, view Accounting 1."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                />

                <Table
                    id="assetMapTable"
                    items="{assetModel&gt;/rows}"
                    mode="None"
                    noDataText="Không đọc được danh mục vật tư từ SAP."
                >
                    <columns>
                        <Column width="10rem"><Text text="Mã vật tư"/></Column>
                        <Column><Text text="Tên vật tư"/></Column>
                        <Column width="7rem"><Text text="Loại"/></Column>
                        <Column width="8rem"><Text text="Nhóm tài sản"/></Column>
                        <Column width="20rem"><Text text="Mã tài sản còn trống"/></Column>
                        <Column width="6rem" hAlign="Center"><Text text="Xóa"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{assetModel&gt;materialNo}"/>
                                <Text text="{assetModel&gt;description}"/>
                                <Text text="{assetModel&gt;typeLabel}"/>
                                <Input
                                    value="{assetModel&gt;assetClass}"
                                    enabled="{assetModel&gt;isAsset}"
                                    placeholder="{= ${assetModel&gt;isAsset} ? 'VD: 2000' : '—' }"
                                    tooltip="Nhóm tài sản (Asset Class) quyết định tài khoản kế toán và thời gian khấu hao. Cố định theo vật tư; kế toán dựa vào đây để tạo thẻ tài sản mới bằng AS01."
                                    width="100%"
                                />
                                <!-- Chi vat tu Tai san moi co the tai san; dich vu thi khoa lai.
                                     O nhap = kho ma CON TRONG. Cac ma DA DUNG hien ben duoi dang
                                     chi doc: chung gan voi tai san da mua that, xoa di la mat dau
                                     vet va lan sau co the cap trung so. -->
                                <VBox>
                                    <Input
                                        value="{assetModel&gt;assets}"
                                        enabled="{assetModel&gt;isAsset}"
                                        placeholder="{= ${assetModel&gt;isAsset} ? 'VD: 100001, 100002' : 'Không áp dụng' }"
                                        width="100%"
                                    />
                                    <Text
                                        text="{assetModel&gt;usedText}"
                                        visible="{= !!${assetModel&gt;usedText} }"
                                        class="qdCellHint"
                                    />
                                </VBox>
                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    tooltip="Xóa mã tài sản đã khai cho vật tư này"
                                    press=".onClearAssetRow"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox justifyContent="End" class="sapUiSmallMargin">
                    <Button text="Lưu danh mục tài sản"
                            type="Emphasized"
                            icon="sap-icon://save"
                            press=".onSaveAssetMap" />
                </HBox>
            </VBox>

            <!-- GIẢI THÍCH QUY TẮC -->
                <VBox class="qdContentCard">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://hint" class="qdCardIcon sapUiTinyMarginEnd"/>
                        <Title text="Quy tắc phê duyệt đang áp dụng" level="H3" class="qdCardTitle"/>
                    </HBox>
                    <Text
                        text="Phòng Mua sắm duyệt xong thì đề nghị chuyển sang CFO. Lúc này hệ thống so tổng tiền với hạn mức của từng ngân sách gắn trên các dòng vật tư — chỉ cần vượt hạn mức của một ngân sách bất kỳ là đề nghị phải trình thêm CEO duyệt. Không vượt thì chỉ cần CFO duyệt."
                        class="qdCellHint"
                    />
                    <Text
                        text="Nếu đề nghị đi qua vòng hỏi giá, hệ thống so lại hạn mức trên giá thực tế của báo giá đã chọn, thay vì giá ước tính lúc lập đề nghị."
                        class="qdCellHint sapUiSmallMarginTop"
                    />
                </VBox>

                <!-- KHU VỰC NÚT LƯU CẤU HÌNH -->
                <HBox justifyContent="End" class="sapUiMediumMarginBottom sapUiMediumMarginEnd">
                    <Button text="Lưu cấu hình"
                            type="Emphasized"
                            icon="sap-icon://save"
                            press=".onSaveThreshold" />
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
