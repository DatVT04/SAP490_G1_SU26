<mvc:View
    controllerName="com.qdavy.procurement.controller.admin.ThresholdConfig"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Page showHeader="false" class="qdInnerPage">
        <content>

            <!-- ============ HERO ============ -->
            <VBox class="qdPageHero">
                <HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <HBox alignItems="Center">
                        <Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
                        <VBox>
                            <Text text="Quản trị hệ thống · CEO" class="qdPageEyebrow"/>
                            <Title text="Cấu hình hệ thống" level="H1" class="qdPageTitle"/>
                            <Text text="Ngưỡng ngân sách theo Internal Order và ánh xạ vật tư tài sản với mã tài sản trên SAP" class="qdPageSub"/>
                        </VBox>
                    </HBox>
                    <Button icon="sap-icon://refresh" text="Tải lại" press=".onRefreshPress" class="qdHeroBtn"/>
                </HBox>
            </VBox>

            <VBox>

                <!-- NGƯỠNG THEO TỪNG INTERNAL ORDER -->
                <VBox class="qdContentCard qdCardTight">
                    <HBox alignItems="Center" class="sapUiSmallMargin">
                        <core:Icon src="sap-icon://settings" class="qdCardIcon sapUiTinyMarginEnd"/>
                        <Title text="Ngưỡng ngân sách theo Internal Order ({= ${thresholdModel>/rows}.length })" level="H3" class="qdCardTitle"/>
                    </HBox>

                    <MessageStrip
                        text="Bỏ trống một dòng nghĩa là Internal Order đó không đặt ngưỡng — PR gắn IO đó sẽ không bao giờ tự leo thang lên CEO vì lý do vượt ngân sách."
                        type="Information"
                        showIcon="true"
                        class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                    />

                    <Table
                        id="thresholdTable"
                        items="{thresholdModel>/rows}"
                        mode="None"
                        noDataText="Không đọc được danh sách Internal Order từ SAP."
                    >
                        <columns>
                            <Column width="10rem"><Text text="Internal Order"/></Column>
                            <Column><Text text="Tên / Mô tả"/></Column>
                            <Column width="9rem"><Text text="Cost Center"/></Column>
                            <Column width="16rem" hAlign="End"><Text text="Ngưỡng ngân sách (VND)"/></Column>
                            <Column width="7rem" hAlign="Center"><Text text="Xoá ngưỡng"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <ObjectIdentifier title="{thresholdModel>internalOrder}"/>
                                    <Text text="{thresholdModel>description}"/>
                                    <Text text="{= ${thresholdModel>costCenter} || '—' }"/>
                                    <Input
                                        value="{thresholdModel>threshold}"
                                        type="Number"
                                        textAlign="End"
                                        placeholder="Không đặt ngưỡng"
                                        width="100%"
                                    />
                                    <Button
                                        icon="sap-icon://decline"
                                        type="Transparent"
                                        tooltip="Xoá ngưỡng của Internal Order này"
                                        press=".onClearRow"
                                    />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>

                <!-- ÁNH XẠ VẬT TƯ (ZAST) SANG MÃ TÀI SẢN -->
            <!-- SAP không có liên kết sẵn giữa Material (MM) và Asset (FI-AA):
                 quan hệ "vật tư này chính là tài sản nào" phải do Kế toán khai,
                 đúng ý nghĩa với Info Record khai vật tư và nhà cung cấp. Khai ở
                 đây xong thì PR-01 tự điền ô Mã tài sản. -->
            <VBox class="qdContentCard qdCardTight">
                <HBox alignItems="Center" class="sapUiSmallMargin">
                    <core:Icon src="sap-icon://add-product" class="qdCardIcon sapUiTinyMarginEnd"/>
                    <Title text="Mã tài sản của vật tư tài sản ({= ${assetModel&gt;/rows}.length })" level="H3" class="qdCardTitle"/>
                </HBox>

                <MessageStrip
                    text="Chỉ liệt kê vật tư loại Tài sản (ZAST). Mã tài sản phải được Kế toán tạo trước trên SAP bằng AS01. Mua nhiều đơn vị thì khai nhiều mã, cách nhau bằng dấu phẩy — PR-01 điền lần lượt cho từng đơn vị số lượng."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                />

                <Table
                    id="assetMapTable"
                    items="{assetModel&gt;/rows}"
                    mode="None"
                    noDataText="Không có vật tư loại Tài sản (ZAST) nào trong danh mục SAP."
                >
                    <columns>
                        <Column width="10rem"><Text text="Mã vật tư"/></Column>
                        <Column><Text text="Tên vật tư"/></Column>
                        <Column width="20rem"><Text text="Mã tài sản (AS01)"/></Column>
                        <Column width="6rem" hAlign="Center"><Text text="Xoá"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier title="{assetModel&gt;materialNo}"/>
                                <Text text="{assetModel&gt;description}"/>
                                <Input
                                    value="{assetModel&gt;assets}"
                                    placeholder="VD: 100000 hoặc 100000, 100001"
                                    width="100%"
                                />
                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    tooltip="Xoá mã tài sản đã khai cho vật tư này"
                                    press=".onClearAssetRow"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox justifyContent="End" class="sapUiSmallMargin">
                    <Button text="Lưu ánh xạ tài sản"
                            type="Emphasized"
                            icon="sap-icon://save"
                            press=".onSaveAssetMap" />
                </HBox>
            </VBox>

            <!-- GIẢI THÍCH QUY TẮC -->
                <VBox class="qdContentCard">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <core:Icon src="sap-icon://hint" class="qdCardIcon sapUiTinyMarginEnd"/>
                        <Title text="Quy tắc leo thang đang áp dụng" level="H3" class="qdCardTitle"/>
                    </HBox>
                    <Text
                        text="Khi Purchasing duyệt xong, PR chuyển sang CFO. Tại bước CFO, hệ thống so tổng giá trị PR với ngưỡng của các Internal Order gắn trên từng dòng vật tư: chỉ cần vượt ngưỡng của một IO bất kỳ thì PR bắt buộc phải qua CEO phê duyệt, ngược lại CFO duyệt là ghi thẳng lên SAP."
                        class="qdCellHint"
                    />
                    <Text
                        text="Nếu PR đi qua luồng hỏi giá (RFQ), ngưỡng sẽ được tính lại trên giá thật của báo giá thắng thay vì giá ước tính lúc lập PR."
                        class="qdCellHint sapUiSmallMarginTop"
                    />
                </VBox>

                <!-- KHU VỰC NÚT LƯU CẤU HÌNH -->
                <HBox justifyContent="End" class="sapUiMediumMarginBottom sapUiMediumMarginEnd">
                    <Button text="Lưu cấu hình"
                            type="Emphasized"
                            icon="sap-icon://save"
                            press=".onSaveThreshold" />
                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
