<mvc:View
    controllerName="com.qdavy.procurement.controller.admin.MaterialCreate"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page
        id="materialCreatePage"
        showHeader="false"
        busy="{form>/busy}"
        class="qdInnerPage qdMaterialCreatePage">

        <content>
            <!-- Hero -->
            <VBox class="qdPageHero qdPageHeroBlue">
                <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <HBox alignItems="Center">
                        <Button
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            tooltip="Quay lại"
                            press=".onBack"
                            class="qdHeroBackBtn" />
                        <VBox>
                            <Text text="DANH MỤC MUA SẮM" class="qdPageEyebrow" />
                            <Title text="{form>/pageTitle}" level="H1" class="qdPageTitle" />
                            <Text
                                text="Purchasing tạo mã danh mục trước khi Requester lập PR"
                                class="qdPageSub" />
                        </VBox>
                    </HBox>
                    <ObjectStatus
                        text="Chỉ dành cho Purchasing"
                        icon="sap-icon://key-user-settings"
                        state="Information" />
                </HBox>
            </VBox>

            <!-- Loại danh mục -->
            <VBox class="qdContentCard qdMaterialTypeCard">
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Text text="1" class="qdStepBadge" />
                    <Title text="Chọn loại danh mục" level="H2" class="qdCardTitle" />
                </HBox>

                <Text
                    text="Loại đã chọn quyết định dữ liệu tổ chức và nhãn hiển thị trên biểu mẫu."
                    class="qdSectionSub sapUiSmallMarginBottom" />

                <SegmentedButton
                    id="materialTypeSegment"
                    selectedKey="{form>/materialType}"
                    selectionChange=".onMaterialTypeChange"
                    class="qdMaterialTypeSegment">
                    <items>
                        <SegmentedButtonItem
                            key="ZAST"
                            icon="sap-icon://product"
                            text="Vật tư/Tài sản (ZAST)" />
                        <SegmentedButtonItem
                            key="ZSRV"
                            icon="sap-icon://technical-object"
                            text="Dịch vụ (ZSRV)" />
                    </items>
                </SegmentedButton>
            </VBox>

            <!-- Thông tin SAP tự động -->
            <VBox class="qdContentCard qdSystemInfoCard">
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <core:Icon src="sap-icon://information" class="qdCardIcon" />
                    <Title text="Thông tin SAP tự động" level="H2" class="qdCardTitle" />
                </HBox>

                <MessageStrip
                    text="Các giá trị bên dưới do hệ thống gán và người dùng không cần nhập."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom" />

                <HBox wrap="Wrap" class="qdInfoRow qdMaterialSystemRow">
                    <VBox class="qdInfoCell">
                        <Label text="Material Type" class="qdInfoLabel" />
                        <Text text="{form>/materialTypeText}" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Industry Sector" class="qdInfoLabel" />
                        <Text text="S – Service Provider" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Plant" class="qdInfoLabel" />
                        <Text text="QDPL" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell" visible="{form>/isAsset}">
                        <Label text="Storage Location" class="qdInfoLabel" />
                        <Text text="QDSL" class="qdInfoValue" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Form -->
            <VBox class="qdContentCard qdMaterialFormCard">
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Text text="2" class="qdStepBadge" />
                    <Title text="{form>/sectionTitle}" level="H2" class="qdCardTitle" />
                </HBox>

                <MessageStrip
                    text="Tên ngắn (Material Description) bắt buộc, tối đa 40 ký tự."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom" />

                <MessageStrip
                    text="Diễn giải chi tiết bắt buộc. Chỉ nhập đặc tính/thông số kỹ thuật; không đưa lợi ích hoặc nhận xét về sản phẩm vào nội dung."
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom" />

                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="1"
                    emptySpanL="1"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1"
                    singleContainerFullSize="false"
                    class="qdSimpleForm qdMaterialSimpleForm">

                    <Label text="Mã Material" required="true" />
                    <Input
                        id="materialNoInput"
                        value="{form>/materialNo}"
                        placeholder="Nhập mã Material"
                        liveChange=".onRequiredFieldLiveChange" />

                    <Label text="{form>/nameLabel}" required="true" />
                    <Input
                        id="descriptionInput"
                        value="{form>/description}"
                        placeholder="{form>/namePlaceholder}"
                        maxLength="40"
                        liveChange=".onRequiredFieldLiveChange" />

                    <Label text="{form>/unitLabel}" required="true" />
                    <ComboBox
                        id="baseUnitCombo"
                        selectedKey="{form>/baseUnit}"
                        placeholder="Chọn đơn vị tính"
                        showSecondaryValues="true"
                        filterSecondaryValues="true"
                        selectionChange=".onRequiredSelectionChange"
                        items="{form>/uoms}">
                        <core:ListItem
                            key="{form>code}"
                            text="{form>code}"
                            additionalText="{form>description}" />
                    </ComboBox>

                    <Label text="{form>/groupLabel}" required="true" />
                    <ComboBox
                        id="materialGroupCombo"
                        selectedKey="{form>/materialGroup}"
                        placeholder="{form>/groupPlaceholder}"
                        showSecondaryValues="true"
                        filterSecondaryValues="true"
                        selectionChange=".onRequiredSelectionChange"
                        items="{form>/materialGroups}">
                        <core:ListItem
                            key="{form>code}"
                            text="{form>code}"
                            additionalText="{form>description}" />
                    </ComboBox>

                    <Label text="Nhóm mua hàng" />
                    <ComboBox
                        id="purchasingGroupCombo"
                        selectedKey="{form>/purchasingGroup}"
                        placeholder="Chọn nhóm mua hàng (không bắt buộc)"
                        showSecondaryValues="true"
                        filterSecondaryValues="true"
                        items="{form>/purchasingGroups}">
                        <core:ListItem
                            key="{form>code}"
                            text="{form>code}"
                            additionalText="{form>description}" />
                    </ComboBox>

                    <Label text="{form>/detailLabel}" required="true" />
                    <TextArea
                        id="detailTextArea"
                        value="{form>/purchaseOrderText}"
                        placeholder="{form>/detailPlaceholder}"
                        rows="8"
                        maxLength="1000"
                        growing="true"
                        growingMaxLines="12"
                        liveChange=".onDetailLiveChange" />

                    <Label text="Ngôn ngữ PO Text" />
                    <Select selectedKey="{form>/language}">
                        <items>
                            <core:Item key="EN" text="English (EN)" />
                            <core:Item key="VI" text="Vietnamese (VI)" />
                        </items>
                    </Select>
                </form:SimpleForm>

                <MessageStrip
                    visible="{form>/isService}"
                    text="Với dịch vụ, nên mô tả rõ phạm vi, gói dịch vụ và kết quả bàn giao. Thời gian sử dụng cụ thể nhập tại PR."
                    type="Warning"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiMediumMarginTop" />
            </VBox>

            <!-- Tóm tắt -->
            <VBox class="qdContentCard qdMaterialSummaryCard">
                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Text text="3" class="qdStepBadge" />
                    <Title text="Kiểm tra trước khi tạo" level="H2" class="qdCardTitle" />
                </HBox>

                <HBox wrap="Wrap" class="qdInfoRow">
                    <VBox class="qdInfoCell">
                        <Label text="Mã Material" class="qdInfoLabel" />
                        <Text text="{= ${form>/materialNo} || 'Chưa nhập' }" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Loại" class="qdInfoLabel" />
                        <Text text="{form>/materialTypeText}" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Tên" class="qdInfoLabel" />
                        <Text text="{= ${form>/description} || 'Chưa nhập' }" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Đơn vị" class="qdInfoLabel" />
                        <Text text="{= ${form>/baseUnit} || 'Chưa chọn' }" class="qdInfoValue" />
                    </VBox>
                    <VBox class="qdInfoCell">
                        <Label text="Nhóm" class="qdInfoLabel" />
                        <Text text="{= ${form>/materialGroup} || 'Chưa chọn' }" class="qdInfoValue" />
                    </VBox>
                </HBox>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar class="qdPageFooter qdMaterialFooter">
                <Text
                    text="Các trường có dấu * là bắt buộc"
                    class="qdFooterHint" />
                <ToolbarSpacer />
                <Button
                    text="Đặt lại"
                    icon="sap-icon://reset"
                    type="Transparent"
                    press=".onReset" />
                <Button
                    text="{form>/submitText}"
                    icon="sap-icon://save"
                    type="Emphasized"
                    press=".onCreateMaterial"
                    enabled="{= !${form>/busy} }"
                    class="qdMaterialSubmitBtn" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>