<mvc:View
	controllerName="com.qdavy.procurement.controller.pr.PR02"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<VBox class="qdPageHero qdPageHeroAmber">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="Bước 2 · Phê duyệt" class="qdPageEyebrow"/>
							<Title text="Phê duyệt đề nghị mua sắm" level="H1" class="qdPageTitle"/>
							<Text text="Duyệt = tạo PR thật trên SAP (ME51N) rồi chuyển sang bước hỏi giá. Từ chối = kết thúc kèm lý do, người tạo lập đề nghị mới." class="qdPageSub"/>
						</VBox>
					</HBox>
					<Button
						icon="sap-icon://refresh"
						text="Tải lại"
						press=".onRefreshPress"
						class="qdHeroBtn"
					/>
				</HBox>

				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Duyệt &amp; tạo PR SAP" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="RFQ Hỏi giá NCC" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- Đã xóa qdStatRow (3 ô Đang chờ / Leo thang CEO / Cần xem xét kỹ) -->

			<VBox class="qdContentCard qdCardTight">
				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://pending" class="qdCardIcon sapUiTinyMarginEnd"/>
					<Title text="Đề nghị đang chờ quyết định ({= ${/pending}.length })" level="H3" class="qdCardTitle"/>
				</HBox>

				<!-- Tim nhanh 1 don giua danh sach dai (feedback QDAVY 13/08: "kho nhin
				     phan biet cac don PR, nhieu don qua thi keo luot xuong duoi a?") -->
				<OverflowToolbar class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom">
					<SearchField
						id="sfPendingSearch"
						placeholder="Tìm theo mã PR, người đề nghị, tên vật tư / dịch vụ..."
						liveChange=".onPendingSearch"
						search=".onPendingSearch"
						width="100%"
					/>
				</OverflowToolbar>

				<VBox
					class="qdEmptyState"
					alignItems="Center"
					visible="{= ${/pending}.length === 0 }"
				>
					<core:Icon src="sap-icon://complete" class="qdEmptyIcon"/>
					<Title text="Không có đề nghị nào đang chờ" level="H3" class="qdEmptyTitle"/>
					<Text text="Tất cả đề nghị đã được xử lý. Bấm Tải lại để cập nhật." class="qdEmptyText" textAlign="Center"/>
				</VBox>

				<!-- The duyet cao ~ nua man hinh moi cai — khung cuon rieng de trang khong
				     dai vo han khi don nhieu PR; cuon cham day tu nap the tiep theo. -->
				<ScrollContainer
					height="calc(100vh - 18rem)"
					width="100%"
					vertical="true"
					horizontal="false"
					focusable="false"
					visible="{= ${/pending}.length > 0 }"
				>
				<List
					id="pendingList"
					items="{/pending}"
					mode="None"
					showSeparators="None"
					growing="true"
					growingThreshold="5"
					growingScrollToLoad="true"
					class="qdApprovalList"
				>
					<CustomListItem>
						<VBox class="qdApprovalCard">

							<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="qdApprovalCardHeader">
								<HBox alignItems="Center">
									<core:Icon src="sap-icon://request" class="qdPRIcon sapUiTinyMarginEnd"/>
									<VBox>
										<ObjectIdentifier title="{DisplayId}" text="Người đề nghị: {RequesterEmail}"/>
										<Text text="Gửi lúc: {path: 'CreatedAt', formatter: '.formatDateTime'}" class="qdCellHint sapUiTinyMarginTop"/>
										<Text
											text="{= ${SapPRId} ? ('SAP: ' + ${SapPRId}) : 'Chưa phải chứng từ SAP — PR thật sẽ được tạo ngay khi bạn duyệt' }"
											class="qdCellHint"
										/>
									</VBox>
								</HBox>

								<HBox wrap="Wrap" alignItems="Center">
									<ObjectStatus
										text="Dự kiến vượt ngưỡng IO — PO sẽ cần CEO duyệt"
										state="Error"
										visible="{needsProcurementHeadReview}"
										icon="sap-icon://alert"
										class="qdBadgeDanger sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Giá trị lớn — xem kỹ"
										state="Warning"
										visible="{= ${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://warning"
										class="qdBadgeWarning sapUiTinyMarginEnd"
									/>
									<ObjectStatus
										text="Trong ngưỡng thường"
										state="Success"
										visible="{= !${needsLegalReview} &amp;&amp; !${needsProcurementHeadReview} }"
										icon="sap-icon://accept"
										class="qdBadgeOk"
									/>
								</HBox>
							</HBox>

							<HBox class="qdApprovalValueRow sapUiTinyMarginTopBottom" alignItems="Baseline" wrap="Wrap">
								<Text text="Tổng giá trị: " class="qdInfoLabel"/>
								<Title
									text="{parts: ['TotalValue','Currency'], formatter: '.formatValue'}"
									level="H3"
									class="qdRowAmount sapUiTinyMarginBegin"
								/>
								<Text
									text="{parts: ['EstimatedTotalValue','Currency'], formatter: '.formatEstimateNote'}"
									visible="{= !!${RfqAwardedVendor} }"
									class="qdCellHint sapUiSmallMarginBegin"
								/>
							</HBox>

							<!-- KET QUA RFQ: NCC da chot + ly do. ZPR_DRAFT khong luu ten NCC va
							     ly do chon nen backend (enrichWithRfqAward) doc them tu RfqSet
							     va VendorSet roi ghep vao. Truoc day CFO chi thay con so tong
							     tien, khong biet Purchasing chot ai va vi sao. -->
							<!-- PR TACH NHIEU NHOM (16/08/2026): moi nhom 1 NCC + 1 gia rieng, cong lai
							     moi ra tong cua PR. Khoi nay liet ke tung nhom de CFO biet dang duyet
							     cho nhung ai — truoc day chi thay 1 con so gop, khong ro co bao nhieu
							     nha cung cap ben trong. PR 1 nhom van hien khoi cu ben duoi. -->
							<VBox class="qdAwardBox sapUiTinyMarginTopBottom" visible="{= ${RfqGroupCount} > 1 }">
								<HBox alignItems="Center" class="sapUiTinyMarginBottom">
									<core:Icon src="sap-icon://supplier" class="qdAwardIcon sapUiTinyMarginEnd"/>
									<Text text="{RfqGroupCount} nhóm nhà cung cấp — mỗi nhóm sẽ thành 1 đơn hàng riêng" class="qdInfoLabel"/>
								</HBox>
								<List items="{RfqGroups}" showSeparators="Inner" class="sapUiTinyMarginBottom">
									<StandardListItem
										title="{= (${AwardedVendorName} || ${AwardedVendor} || 'Chưa chốt NCC') }"
										description="{RfqId} · {= ${ItemLines} ? ('dòng ' + ${ItemLines}) : 'toàn bộ dòng' } · {= ${AwardReason} || '(chưa ghi lý do)' }"
										info="{parts: ['FinalValue','Currency'], formatter: '.formatValue'}"
										infoState="{= ${Status} === 'AWARDED' || ${Status} === 'PO_CREATED' ? 'Success' : 'Warning' }"
									/>
								</List>
								<Text
									text="Tổng cộng: {parts: ['TotalValue','Currency'], formatter: '.formatValue'}"
									class="qdAwardValue"
								/>
							</VBox>
							
							<VBox class="qdAwardBox sapUiTinyMarginTopBottom" visible="{= !!${RfqAwardedVendor} &amp;&amp; !(${RfqGroupCount} > 1) }">
								<HBox alignItems="Center" class="sapUiTinyMarginBottom">
									<core:Icon src="sap-icon://supplier" class="qdAwardIcon sapUiTinyMarginEnd"/>
									<Text text="Nhà cung cấp đã chốt qua {RfqId}" class="qdInfoLabel"/>
								</HBox>
								<Text
									text="{= (${RfqAwardedVendorName} || 'Nhà cung cấp') + ' (' + ${RfqAwardedVendor} + ')' }"
									class="qdAwardVendor"
								/>
								<Text
									text="{parts: ['RfqFinalValue','Currency'], formatter: '.formatValue'}"
									class="qdAwardValue"
								/>
								<Text
									text="Lý do chọn: {= ${RfqAwardReason} || '(Purchasing chưa ghi lý do)' }"
									class="qdCellHint sapUiTinyMarginTop"
								/>
								<Text
									text="Người chốt: {= ${RfqAwardedBy} || '—' }"
									class="qdCellHint"
								/>
								<!-- CFO xem duoc toan bo bang so sanh: de xuat cua nhan vien (gia uoc tinh)
								     dat canh tung bao gia NCC tra ve — khong chi con so tong (feedback QDAVY
								     13/08: "muon ghi ro chi tiet so sanh nhan vien de xuat the nao, NCC tra
								     loi the nao de CFO duyet"). -->
								<Button
									text="Xem so sánh báo giá chi tiết"
									icon="sap-icon://compare-2"
									type="Transparent"
									press=".onViewComparePress"
									class="sapUiTinyMarginTop qdCompareBtn"
								/>
							</VBox>

							<VBox class="qdNestedItems">
								<Text text="Danh sách vật tư / dịch vụ:" class="qdInfoLabel sapUiTinyMarginBottom"/>
								<List
									items="{items}"
									showNoData="false"
									showSeparators="Inner"
									class="qdNestedItemList"
								>
									<items>
										<CustomListItem>
											<HBox alignItems="Center" class="qdNestedItemRow" wrap="Wrap">
												<Text text="{LineNo}." class="qdLineNo"/>
												<VBox class="qdNestedItemMain">
													<Text text="{Description}" class="qdNestedItemDesc" wrapping="false"/>
													<HBox>
														<Text text="{path: 'MaterialNo', formatter: '.formatMatNo'}" class="qdCellHint"/>
														<Text
															text="{= ${MaterialType} === 'ZAST' ? ' · Tài sản (Cat.A)' : ' · Vật tư/DV (Cat.K)' }"
															class="qdCellHint"
														/>
													</HBox>
												</VBox>
												<VBox class="qdNestedItemSide" alignItems="End">
													<Text text="{Quantity} {UoM}" class="qdNestedQty"/>
													<Text
														text="{= ${MaterialType} === 'ZAST' ? ('Asset: ' + (${AssetNo} || 'chưa điền')) : ('CC: ' + (${CostCenter} || ${InternalOrder} || 'chưa điền')) }"
														class="qdCellHint"
													/>
													<Text
														text="{parts: ['EstimatedValue','Currency'], formatter: '.formatValue'}"
														class="qdNestedValue"
													/>
												</VBox>
											</HBox>
										</CustomListItem>
									</items>
								</List>
							</VBox>

							<VBox
								class="qdPrevComment sapUiTinyMarginTop"
								visible="{= !!${Comment} || !!${Comments} }"
							>
								<Text text="Ghi chú trước đó:" class="qdInfoLabel"/>
								<Text text="{= ${Comment} || ${Comments} }" class="qdCommentText"/>
							</VBox>

							<!-- ══ CAN CU DUYET ══
							     Truoc day man nay chi hien NOI DUNG de nghi (mua gi, bao nhieu tien),
							     nguoi duyet khong co gi de dua vao ma phan xet. Ba muc duoi day tra loi
							     dung 3 cau hoi cua nguoi duyet nhu cau: vi sao can, phong con tien
							     khong, va co dang mua trung khong. Tat ca tinh tu du lieu da co. -->
							<VBox class="qdDecisionBox sapUiSmallMarginTop">
								<Text text="CĂN CỨ DUYỆT" class="qdDecisionTitle"/>

								<!-- 1. Ly do nguoi de nghi khai o PR-01 -->
								<VBox class="sapUiTinyMarginTop">
									<Text text="Lý do đề nghị mua" class="qdInfoLabel"/>
									<Text
										text="{= ${PurchaseReason} || '(đề nghị cũ — chưa có lý do)' }"
										class="{= ${PurchaseReason} ? 'qdDecisionValue' : 'qdCellHint' }"
									/>
								</VBox>

								<!-- 2. Ngan sach tung phong ma de nghi nay dung toi -->
								<VBox class="sapUiSmallMarginTop" visible="{= (${BudgetContext} || []).length > 0 }">
									<Text text="Ngân sách bộ phận" class="qdInfoLabel"/>
									<List items="{BudgetContext}" showNoData="false" showSeparators="None">
										<CustomListItem>
											<VBox class="qdBudgetRow">
												<Text
													text="{parts: ['CostCenter','InternalOrder','Threshold'], formatter: '.formatBudgetHead'}"
													class="qdDecisionValue"
												/>
												<Text
													text="{parts: ['Committed','ThisRequest','Remaining'], formatter: '.formatBudgetDetail'}"
													class="qdCellHint"
												/>
												<ObjectStatus
													text="{parts: ['Threshold','RemainingAfter'], formatter: '.formatBudgetAfter'}"
													state="{parts: ['Threshold','RemainingAfter'], formatter: '.formatBudgetState'}"
													class="sapUiTinyMarginTop"
												/>
											</VBox>
										</CustomListItem>
									</List>
								</VBox>

								<!-- 3. Vat tu nay dang duoc de nghi o don khac (mua trung) -->
								<VBox class="sapUiSmallMarginTop" visible="{= (${DuplicateWarnings} || []).length > 0 }">
									<ObjectStatus
										text="{= 'Cảnh báo trùng: ' + (${DuplicateWarnings} || []).length + ' đề nghị khác đang mua cùng vật tư' }"
										state="Warning"
										icon="sap-icon://warning"
									/>
									<List items="{DuplicateWarnings}" showNoData="false" showSeparators="None">
										<CustomListItem>
											<Text
												text="{parts: ['MaterialNo','DisplayId','CostCenter','Quantity','UoM','Status'], formatter: '.formatDuplicate'}"
												class="qdCellHint"
											/>
										</CustomListItem>
									</List>
								</VBox>
							</VBox>

							<HBox justifyContent="End" alignItems="Center" class="qdRowActions sapUiSmallMarginTop">
								<Button
									text="Chi tiết"
									type="Transparent"
									icon="sap-icon://detail-view"
									press=".onDetailPress"
									class="sapUiSmallMarginEnd"
								/>
								<Button
									text="Từ chối"
									type="Reject"
									icon="sap-icon://decline"
									press=".onRejectPress"
									class="sapUiSmallMarginEnd"
								/>
								<Button
									text="Phê duyệt"
									type="Accept"
									icon="sap-icon://accept"
									press=".onApprovePress"
								/>
							</HBox>

						</VBox>
					</CustomListItem>
				</List>
				</ScrollContainer>
			</VBox>

		</content>
	</Page>
</mvc:View>