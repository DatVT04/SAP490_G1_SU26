<mvc:View
	controllerName="com.qdavy.procurement.controller.pr.PRDetail"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroBlue">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
					<HBox alignItems="Center">
						<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
						<VBox>
							<Text text="Chi tiết đề nghị mua sắm" class="qdPageEyebrow"/>
							<Title text="{/PRId}" level="H1" class="qdPageTitle"/>
							<Text text="Người đề nghị: {/RequesterEmail}" class="qdPageSub"/>
						</VBox>
					</HBox>
				</HBox>
			</VBox>

			<!-- ============ TIMELINE TIẾN TRÌNH ============ -->
			<VBox class="qdContentCard">
				<Title text="Tiến trình phê duyệt" level="H3" class="qdCardTitle sapUiSmallMarginBottom"/>

				<HBox
					id="timelineBox"
					items="{/timeline}"
					justifyContent="SpaceBetween"
					alignItems="Start"
					wrap="Wrap"
					class="qdTimelineRow"
				>
					<VBox class="qdTimelineItem" alignItems="Center">
						<!-- Icon + vòng tròn trạng thái -->
						<!-- 21/08/2026: truoc day la 1 core:Icon voi class="{= ... }" chon giua
						     Done/Active/Wait. XMLView cua UI5 KHONG binding duoc thuoc tinh class
						     — no bo qua im lang, nen 3 class nay CHUA BAO GIO duoc gan: ca
						     timeline hien cung mot mau, buoc da xong va buoc dang cho nhin y het
						     nhau. Tach 3 icon, moi cai 1 class TINH, chon bang visible. -->
						<core:Icon src="{icon}" size="1.6rem" class="qdTimelineIconDone"
							visible="{= !!${done} }"/>
						<core:Icon src="{icon}" size="1.6rem" class="qdTimelineIconActive"
							visible="{= !${done} &amp;&amp; !!${active} }"/>
						<core:Icon src="{icon}" size="1.6rem" class="qdTimelineIconWait"
							visible="{= !${done} &amp;&amp; !${active} }"/>
						<!-- Đường nối (pseudo qua CSS) -->
						<Text text="{title}" class="qdTimelineTitle" textAlign="Center"/>
						<Text
							text="{timeText}"
							class="qdTimelineTime"
							textAlign="Center"
							visible="{= !!${timeText} }"
						/>
						<Text
							text="{sub}"
							class="qdTimelineSub"
							textAlign="Center"
							visible="{= !!${sub} }"
						/>
					</VBox>
				</HBox>

				<MessageStrip
					text="{/statusHint}"
					type="{/statusStripType}"
					showIcon="true"
					class="sapUiSmallMarginTop"
					visible="{= !!${/statusHint} }"
				/>
			</VBox>

			<!-- ============ TRANG THAI ============ -->
			<VBox class="qdContentCard">
				<HBox wrap="Wrap" class="qdInfoRow">
					<VBox class="qdInfoCell">
						<Label text="Trạng thái" class="qdInfoLabel"/>
						<ObjectStatus
							text="{path: '/Status', formatter: '.formatStatusText'}"
							state="{path: '/Status', formatter: '.formatStatusState'}"
							icon="sap-icon://status-in-process"
						/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Tổng giá trị" class="qdInfoLabel"/>
						<Text text="{parts: ['/TotalValue','/Currency'], formatter: '.formatValue'}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Ngày tạo" class="qdInfoLabel"/>
						<Text text="{path: '/CreatedAt', formatter: '.formatDateTime'}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell" visible="{= !!${/SapPRId} }">
						<Label text="Số PR trên SAP" class="qdInfoLabel"/>
						<Text text="{/SapPRId}" class="qdInfoValue"/>
						<Text text="Tra cứu bằng ME53N" class="qdInfoHint"/>
					</VBox>
					<!-- 1 PR tach nhieu nhom NCC se sinh ra NHIEU PO, nen o day co the la
					     danh sach cach nhau dau phay chu khong phai 1 so duy nhat. -->
					<VBox class="qdInfoCell" visible="{= !!${/PoNumberText} }">
						<Label text="Mã đơn hàng (PO)" class="qdInfoLabel"/>
						<Text text="{/PoNumberText}" class="qdInfoValue"/>
						<Text text="Tra cứu bằng ME23N" class="qdInfoHint"/>
					</VBox>
				</HBox>

				<!-- Ly do nguoi de nghi khai o PR-01 (ZPR_DRAFT-PURCHASE_REASON).
				     Them 21/08/2026: truoc day man chi tiet khong hien, nen chinh nguoi tao
				     mo lai de nghi cua minh cung khong doc lai duoc ly do da ghi. -->
				<VBox class="sapUiSmallMarginTop" visible="{= !!${/PurchaseReason} }">
					<Label text="Lý do đề nghị mua" class="qdInfoLabel"/>
					<Text text="{/PurchaseReason}" class="qdCommentText"/>
				</VBox>

				<MessageStrip
					text="{/EscalationReason}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginTop"
					visible="{= !!${/EscalationReason} }"
				/>

				<VBox class="sapUiSmallMarginTop" visible="{= !!${/Comment} }">
					<Label text="Ghi chú của {/DecidedByRole}" class="qdInfoLabel"/>
					<Text text="{/Comment}" class="qdCommentText"/>
					<Text
						text="{parts: ['/DecidedByEmail', '/UpdatedAt'], formatter: '.formatDecisionMeta'}"
						class="qdCellHint sapUiTinyMarginTop"
					/>
				</VBox>

				<!-- PR bị Purchasing trả lại → người tạo sửa & gửi lại (PR-01 điền sẵn dữ liệu) -->
				<Button
					text="Lập lại đề nghị mới"
					type="Emphasized"
					icon="sap-icon://edit"
					press="onResubmitPress"
					class="sapUiSmallMarginTop"
					visible="{= !!${/canResubmit} }"
				/>
			</VBox>

			<!-- ============ DANH SACH VAT TU ============ -->
			<VBox class="qdContentCard qdCardTight">
				<HBox alignItems="Center" class="sapUiSmallMargin">
					<core:Icon src="sap-icon://product" class="qdCardIcon sapUiTinyMarginEnd"/>
					<Title text="Danh sách vật tư / dịch vụ" level="H3" class="qdCardTitle"/>
				</HBox>

				<List
					id="detailItemsList"
					items="{/items}"
					mode="None"
					showSeparators="Inner"
					class="qdItemsList"
				>
					<CustomListItem>
						<VBox class="qdItemCard">
							<HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
								<ObjectIdentifier title="{Description}" text="{path: 'MaterialNo', formatter: '.formatMatNo'}"/>
								<ObjectStatus
									text="{= ${AcctAssignCat} === 'A' ? 'Tài sản (Cat.A)' : (${AcctAssignCat} === 'F' ? 'Internal Order (Cat.F)' : 'Cost Center (Cat.K)') }"
									state="{= ${AcctAssignCat} === 'A' ? 'Warning' : 'Success' }"
								/>
							</HBox>
							<HBox wrap="Wrap" class="qdItemFieldsRow sapUiTinyMarginTop">
								<VBox class="qdInfoCell">
									<Label text="Số lượng" class="qdInfoLabel"/>
									<Text text="{Quantity} {UoM}" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="Giá trị ước tính" class="qdInfoLabel"/>
									<Text text="{parts: ['EstimatedValue','../Currency'], formatter: '.formatValue'}" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell">
									<Label text="GL Account" class="qdInfoLabel"/>
									<Text text="{= ${GLAccount} || '(tự động theo SAP)' }" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell" visible="{= ${AcctAssignCat} === 'K' }">
									<Label text="Cost Center" class="qdInfoLabel"/>
									<Text text="{= ${CostCenter} || '(chưa có)' }" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell" visible="{= ${AcctAssignCat} === 'F' }">
									<Label text="Internal Order" class="qdInfoLabel"/>
									<Text text="{= ${InternalOrder} || '(chưa có)' }" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell" visible="{= ${AcctAssignCat} === 'A' }">
									<Label text="Asset No" class="qdInfoLabel"/>
									<Text text="{= ${AssetNo} || '(chưa có)' }" class="qdInfoValue"/>
								</VBox>
								<VBox class="qdInfoCell" visible="{= !!${PoNumber} }">
									<Label text="Mã PO" class="qdInfoLabel"/>
									<Text text="{PoNumber}" class="qdInfoValue"/>
								</VBox>
							</HBox>
						</VBox>
					</CustomListItem>
				</List>
			</VBox>

		</content>
	</Page>
</mvc:View>