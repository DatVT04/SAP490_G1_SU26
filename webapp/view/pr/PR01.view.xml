<mvc:View
	controllerName="com.qdavy.procurement.controller.pr.PR01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- ============ HERO ============ -->
			<VBox class="qdPageHero qdPageHeroBlue">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Bước 1 · Đề nghị mua sắm" class="qdPageEyebrow"/>
						<Title text="{i18n>tilePr01Title}" level="H1" class="qdPageTitle"/>
						<Text text="Khai báo vật tư / dịch vụ cần mua — sau khi Phòng Mua sắm duyệt, hệ thống mới tạo Purchase Requisition trên SAP." class="qdPageSub"/>
					</VBox>
				</HBox>
				<HBox class="qdFlowSteps">
					<Text text="PR-01 Tạo đề nghị" class="qdFlowStep qdFlowStepActive"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PR-02 Phê duyệt" class="qdFlowStep"/>
					<core:Icon src="sap-icon://navigation-right-arrow" class="qdFlowArrow"/>
					<Text text="PO-01 Tạo đơn hàng" class="qdFlowStep"/>
				</HBox>
			</VBox>

			<!-- ============ THÔNG TIN CHUNG ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" class="sapUiSmallMarginBottom">
					<Text text="1" class="qdStepBadge"/>
					<Title text="Thông tin chung" level="H3" class="qdCardTitle"/>
				</HBox>
				<HBox wrap="Wrap" class="qdInfoRow">
					<VBox class="qdInfoCell">
						<Label text="{i18n>prRequesterLabel}" class="qdInfoLabel"/>
						<Text text="{user>/fullName}" class="qdInfoValue"/>
						<Text text="{user>/email}" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Bộ phận mặc định" class="qdInfoLabel"/>
						<Text
							text="{= ${user>/costCenter} ? ${user>/costCenter} : 'Chưa được gán bộ phận' }"
							class="qdInfoValue"
						/>
						<Text text="Tự điền theo tài khoản của bạn cho các dòng vật tư" class="qdInfoHint"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="{i18n>prCurrencyLabel}" class="qdInfoLabel"/>
						<Text text="{/header/currency}" class="qdInfoValue"/>
					</VBox>
					<VBox class="qdInfoCell">
						<Label text="Vai trò" class="qdInfoLabel"/>
						<Text text="{user>/role}" class="qdInfoValue"/>
					</VBox>
				</HBox>

				<!-- LY DO DE NGHI MUA — can cu goc de Purchasing duyet NHU CAU.
				     Truoc day nguoi de nghi chi khai MUA GI chu khong khai VI SAO,
				     nen nguoi duyet khong co gi de dua vao ngoai cam tinh. -->
				<VBox class="sapUiSmallMarginTop">
					<Label text="Lý do đề nghị mua" required="true" class="qdInfoLabel"/>
					<TextArea
						id="taPurchaseReason"
						value="{/header/purchaseReason}"
						rows="2"
						width="100%"
						maxLength="255"
						liveChange=".onPurchaseReasonLiveChange"
						growing="true"
						placeholder="VD: Máy tính của phòng hỏng không sửa được, cần thay để nhân viên tiếp tục làm việc"
					/>
					<!-- Bo dem ky tu TU VE thay vi dung showExceededText cua sap.m.TextArea:
					     counter co san cua UI5 chi viet duoc kieu "con lai 242 ky tu" (chuoi
					     chuan cua UI5, doi theo ngon ngu trinh duyet) chu khong ra duoc dang
					     "34/255" — va bat no len se TAT gioi han cung cua trinh duyet.
					     Tu ve thi giu duoc maxLength=255 chan cung, van hien du so. -->
					<HBox justifyContent="SpaceBetween" alignItems="Start" wrap="Wrap">
						<Text text="Người duyệt đọc mục này để quyết định có duyệt nhu cầu hay không — ghi rõ hiện trạng và hậu quả nếu không mua." class="qdInfoHint"/>
						<!-- class phai la chuoi TINH: XMLView cua UI5 KHONG binding duoc
						     thuoc tinh class — viet class="{= ... }" thi no bo qua im lang,
						     control ra DOM khong co class nao. Mau cam luc sap cham tran do
						     controller bat/tat bang addStyleClass (_updatePurchaseReasonCounter). -->
						<Text id="txtReasonCounter" text="{/header/purchaseReasonCounter}" class="qdReasonCounter"/>
					</HBox>
				</VBox>
			</VBox>

			<!-- ============ DANH SÁCH VẬT TƯ ============ -->
			<VBox class="qdContentCard">
				<HBox alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMarginBottom">
					<HBox alignItems="Center">
						<Text text="2" class="qdStepBadge"/>
						<Title text="Danh sách vật tư / dịch vụ ({= ${/items}.length })" level="H3" class="qdCardTitle"/>
					</HBox>
					<Button
						text="Thêm dòng"
						icon="sap-icon://add"
						type="Emphasized"
						press=".onAddItem"
						enabled="{= !${/materialsLoading} }"
					/>
				</HBox>

				<!-- Khung cao hơn để thấy nhiều dòng; header cột dính khi cuộn -->
				<ScrollContainer
					height="28rem"
					width="100%"
					vertical="true"
					horizontal="true"
					focusable="false"
					class="qdItemsScroll"
				>
					<Table
						id="itemsTable"
						items="{/items}"
						mode="None"
						growing="false"
						fixedLayout="false"
						sticky="ColumnHeaders"
						class="qdItemsTable"
						noDataText="Chưa có dòng nào — nhấn “Thêm dòng” để bắt đầu."
					>
						<columns>
							<Column width="16%"><Text text="Vật tư / Dịch vụ *"/></Column>
							<Column width="12%"><Text text="Mô tả *"/></Column>
							<Column width="4.5rem" hAlign="Center"><Text text="ĐVT"/></Column>
							<Column width="6rem" hAlign="End"><Text text="Số lượng *"/></Column>
							<Column width="7.5rem" hAlign="End"><Text text="Đơn giá *"/></Column>
							<Column width="14%"><Text text="Bộ phận *"/></Column>
							<Column width="16%"><Text text="Ngân sách áp dụng (IO)"/></Column>
							<Column width="3rem" hAlign="Center"><Text text=""/></Column>
						</columns>

						<items>
							<ColumnListItem vAlign="Top">
								<cells>
									<!-- Vật tư / Dịch vụ -->
									<VBox>
										<ComboBox
											selectedKey="{materialNo}"
											items="{path: '/materials', templateShareable: false}"
											selectionChange=".onMaterialChange"
											placeholder="— Chọn vật tư / dịch vụ —"
											showSecondaryValues="true"
											filterSecondaryValues="true"
											width="100%"
										>
											<core:ListItem
												key="{MaterialNo}"
												text="{path: 'MaterialNo', formatter: '.formatMatNo'}"
												additionalText="{Description}"
											/>
										</ComboBox>
										<ObjectStatus
											text="{= ${materialType} === 'ZAST' ? 'Vật tư/Tài sản' : (${materialType} === 'ZSRV' ? 'Dịch vụ' : ${materialType}) }"
											state="{= ${materialType} === 'ZSRV' ? 'Success' : 'Information' }"
											icon="{= ${materialType} === 'ZSRV' ? 'sap-icon://employee-lookup' : 'sap-icon://product' }"
											visible="{= !!${materialType} }"
										/>
									</VBox>

									<!-- Mô tả -->
									<Input
										value="{description}"
										liveChange=".onItemValueChange"
										width="100%"
										placeholder="Mô tả *"
									/>

									<!-- ĐVT (từ material master) -->
									<Text text="{uom}" textAlign="Center" class="sapUiTinyMarginTop"/>

									<!-- Số lượng -->
									<Input
										value="{quantity}"
										type="Number"
										textAlign="End"
										valueLiveUpdate="true"
										liveChange=".onItemValueChange"
										change=".onQuantityChange"
										width="100%"
										placeholder="0"
									/>

									<!-- Đơn giá — hiển thị có dấu phân cách nghìn (22.000.000) cho dễ đọc.
									     Vì vậy KHÔNG dùng type="Number": ô số của trình duyệt từ chối dấu
									     chấm, gõ vào là mất. onItemPriceChange bóc lấy chữ số rồi ghi vào
									     model, binding tự định dạng lại. Cùng cách làm với cột Đơn giá
									     mua ở màn PO-01 để hai màn nhìn giống nhau. -->
									<Input
										value="{path: 'estimatedValue', formatter: '.formatMoney'}"
										textAlign="End"
										change=".onItemPriceChange"
										width="100%"
										placeholder="0"
									/>

									<!-- Bộ phận (CC) — bắt buộc mọi dòng, kể cả ZAST.
									     Khóa theo bộ phận của chính tài khoản đang đăng nhập: không ai
									     được lập đề nghị hộ phòng ban khác. Chỉ hiện ô chọn khi tài khoản
									     chưa có Cost Center trên SAP (xem /costCenterHint). -->
									<VBox width="100%">
										<Text
											text="{/lockedCostCenterText}"
											visible="{= !!${/lockCostCenter} }"
											class="qdInfoValue"
										/>
										<ComboBox
											selectedKey="{costCenter}"
											items="{path: '/costCenters', templateShareable: false}"
											placeholder="Chọn bộ phận *"
											selectionChange=".onCostCenterSelect"
											visible="{= !${/lockCostCenter} }"
											width="100%"
										>
											<core:Item
												key="{CostCenter}"
												text="{= ${Description} &amp;&amp; ${Description} !== ${CostCenter} ? ${Description} : ${CostCenter} }"
											/>
										</ComboBox>
									</VBox>

									<!-- IO ngân sách — chỉ đọc, theo bộ phận -->
									<Text text="{internalOrderText}" class="qdCellHint sapUiTinyMarginTop"/>

									<!-- Xóa dòng -->
									<Button
										icon="sap-icon://delete"
										type="Transparent"
										press=".onDeleteItem"
										tooltip="Xóa dòng"
									/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</ScrollContainer>

				<!-- Hướng dẫn đủ nghiệp vụ -->
				<Text
					text="Vật tư / dịch vụ và Bộ phận chọn từ danh mục có sẵn trên SAP, mỗi dòng đều phải chọn Bộ phận. Cột Ngân sách áp dụng tự hiện theo phòng, không cần chọn tay. Vật tư là tài sản khai giống vật tư thường — mã tài sản sẽ được gán sau khi nhận hàng. Tài khoản kế toán do hệ thống tự xác định."
					class="qdInfoHint sapUiTinyMarginTop"
				/>

				<!-- Tổng -->
				<HBox
					class="qdTotalBar"
					justifyContent="SpaceBetween"
					alignItems="Center"
					visible="{= ${/items}.length > 0 }"
				>
					<VBox>
						<Text text="Tổng giá trị đề nghị" class="qdTotalLabel"/>
						<Text text="{= ${/items}.length } dòng · Thành tiền = Số lượng × Đơn giá" class="qdInfoHint"/>
					</VBox>
					<HBox alignItems="Baseline">
						<Title text="{/totalText}" level="H2" class="qdTotalValue"/>
						<Text text="{/header/currency}" class="sapUiTinyMarginBegin qdTotalLabel"/>
					</HBox>
				</HBox>

				<MessageStrip
					text="{/escalationText}"
					type="Warning"
					showIcon="true"
					class="sapUiSmallMarginTop qdAiMessageStrip"
					visible="{= !!${/escalationText} }"
				/>
			</VBox>

		</content>

		<footer>
			<OverflowToolbar class="qdPageFooter">
				<Text
					text="{= ${/items}.length === 0 ? 'Thêm ít nhất 1 dòng để gửi đề nghị' : 'Sẵn sàng gửi ' + ${/items}.length + ' dòng' }"
					class="qdFooterHint"
				/>
				<ToolbarSpacer/>
				<Button
					text="{i18n>prResetButton}"
					icon="sap-icon://clear-all"
					press=".onResetPress"
					enabled="{= ${/items}.length > 0 }"
				/>
				<Button
					text="{i18n>prSubmitButton}"
					type="Emphasized"
					icon="sap-icon://paper-plane"
					press=".onSubmitPress"
					enabled="{= ${/items}.length > 0 }"
				/>
			</OverflowToolbar>
		</footer>
	</Page>
</mvc:View>