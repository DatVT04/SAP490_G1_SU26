<mvc:View
	controllerName="com.qdavy.procurement.controller.rfq.RFQ01"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
>
	<Page showHeader="false" class="qdInnerPage">
		<content>

			<!-- HERO HEADER -->
			<VBox class="qdPageHero qdPageHeroPurple">
				<HBox alignItems="Center">
					<Button icon="sap-icon://nav-back" press=".onNavBack" class="qdHeroBackBtn"/>
					<VBox>
						<Text text="Quy trình Mua sắm · Bước 2a" class="qdPageEyebrow"/>
						<Title text="RFQ-01 · Lập &amp; gửi yêu cầu báo giá (RFQ)" level="H1" class="qdPageTitle"/>
						<Text text="Chọn PR đang chờ xử lý và mời nhà cung cấp báo giá qua email — có AI gợi ý nhà cung cấp phù hợp." class="qdPageSub"/>
					</VBox>
				</HBox>
			</VBox>

			<l:Splitter height="100%" width="100%" class="qdSplitter">
				<l:contentAreas>

					<!-- CARD 1: DANH SACH PR CHO PURCHASING XU LY -->
					<VBox width="100%">
						<layoutData>
							<l:SplitterLayoutData size="35%" minSize="320"/>
						</layoutData>

						<VBox class="qdContentCard qdCardTight qdCardAccentPurple">
							<HBox alignItems="Center" class="sapUiSmallMargin">
								<Text text="1" class="qdStepBadge qdStepBadgePurple"/>
								<VBox>
									<Title text="PR chờ xử lý" level="H3" class="qdCardTitle"/>
									<Text text="Chọn một đề nghị để lập RFQ" class="qdCellHint"/>
								</VBox>
							</HBox>

							<SearchField
								id="sfPendingPRSearch"
								placeholder="Tìm mã PR, mô tả hoặc người đề nghị..."
								liveChange=".onPendingPRSearch"
								search=".onPendingPRSearch"
								width="100%"
								class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginBottom"
							/>

							<!-- Cot trai cung cuon trong khung rieng — PR don nhieu khong keo dai trang. -->
							<ScrollContainer height="calc(100vh - 24rem)" width="100%" vertical="true" horizontal="false" focusable="false">
							<Table
								id="pendingPRTable"
								items="{/PendingPRs}"
								mode="SingleSelectMaster"
								selectionChange=".onPRSelect"
								sticky="ColumnHeaders"
								growing="true"
								growingThreshold="15"
								growingScrollToLoad="true"
								noDataText="Không có PR nào đang chờ xử lý."
							>
								<columns>
									<Column width="8rem"><Text text="Mã PR"/></Column>
									<Column><Text text="Vật tư / Dịch vụ &amp; Yêu cầu"/></Column>
									<Column hAlign="End" width="8rem"><Text text="Giá trị ước tính"/></Column>
								</columns>
								<items>
									<ColumnListItem type="Active">
										<cells>
											<ObjectIdentifier title="{PRId}"/>
											<VBox>
												<Text text="{Description}"/>
												<Text text="Người đề nghị: {RequesterEmail}" class="qdCellHint"/>
											</VBox>
											<ObjectNumber
												number="{path: 'TotalValue', formatter: '.formatCurrency'}"
												unit="{Currency}"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</VBox>
					</VBox>

					<!-- KHU VUC LAP RFQ — LUON render, khong dung visible="false".
					     Truoc day vung nay bat dau an; sap.ui.layout.Splitter chi chia be rong
					     cho cac contentArea o lan render dau, nen khi setVisible(true) sau do
					     Splitter khong tinh lai -> cot phai ra mang trang, phai bam qua lai
					     giua 2 PR moi hien. Nay chi doi noi dung theo PR dang chon. -->
					<VBox id="rfqCreationArea" width="100%">
						<layoutData>
							<l:SplitterLayoutData size="65%" minSize="450"/>
						</layoutData>

						<!-- Chua chon PR nao (danh sach rong): huong dan thay vi cot phai trong tron -->
						<MessageStrip
							text="Chọn một PR ở cột bên trái để bắt đầu lập yêu cầu báo giá."
							type="Information"
							showIcon="true"
							visible="{= !${/hasSelectedPR} }"
							class="sapUiSmallMargin"
						/>

						<!-- CARD 1b: CHON DONG VAT TU CHO NHOM RFQ NAY (16/08/2026)
						     1 PR nhieu dong co the phai mua tu nhieu NCC khac nhau. Mac dinh
						     tich san MOI dong con trong (PR mua tu 1 NCC thi khong phai lam gi
						     them, y nhu truoc day). Muon tach thi bo tich bot, gui nhom nay
						     xong PR van o lai day de tao tiep nhom sau. -->
						<VBox class="qdContentCard qdCardAccentPurple" visible="{/hasSelectedPR}">
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center">
									<Text text="1b" class="qdStepBadge qdStepBadgePurple"/>
									<VBox>
										<Title text="Chọn dòng vật tư / dịch vụ đưa vào RFQ này" level="H3" class="qdCardTitle"/>
										<Text text="Chỉ những dòng được tích mới nằm trong yêu cầu báo giá gửi đi — nhà cung cấp không nhìn thấy các dòng khác của PR." class="qdCellHint"/>
									</VBox>
								</HBox>
								<Button
									text="AI gợi ý chia nhóm"
									icon="sap-icon://ai"
									press=".onAiSuggestGroupsPress"
									busy="{/busyGroupAi}"
									class="qdActionBtn"
								/>
							</HBox>

							<MessageStrip
								text="{/groupHint}"
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginBottom"
							/>

							<Table
								id="prItemTable"
								items="{/PRItems}"
								mode="MultiSelect"
								selectionChange=".onItemSelectionChange"
							>
								<columns>
									<Column width="5rem"><Text text="Dòng"/></Column>
									<Column><Text text="Vật tư / Dịch vụ"/></Column>
									<Column width="8rem" hAlign="End"><Text text="Số lượng"/></Column>
									<Column width="11rem"><Text text="Trạng thái"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<Text text="{LineNo}"/>
											<VBox>
												<Text text="{Description}" class="qdCellStrong"/>
												<Text text="{path: 'MaterialNo', formatter: '.formatMatNo'}" class="qdCellHint"/>
												<ObjectStatus
													text="{= ${MaterialType} === 'ZAST' ? 'Vật tư/Tài sản' : (${MaterialType} === 'ZSRV' ? 'Dịch vụ' : ${MaterialType}) }"
													state="{= ${MaterialType} === 'ZSRV' ? 'Success' : 'Information' }"
													icon="{= ${MaterialType} === 'ZSRV' ? 'sap-icon://employee-lookup' : 'sap-icon://product' }"
													visible="{= !!${MaterialType} }"
												/>
											</VBox>
											<Text text="{Quantity} {UoM}"/>
											<ObjectStatus
												text="{StatusText}"
												state="{= ${_assigned} ? 'Warning' : 'Success' }"
											/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
						</VBox>

						<!-- CARD 2: CHON NHA CUNG CAP MOI BAO GIA -->
						<VBox class="qdContentCard qdCardAccentPurple" visible="{/hasSelectedPR}">
							<MessageStrip
								text="Đang lập RFQ cho: {/selectedPRLabel}"
								type="Success"
								showIcon="true"
								class="sapUiSmallMarginBottom"
							/>
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center">
									<Text text="2" class="qdStepBadge qdStepBadgePurple"/>
									<VBox>
										<Title text="Chọn nhà cung cấp mời báo giá" level="H3" class="qdCardTitle"/>
										<Text text="Nên mời tối thiểu 2 nhà cung cấp để có cơ sở so sánh — nếu chỉ mời 1, khi chốt sẽ phải nhập lý do chỉ định thầu (sole source)." class="qdCellHint"/>
									</VBox>
								</HBox>
								<Button
									text="AI gợi ý NCC"
									icon="sap-icon://ai"
									press=".onAiSuggestPress"
									busy="{/busyAi}"
									class="qdActionBtn"
								/>
							</HBox>

							<!-- Khung chat AI: bong bong cuon rieng (khung co chieu cao co dinh + tu
							     cuon xuong tin moi nhat) thay vi 1 MessageStrip dai dan dong het cau
							     tra loi (feedback 15/08: "hoi xong khong nhin het duoc doan chat", o
							     hoi qua nho). aiChatHtml duoc controller ve san tu aiMessages — xem
							     _renderAiChat trong RFQ01.controller.js. -->
							<ScrollContainer
								id="aiChatScroll"
								height="300px"
								width="100%"
								vertical="true"
								horizontal="false"
								visible="{= ${/aiMessages}.length > 0 }"
								class="qdAiChatPanel sapUiSmallMarginBottom"
							>
								<!-- preferDOM="false": mac dinh sap.ui.core.HTML uu tien giu DOM dang co,
								     doi content khong phai luc nao cung ve lai sach -> de sinh ra bong bong
								     cu con sot lai, nhin nhu chat bi lap. Ep ve lai moi lan cho chac. -->
								<core:HTML content="{/aiChatHtml}" preferDOM="false"/>
							</ScrollContainer>
							<!-- CAC THE "AI GOI Y CHIA NHOM" — thay cho MessageBox to che man hinh cu.
							     Moi nhom 1 the: chip vat tu + chip NCC + ly do + nut Ap dung. Nam trong
							     trang nen xem duoc cac nhom canh nhau va van thao tac cho khac duoc. -->
							<VBox visible="{= ${/aiGroups}.length > 0 }" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
									<Title text="Phương án AI đề xuất — chọn nhóm thực hiện trước" level="H4" class="qdCardTitle"/>
									<Button icon="sap-icon://decline" type="Transparent" tooltip="Đóng gợi ý và tự chia nhóm thủ công" press=".onDismissGroupsPress"/>
								</HBox>
								<HBox wrap="Wrap" items="{/aiGroups}" class="qdAiGroupRow">
									<VBox class="qdAiGroupCard">
										<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
											<Title text="{name}" level="H5" class="qdAiGroupTitle"/>
											<ObjectStatus text="Đang áp dụng" state="Success" visible="{applied}"/>
										</HBox>
										<HBox wrap="Wrap" items="{path: 'itemChips', templateShareable: false}" class="qdAiChipRow">
											<Text text="{}" class="qdAiChip qdAiChipItem"/>
										</HBox>
										<HBox wrap="Wrap" items="{path: 'vendorChips', templateShareable: false}" class="qdAiChipRow" visible="{hasVendors}">
											<Text text="{}" class="qdAiChip qdAiChipVendor"/>
										</HBox>
										<MessageStrip text="Chưa có nhà cung cấp phù hợp trong danh sách — vui lòng chọn thủ công ở bảng bên dưới." type="Warning" showIcon="true" visible="{= !${hasVendors} }" class="sapUiTinyMarginBottom"/>
										<Text text="{reason}" class="qdAiGroupReason" maxLines="3"/>
										<Button text="Áp dụng nhóm này" type="Emphasized" icon="sap-icon://accept" press=".onApplyGroupPress" class="sapUiTinyMarginTop"/>
									</VBox>
								</HBox>
							</VBox>

							<!-- Hoi dap AI tuong tac: sau khi co goi y ban dau, nguoi dung hoi them
							     ("NCC nao giao nhanh nhat?", "vi sao khong chon V2?"...) thay vi chi
							     doc 1 chieu (feedback QDAVY 13/08: "AI van chua chat/tuong tac duoc"). -->
							<!-- O nhap cau hoi phai CHIEM HET be ngang con lai. Truoc day Input de
							     width="100%" nhung nam trong HBox (flex) nen 100% tinh theo flex-basis
							     tu co lai — o nhap bi bop con mot mau, go vao khong doc duoc
							     (feedback 16/08: "thanh nhap ben duoi be qua"). Dung growFactor de
							     no gian ra dung theo phan trong con lai. -->
							<HBox
								alignItems="Center"
								width="100%"
								visible="{= ${/aiMessages}.length > 0 }"
								class="qdAiChatInputRow sapUiSmallMarginBottom"
							>
								<Input
									id="inAiQuestion"
									placeholder="Hỏi thêm AI về các nhà cung cấp này..."
									maxLength="500"
									submit=".onAiAskPress"
									enabled="{= !${/busyAi} }"
									class="sapUiTinyMarginEnd qdAiChatInput"
								>
									<layoutData>
										<FlexItemData growFactor="1" baseSize="0%"/>
									</layoutData>
								</Input>
								<Button
									text="Hỏi AI"
									icon="sap-icon://discussion"
									type="Emphasized"
									press=".onAiAskPress"
									busy="{/busyAi}"
									class="qdAiChatSendBtn"
								/>
							</HBox>

							<!-- Nguon du lieu NCC + huong xu ly khi thieu NCC (feedback QDAVY 13/08:
							     "Thong tin NCC lay o dau? Sao co moi 3? NCC can moi khong co thi sao?") -->
							<MessageStrip
								text="Danh sách lấy trực tiếp từ Vendor Master trên SAP (bảng LFA1), hiển thị toàn bộ nhà cung cấp đã khai báo. Nếu nhà cung cấp cần mời chưa có, hãy tạo Vendor Master mới trên SAP (BP/XK01) hoặc bổ sung email, sau đó tải lại trang."
								type="Information"
								showIcon="true"
								class="sapUiSmallMarginBottom"
							/>

							<OverflowToolbar class="sapUiTinyMarginBottom">
								<SearchField
									id="sfVendorSearch"
									placeholder="Tìm theo mã, tên hoặc email nhà cung cấp..."
									liveChange=".onVendorSearch"
									search=".onVendorSearch"
									width="100%"
								/>
							</OverflowToolbar>

							<!-- Danh sách NCC nằm trong vùng cuộn CAO CỐ ĐỊNH: 35 NCC không còn kéo
							     card dài ra vô hạn, đẩy khối Hạn nộp & Gửi xuống đáy trang nữa.
							     growingScrollToLoad: cuộn chạm đáy tự nạp tiếp — bỏ hẳn nút "Thêm". -->
							<ScrollContainer
								height="24rem"
								width="100%"
								vertical="true"
								horizontal="false"
								focusable="false"
							>
							<Table
								id="vendorTable"
								items="{/Vendors}"
								mode="MultiSelect"
								selectionChange=".onVendorSelectionChange"
								sticky="ColumnHeaders"
								growing="true"
								growingThreshold="15"
								growingScrollToLoad="true"
								noDataText="Không tải được danh sách nhà cung cấp từ SAP."
							>
								<columns>
									<Column width="9rem"><Text text="Mã NCC"/></Column>
									<Column><Text text="Tên Nhà cung cấp"/></Column>
									<Column><Text text="Email nhận RFQ"/></Column>
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<ObjectIdentifier title="{VendorNo}"/>
											<Text text="{VendorName}"/>
											<Text text="{= ${Email} || ${VendorEmail} || '(chưa có email — sẽ bỏ qua khi gửi)' }"/>
										</cells>
									</ColumnListItem>
								</items>
							</Table>
							</ScrollContainer>
						</VBox>

						<!-- CARD 3: HAN NOP & GUI -->
						<VBox class="qdContentCard qdCardAccentPurple qdRfqSendCard" visible="{/hasSelectedPR}">
							<HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
								<HBox alignItems="Center">
									<Text text="3" class="qdStepBadge qdStepBadgePurple"/>
									<VBox>
										<Title text="Hạn nộp báo giá &amp; Gửi RFQ" level="H3" class="qdCardTitle"/>
										<Text text="Hệ thống sinh mã RFQ, lưu vào SAP và gửi email mời báo giá tới các nhà cung cấp đã chọn." class="qdCellHint"/>
									</VBox>
								</HBox>
								<HBox alignItems="Center">
									<ObjectStatus
										icon="sap-icon://list"
										text="{= ${/selectedLineCount} + ' dòng đã chọn' }"
										state="{= ${/selectedLineCount} === 0 ? 'Error' : 'Success' }"
										class="qdRfqVendorCount sapUiSmallMarginEnd"
									/>
									<ObjectStatus
										icon="sap-icon://supplier"
										text="{= ${/selectedVendorCount} + ' NCC đã chọn' }"
										state="{= ${/selectedVendorCount} === 0 ? 'Error' : (${/selectedVendorCount} === 1 ? 'Warning' : 'Success') }"
										class="qdRfqVendorCount"
									/>
								</HBox>
							</HBox>

							<HBox alignItems="End" wrap="Wrap" class="qdRfqSendRow">
								<VBox class="sapUiSmallMarginEnd">
									<Label text="Hạn nộp báo giá" required="true"/>
									<DatePicker
										id="dpDeadline"
										change=".onDeadlineChange"
										valueFormat="yyyy-MM-dd"
										displayFormat="dd/MM/yyyy"
										width="14rem"
									/>
								</VBox>
								<!-- BO class qdActionBtn: class do sinh ra cho the action tren Dashboard,
								     keo theo align-self:flex-start + margin-top 0.9rem lam nut bi day
								     lech khoi vien gradient (vien ve theo .sapMBtnInner cao 2.75rem
								     nhung vung bam la the goc .sapMBtn cao mac dinh ~2.3rem) -> chi
								     phan giao nhau o goc la bam duoc. -->
								<Button
									text="Tạo &amp; Gửi RFQ"
									type="Emphasized"
									icon="sap-icon://email"
									press=".onCreateAndSendRFQ"
									enabled="{= ${/selectedVendorCount} > 0 &amp;&amp; ${/selectedLineCount} > 0 }"
									class="qdPrimarySubmitBtn"
								/>
							</HBox>

							<Text
								text="Chọn ít nhất 1 dòng vật tư (bước 1b) và 1 nhà cung cấp (bước 2) trước khi gửi."
								visible="{= ${/selectedVendorCount} === 0 || ${/selectedLineCount} === 0 }"
								class="qdCellHint sapUiTinyMarginTop"
							/>
						</VBox>

					</VBox>
				</l:contentAreas>
			</l:Splitter>

		</content>
	</Page>
</mvc:View>
