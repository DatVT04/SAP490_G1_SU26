<mvc:View
	controllerName="com.qdavy.procurement.controller.Login"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	displayBlock="true"
>
	<Page title="{i18n>loginTitle}" showHeader="false">
		<content>
			<VBox class="sapUiMediumMargin loginBox" alignItems="Center" justifyContent="Center">
				<core:Icon src="sap-icon://shipping-status" size="3rem" class="sapUiMediumMarginBottom"/>
				<Title text="{i18n>appTitle}" level="H2" class="sapUiSmallMarginBottom"/>
				<Label text="{i18n>loginEmailLabel}" labelFor="emailInput" class="sapUiTinyMarginBottom"/>
				<Input
					id="emailInput"
					width="20rem"
					type="Email"
					placeholder="{i18n>loginEmailPlaceholder}"
					value="{/email}"
					submit=".onLoginPress"
					class="sapUiSmallMarginBottom"
				/>
				<Button
					id="loginButton"
					text="{i18n>loginButton}"
					type="Emphasized"
					width="20rem"
					press=".onLoginPress"
				/>
			</VBox>
		</content>
	</Page>
</mvc:View>
