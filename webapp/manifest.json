{
  "_version": "1.59.0",
  "sap.app": {
    "id": "com.qdavy.procurement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZG1_PROC_SRV_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.qdavy.procurement.view.common.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.viz": {}
      }
    },
    "handleValidation": true,
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.qdavy.procurement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/01-base.css"
        },
        {
          "uri": "css/02-login.css"
        },
        {
          "uri": "css/03-shared-layout.css"
        },
        {
          "uri": "css/04-pr-list-timeline.css"
        },
        {
          "uri": "css/05-po-filter.css"
        },
        {
          "uri": "css/06-dashboard.css"
        },
        {
          "uri": "css/07-shared-cards.css"
        },
        {
          "uri": "css/08-pr-progress.css"
        },
        {
          "uri": "css/09-po-polish.css"
        },
        {
          "uri": "css/10-material-create.css"
        },
        {
          "uri": "css/11-rfq.css"
        },
        {
          "uri": "css/12-pr02-rfq-award.css"
        },
        {
          "uri": "css/13-rfq-chat.css"
        },
        {
          "uri": "css/14-rfq-status.css"
        },
        {
          "uri": "css/15-decision-context.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.qdavy.procurement.view",
        "controlId": "appContainer",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        {
          "name": "login",
          "pattern": "",
          "target": "login"
        },
        {
          "name": "dashboard",
          "pattern": "dashboard",
          "target": "dashboard"
        },
        {
          "name": "pr01",
          "pattern": "create-pr",
          "target": "pr01"
        },
        {
          "name": "pr02",
          "pattern": "approve-pr",
          "target": "pr02"
        },
        {
          "name": "prdetail",
          "pattern": "pr-detail/{prId}",
          "target": "prdetail"
        },
        {
          "name": "history",
          "pattern": "history",
          "target": "history"
        },
        {
          "name": "po01",
          "pattern": "create-po",
          "target": "po01"
        },
        {
          "name": "po02",
          "pattern": "approve-po",
          "target": "po02"
        },
        {
          "name": "rfq01",
          "pattern": "create-rfq",
          "target": "rfq01"
        },
        {
          "name": "rfq02",
          "pattern": "manage-quotations",
          "target": "rfq02"
        },
        {
          "name": "thresholdConfig",
          "pattern": "threshold-config",
          "target": ["targetThresholdConfig"]
        },
        {
          "name": "materialCreate",
          "pattern": "material-create",
          "target": "materialCreate"
        },
        {
          "name": "assetAssign",
          "pattern": "assign-asset",
          "target": "assetAssign"
        }
      ],
      "targets": {
        "login": {
          "viewName": "common.Login",
          "viewId": "login",
          "viewLevel": 0
        },
        "dashboard": {
          "viewName": "common.Dashboard",
          "viewId": "dashboard",
          "viewLevel": 1
        },
        "pr01": {
          "viewName": "pr.PR01",
          "viewId": "pr01",
          "viewLevel": 2
        },
        "pr02": {
          "viewName": "pr.PR02",
          "viewId": "pr02",
          "viewLevel": 2
        },
        "prdetail": {
          "viewName": "pr.PRDetail",
          "viewId": "prdetail",
          "viewLevel": 3
        },
        "po02": {
          "viewName": "po.PO02",
          "viewId": "po02",
          "viewLevel": 2
        },
        "history": {
          "viewName": "common.History",
          "viewId": "history",
          "viewLevel": 2
        },
        "po01": {
          "viewName": "po.PO01",
          "viewId": "po01",
          "viewLevel": 2
        },
        "rfq01": {
          "viewName": "rfq.RFQ01",
          "viewId": "rfq01",
          "viewLevel": 2
        },
        "rfq02": {
          "viewName": "rfq.RFQ02",
          "viewId": "rfq02",
          "viewLevel": 2
        },
        "targetThresholdConfig": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": true,
          "viewName": "admin.ThresholdConfig"
        },
        "materialCreate": {
          "viewName": "admin.MaterialCreate",
          "viewId": "materialCreate",
          "viewLevel": 2
        },
        "assetAssign": {
          "viewName": "asset.AssetAssign",
          "viewId": "assetAssign",
          "viewLevel": 2
        }
      }
    }
  }
}
