{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "webapp/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/webapp/$1" }
  ],
  "crons": [
    { "path": "/api/cron/rfq-reminders", "schedule": "0 2 * * *" }
  ]
}
